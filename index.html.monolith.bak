<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cahaya di Atas Cahaya — Perjalanan Sirah Nabawiyah</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cardo:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   TOKEN — palet manuskrip Qur'an beriluminasi pada malam gurun
   lapis lazuli · emas daun · rubrikasi vermilion · perkamen
   ============================================================ */
:root{
  --ink:      #080B16;
  --ink-2:    #0E1524;
  --ink-3:    #16203a;
  --lapis:    #24457E;
  --lapis-lt: #5C90D8;
  --gold:     #C8A03C;
  --gold-lt:  #EBD08A;
  --verm:     #C4534A;
  --parch:    #E9DFC9;
  --parch-dim:#B7AE9B;
  --verd:     #4C9480;

  /* semantic mode tokens (dark defaults) */
  --c-bg-rgb:       8,11,22;
  --c-vig-rgb:      8,11,22;
  --c-rail-rgb:     8,11,22;
  --c-plate-top:    rgba(14,21,36,.86);
  --c-plate-bot:    rgba(8,11,22,.94);
  --c-sheet-bg:     rgba(4,6,12,.82);
  --c-intro-bg:     rgba(8,11,22,.97);
  --c-intro-glow:   rgba(36,69,126,.22);
  --c-canvas-opacity: 1;
  --c-text:         var(--parch);
  --c-text-dim:     var(--parch-dim);
  --c-close-bg:     rgba(8,11,22,.70);

  --f-disp: "Cardo", "Iowan Old Style", Georgia, "Times New Roman", serif;
  --f-body: "IBM Plex Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --f-ar:   "Amiri", "Traditional Arabic", "Scheherazade New", "Geeza Pro", "Noto Naskh Arabic", serif;

  --rail: 74px;
  --plate-max: 720px;
  --ease: cubic-bezier(.22,.61,.36,1);
}

[data-theme="light"]{
  --c-bg-rgb:       245,238,220;
  --c-vig-rgb:      245,238,220;
  --c-rail-rgb:     245,238,220;
  --c-plate-top:    rgba(252,246,234,.93);
  --c-plate-bot:    rgba(248,240,224,.97);
  --c-sheet-bg:     rgba(248,242,228,.96);
  --c-intro-bg:     rgba(252,246,234,.98);
  --c-intro-glow:   rgba(180,145,60,.18);
  --c-canvas-opacity: 0.09;
  --c-text:         #1B1007;
  --c-text-dim:     #6B5A3A;
  --c-close-bg:     rgba(248,242,228,.85);
  --gold:    #9A7018;
  --gold-lt: #7A5608;
  --lapis-lt:#1A5099;
  --verd:    #2A6A58;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; background:rgba(var(--c-bg-rgb),1); color:var(--c-text);
  font-family:var(--f-body); font-size:16px; line-height:1.65;
  overflow:hidden; -webkit-font-smoothing:antialiased;
  overscroll-behavior:none;
  transition:background .4s, color .4s;
}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
::selection{background:var(--gold);color:var(--ink)}

/* ---------- kanvas WebGL ---------- */
#gl{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0;opacity:var(--c-canvas-opacity,1);transition:opacity .6s}
#vignette{
  position:fixed;inset:0;z-index:1;pointer-events:none;
  background:
    radial-gradient(120% 90% at 50% 42%, transparent 35%, rgba(var(--c-vig-rgb),.55) 78%, rgba(var(--c-vig-rgb),.93) 100%),
    linear-gradient(to bottom, rgba(var(--c-vig-rgb),.55) 0%, transparent 22%, transparent 55%, rgba(var(--c-vig-rgb),.86) 92%);
}
#grain{
  position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.055;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)'/></svg>");
}

/* ---------- rel waktu (signature: margin rubrikasi) ---------- */
#rail{
  position:fixed;left:0;top:0;bottom:0;width:var(--rail);z-index:6;
  display:flex;flex-direction:column;align-items:center;
  padding:14px 0 12px;gap:0;
  background:linear-gradient(to right, rgba(var(--c-rail-rgb),.88), rgba(var(--c-rail-rgb),.22) 70%, transparent);
  overflow-y:auto;overflow-x:hidden;scrollbar-width:none;
}
#rail::-webkit-scrollbar{display:none}
#rail::after{
  content:"";position:absolute;left:calc(var(--rail) - 1px);top:0;bottom:0;width:1px;
  background:linear-gradient(to bottom,transparent,rgba(200,160,60,.28) 12%,rgba(200,160,60,.28) 88%,transparent);
}
.rail-mark{
  position:relative;width:100%;padding:9px 6px 9px 0;
  display:flex;flex-direction:column;align-items:center;gap:2px;
  color:var(--parch-dim);transition:color .25s var(--ease);
}
.rail-mark .yr{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.02em;opacity:.72}
.rail-mark .glyph{
  font-family:var(--f-disp);font-size:13px;line-height:1;
  width:23px;height:23px;display:grid;place-items:center;border-radius:50%;
  border:1px solid rgba(233,223,201,.22);transition:all .3s var(--ease);
}
.rail-mark:hover .glyph{border-color:var(--gold);color:var(--gold-lt)}
.rail-mark.seen .glyph{border-color:rgba(200,160,60,.55);color:var(--gold)}
.rail-mark.now{color:var(--gold-lt)}
.rail-mark.now .glyph{
  background:var(--gold);border-color:var(--gold);color:var(--ink);font-weight:700;
  box-shadow:0 0 0 4px rgba(200,160,60,.14),0 0 22px rgba(200,160,60,.35);
}
.rail-mark.now::before{
  content:"";position:absolute;right:0;top:50%;transform:translateY(-50%);
  width:3px;height:26px;background:var(--verm);border-radius:2px;
}
/* progress bar bawah glyph */
.rail-mark .ch-prog{
  display:block;height:2px;max-width:36px;width:0%;
  background:linear-gradient(90deg,var(--gold),var(--gold-lt));
  border-radius:1px;opacity:.5;transition:width .55s var(--ease);
}
.rail-mark.now .ch-prog{opacity:.3}

/* ---------- choice-branch di peta waktu ---------- */
.ch-branches{margin-top:9px;padding-top:8px;border-top:1px solid rgba(233,223,201,.08)}
.ch-branch-q{
  font-family:var(--f-mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--gold);opacity:.75;margin-bottom:4px;
}
.ch-branch-opts{display:flex;flex-direction:column;gap:3px;margin-bottom:8px}
.branch-opt{
  display:flex;align-items:flex-start;gap:7px;padding:5px 8px;border-radius:2px;
  font-size:12.5px;line-height:1.45;text-align:left;width:100%;
  border:1px solid rgba(233,223,201,.1);background:transparent;
  color:var(--parch-dim);transition:all .15s var(--ease);cursor:default;
}
.branch-opt .bfx{flex:none;font-size:10px;margin-top:1px;opacity:.6}
.branch-opt.taken{border-color:rgba(200,160,60,.3);color:var(--gold)}
.branch-opt.taken .bfx{color:var(--gold)}
.branch-opt.alt{cursor:pointer}
.branch-opt.alt:hover,.branch-opt.alt:focus-visible{
  border-color:var(--gold);background:rgba(200,160,60,.08);color:var(--parch);outline:none;
}

/* ---------- kepala bab ---------- */
#chaptop{
  position:fixed;top:0;left:var(--rail);right:0;z-index:5;
  padding:18px 22px 10px;pointer-events:none;
  display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;
}
#chaptop .kicker{
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--gold);opacity:.85;
}
#chaptop .ttl{font-family:var(--f-disp);font-size:19px;letter-spacing:.01em;color:var(--parch);opacity:.9}
#chaptop .yrs{font-family:var(--f-mono);font-size:11px;color:var(--parch-dim);opacity:.7}

/* ---------- pelat dialog ---------- */
#stage{
  position:fixed;left:var(--rail);right:0;bottom:0;z-index:5;
  display:flex;justify-content:center;padding:0 18px 18px;
}
#plate{
  width:100%;max-width:var(--plate-max);
  background:linear-gradient(to bottom, var(--c-plate-top), var(--c-plate-bot));
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(233,223,201,.13);
  border-top:1px solid rgba(200,160,60,.34);
  border-radius:3px;
  box-shadow:0 -8px 44px rgba(0,0,0,.5);
  padding:16px 20px 14px;
  cursor:pointer;
  transition:border-color .3s var(--ease);
  display:flex;flex-direction:column;
  max-height:calc(100vh - 88px); max-height:calc(100dvh - 88px);
}
#scroll{
  flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;
  scrollbar-width:thin;scrollbar-color:rgba(200,160,60,.35) transparent;
  padding-right:2px;
}
#scroll::-webkit-scrollbar{width:4px}
#scroll::-webkit-scrollbar-thumb{background:rgba(200,160,60,.35);border-radius:2px}
#ctl,#prog{flex:0 0 auto}
#plate:focus-visible{outline:2px solid var(--gold);outline-offset:3px}

.speaker{
  display:inline-flex;align-items:center;gap:8px;margin-bottom:9px;
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;
}
.speaker .dot{width:5px;height:5px;border-radius:50%;background:currentColor;flex:none}
.sp-nar{color:var(--lapis-lt)}
.sp-aku{color:var(--parch-dim)}
.sp-riw{color:var(--verd)}
.sp-sab{color:var(--gold-lt)}
.sp-ayt{color:var(--gold)}
.sp-cat{color:var(--verm)}

#body{font-size:16.5px;line-height:1.72;color:var(--c-text);min-height:3.4em}
#body em{font-style:italic;color:var(--gold-lt)}
.w{display:inline-block;opacity:0;transform:translateY(5px);animation:wIn .42s var(--ease) forwards}
@keyframes wIn{to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.w{opacity:1;transform:none;animation:none}}
#body strong{font-weight:600;color:#fff}
#body .ar-inline{font-family:var(--f-ar);font-size:1.18em}

/* varian: sabda / ayat */
.plate-ayat #body, .plate-sabda #body{text-align:center}
.arabic{
  font-family:var(--f-ar);direction:rtl;text-align:center;
  font-size:clamp(20px,4.6vw,30px);line-height:2.0;color:var(--gold-lt);
  margin:2px 0 12px;text-shadow:0 0 26px rgba(200,160,60,.28);
}
.plate-sabda .arabic{color:#F2E7CC;font-size:clamp(18px,4vw,25px)}
.translit{font-family:var(--f-mono);font-size:12px;color:var(--parch-dim);opacity:.75;margin-bottom:10px;font-style:normal}
.meaning{font-family:var(--f-disp);font-size:clamp(16px,2.6vw,19px);line-height:1.7;color:var(--c-text)}
.plate-ayat{border-top-color:var(--gold)}
.plate-sabda{border-top-color:var(--gold-lt)}

/* varian: catatan "yang jarang diceritakan" */
.plate-catatan{border-top-color:var(--verm);border-left:2px solid var(--verm)}
.note-h{
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--verm);margin-bottom:6px;
}

/* ---------- strip rujukan ---------- */
#refs{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}
.ref{
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.02em;
  padding:3px 8px;border-radius:2px;
  border:1px solid rgba(200,160,60,.3);color:var(--gold);
  background:rgba(200,160,60,.07);
}
.ref.q{border-color:rgba(92,144,216,.34);color:var(--lapis-lt);background:rgba(92,144,216,.08)}
.grade{
  font-family:var(--f-mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
  padding:3px 7px;border-radius:2px;border:1px solid;
}
.g-shahih{color:#7FD0A8;border-color:rgba(127,208,168,.4);background:rgba(127,208,168,.08)}
.g-hasan{color:#9FCBEA;border-color:rgba(159,203,234,.4);background:rgba(159,203,234,.08)}
.g-dhaif{color:#E2A05C;border-color:rgba(226,160,92,.42);background:rgba(226,160,92,.09)}
.g-sirah{color:var(--parch-dim);border-color:rgba(183,174,155,.35);background:rgba(183,174,155,.07)}

/* ---------- pilihan ---------- */
#choices{display:flex;flex-direction:column;gap:7px;margin-top:13px}
.choice{
  text-align:right;direction:ltr;
  display:flex;align-items:center;gap:10px;
  padding:10px 13px;border-radius:2px;
  border:1px solid rgba(233,223,201,.16);
  background:rgba(233,223,201,.03);
  color:var(--parch);font-size:14.5px;line-height:1.45;
  transition:all .18s var(--ease);
}
.choice .q{font-family:var(--f-mono);font-size:11px;color:var(--gold);flex:none;opacity:.75}
.choice span.lbl{flex:1;text-align:left}
.choice:hover,.choice:focus-visible{
  border-color:var(--gold);background:rgba(200,160,60,.1);color:#fff;outline:none;transform:translateX(3px);
}

/* ---------- baris kendali ---------- */
#ctl{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  margin-top:12px;padding-top:10px;border-top:1px solid rgba(233,223,201,.09);
}
#hint{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.1em;color:var(--parch-dim);opacity:.6}
#hint b{color:var(--gold);font-weight:500}
.ctl-b{
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;
  color:var(--parch-dim);padding:5px 9px;border:1px solid rgba(233,223,201,.15);border-radius:2px;
  transition:all .18s var(--ease);
}
.ctl-b:hover,.ctl-b:focus-visible{color:var(--gold-lt);border-color:var(--gold);outline:none}
#ctl .right{display:flex;gap:6px}
#prog{
  height:1px;background:rgba(233,223,201,.1);margin-top:10px;position:relative;overflow:hidden;border-radius:1px;
}
#prog i{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,var(--verm),var(--gold));width:0;transition:width .4s var(--ease)}

/* ---------- panel bertingkat ---------- */
.sheet{
  position:fixed;inset:0;z-index:20;display:none;
  background:var(--c-sheet-bg);backdrop-filter:blur(9px);-webkit-backdrop-filter:blur(9px);
  padding:0;overflow-y:auto;
}
.sheet.on{display:block;animation:fade .28s var(--ease)}
@keyframes fade{from{opacity:0}to{opacity:1}}
.sheet-in{max-width:760px;margin:0 auto;padding:48px 22px 70px}
.sheet h2{
  font-family:var(--f-disp);font-size:27px;font-weight:400;margin:0 0 4px;color:var(--gold-lt);
}
.sheet .sub{font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--parch-dim);margin-bottom:26px}
.sheet h3{
  font-family:var(--f-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--gold);margin:28px 0 10px;padding-bottom:6px;border-bottom:1px solid rgba(200,160,60,.2);
}
.sheet p{font-size:14.5px;line-height:1.75;color:var(--c-text);opacity:.92}
.sheet p.small{font-size:13px;color:var(--c-text-dim)}
.sheet ul{padding-left:18px;font-size:14.5px;line-height:1.7}
.sheet li{margin-bottom:7px}
.x{
  position:fixed;top:14px;right:16px;z-index:22;
  width:38px;height:38px;border-radius:50%;display:grid;place-items:center;
  border:1px solid rgba(233,223,201,.2);color:var(--parch);background:var(--c-close-bg);font-size:18px;
}
.x:hover{border-color:var(--gold);color:var(--gold)}

/* daftar bab */
.ch-row{
  display:flex;gap:14px;align-items:flex-start;width:100%;text-align:left;
  padding:13px 12px;border-radius:2px;border:1px solid transparent;
  border-bottom:1px solid rgba(233,223,201,.08);transition:all .18s var(--ease);
}
.ch-row:hover{background:rgba(200,160,60,.07);border-color:rgba(200,160,60,.28)}
.ch-row .n{font-family:var(--f-mono);font-size:11px;color:var(--gold);padding-top:3px;min-width:26px}
.ch-row .t{font-family:var(--f-disp);font-size:17px;color:var(--c-text);line-height:1.3}
.ch-row .y{font-family:var(--f-mono);font-size:10.5px;color:var(--parch-dim);opacity:.75;margin-top:3px}
.ch-row .d{font-size:13px;color:var(--parch-dim);margin-top:5px;line-height:1.55}

/* daftar rujukan */
.rf{padding:11px 0;border-bottom:1px solid rgba(233,223,201,.08)}
.rf .src{font-family:var(--f-mono);font-size:12px;color:var(--gold);margin-bottom:3px}
.rf .ctx{font-size:13.5px;color:var(--parch-dim);line-height:1.55}

/* ---------- layar pembuka ---------- */
#intro{
  position:fixed;inset:0;z-index:30;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;padding:32px 24px;
  background:radial-gradient(90% 70% at 50% 45%, var(--c-intro-glow), var(--c-intro-bg) 70%),rgba(var(--c-bg-rgb),1);
}
#intro.off{opacity:0;pointer-events:none;transition:opacity .9s var(--ease)}
#intro .mark{font-family:var(--f-ar);font-size:clamp(52px,13vw,96px);color:var(--gold-lt);line-height:1.4;text-shadow:0 0 50px rgba(200,160,60,.4);margin-bottom:6px}
#intro h1{font-family:var(--f-disp);font-weight:400;font-size:clamp(27px,6vw,42px);margin:0 0 8px;letter-spacing:.01em}
#intro .tag{font-family:var(--f-mono);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);opacity:.85;margin-bottom:26px}
#intro .lede{max-width:560px;font-size:15px;line-height:1.75;color:var(--parch-dim);margin-bottom:8px}
#intro .rule{width:54px;height:1px;background:var(--gold);opacity:.5;margin:22px 0}
#start{
  font-family:var(--f-mono);font-size:12px;letter-spacing:.18em;text-transform:uppercase;
  padding:13px 30px;border:1px solid var(--gold);color:var(--gold-lt);border-radius:2px;
  transition:all .25s var(--ease);
}
#start:hover{background:var(--gold);color:var(--ink);box-shadow:0 0 32px rgba(200,160,60,.35)}
#intro .foot{margin-top:22px;font-size:12px;color:var(--parch-dim);opacity:.6;max-width:520px;line-height:1.6}
#intro .foot a{color:var(--gold);text-decoration:none;border-bottom:1px dotted}

@media (max-width:640px){
  :root{--rail:52px}
  #plate{max-height:calc(100vh - 60px);max-height:calc(100dvh - 60px)}
  body{font-size:15px}
  #chaptop{padding:12px 16px 8px}
  #chaptop .ttl{font-size:16px}
  #stage{padding:0 10px 10px}
  #plate{padding:13px 15px 12px}
  #body{font-size:15.5px;min-height:4em}
  .rail-mark .yr{font-size:9px}
  .rail-mark .glyph{width:20px;height:20px;font-size:11px}
  .sheet-in{padding:40px 16px 60px}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;transition-duration:.01ms !important}
}

/* ---------- toolbar (lang + theme toggles) ---------- */
#toolbar{position:fixed;top:12px;right:14px;z-index:10;display:flex;gap:6px}
.tool-b{
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
  padding:5px 9px;border:1px solid rgba(233,223,201,.22);border-radius:2px;
  color:var(--parch-dim);background:rgba(8,11,22,.55);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  transition:all .2s var(--ease);
}
.tool-b:hover,.tool-b:focus-visible{color:var(--gold-lt);border-color:var(--gold);outline:none}
[data-theme="light"] .tool-b{background:rgba(245,238,220,.75);color:var(--c-text-dim, #6B5A3A);border-color:rgba(26,16,7,.22)}
#bMusic.off{color:rgba(233,223,201,.4);text-decoration:line-through}
[data-theme="light"] #bMusic.off{color:rgba(26,16,7,.35)}
/* volume — muncul saat hover/fokus pada kontrol musik */
.music-wrap{display:flex;align-items:center}
.music-wrap .vol{
  width:0;opacity:0;margin:0;padding:0;pointer-events:none;
  transition:width .28s var(--ease),opacity .2s var(--ease),margin .28s var(--ease);
}
.music-wrap:hover .vol,.music-wrap:focus-within .vol{
  width:74px;opacity:1;margin-right:8px;pointer-events:auto;
}
input[type=range].vol{
  -webkit-appearance:none;appearance:none;height:3px;border-radius:2px;
  background:rgba(233,223,201,.26);cursor:pointer;vertical-align:middle;
}
input[type=range].vol:focus-visible{outline:none;background:rgba(200,160,60,.4)}
input[type=range].vol::-webkit-slider-thumb{
  -webkit-appearance:none;appearance:none;width:11px;height:11px;border-radius:50%;
  background:var(--gold-lt);border:1px solid var(--gold);cursor:pointer;
}
input[type=range].vol::-moz-range-thumb{
  width:10px;height:10px;border-radius:50%;
  background:var(--gold-lt);border:1px solid var(--gold);cursor:pointer;
}
[data-theme="light"] input[type=range].vol{background:rgba(26,16,7,.2)}
</style>
</head>
<body>

<canvas id="gl"></canvas>
<div id="vignette"></div>
<div id="grain"></div>

<nav id="rail" aria-label="Garis waktu bab"></nav>

<header id="chaptop">
  <span class="kicker" id="kick">Bab I</span>
  <span class="ttl" id="ttl">—</span>
  <span class="yrs" id="yrs"></span>
</header>

<main id="stage">
  <div id="plate" tabindex="0" role="button" aria-label="Lanjutkan">
    <div id="scroll">
      <div class="speaker" id="sp"><i class="dot"></i><span id="spn">Narator</span></div>
      <div id="body"></div>
      <div id="refs"></div>
      <div id="choices"></div>
    </div>
    <div id="ctl">
      <span id="hint" data-i18n="hint">Ketuk atau tekan <b>Spasi</b></span>
      <span class="right">
        <button class="ctl-b" id="bBack" data-i18n="btnBack">Kembali</button>
        <button class="ctl-b" id="bMap" data-i18n="btnMap">Peta Waktu</button>
        <button class="ctl-b" id="bRef" data-i18n="btnRef">Rujukan</button>
      </span>
    </div>
    <div id="prog"><i></i></div>
  </div>
</main>

<div class="sheet" id="shMap"><button class="x" data-close>✕</button><div class="sheet-in">
  <h2 data-i18n="mapTitle">Peta Waktu</h2><div class="sub" data-i18n="mapSub">Dua belas bab · 570 – 632 M · dan satu ruang tematik</div>
  <div id="mapList"></div>
</div></div>

<div class="sheet" id="shRef"><button class="x" data-close>✕</button><div class="sheet-in">
  <h2 data-i18n="refTitle">Rujukan Bab Ini</h2><div class="sub" id="refSub">—</div>
  <div id="refList"></div>
  <h3 data-i18n="noteMethod">Catatan Metodologi</h3>
  <p class="small" data-i18n="noteP1">Penomoran hadis berbeda antar-cetakan (Fathul Bari, Al-'Alamiyah, Abdul Baqi). Nomor di sini adalah penunjuk untuk pencarian, bukan patokan mutlak — telusuri lafalnya, bukan hanya angkanya.</p>
  <p class="small" data-i18n="noteP2">Label <b>SIRAH</b> berarti riwayat itu bersumber dari kitab sejarah (Ibnu Ishaq, Ibnu Hisyam, Ath-Thabari) yang tidak memakai standar isnad sekeras kitab hadis. Label <b>DHAIF</b> ditampilkan apa adanya, bukan disembunyikan — sebagian ulama membolehkannya untuk fadhail a'mal, sebagian menolak. Anda berhak tahu.</p>
  <p class="small" data-i18n="noteP3">Media ini alat belajar, bukan pengganti guru. Verifikasi ke kitab aslinya dan tanyakan pada ahlinya.</p>
</div></div>

<div id="intro">
  <div class="mark">مُحَمَّد</div>
  <h1 data-i18n="introTitle">Cahaya di Atas Cahaya</h1>
  <div class="tag" data-i18n="introTag">Sirah · dengan aparatus sumbernya</div>
  <p class="lede" data-i18n="introLede1">Menyusuri hidup Rasulullah ﷺ dari Tahun Gajah hingga wafat — bukan sebagai dongeng heroik, melainkan sebagai rekaman keputusan seorang manusia yang setiap langkahnya bisa dilacak sumbernya.</p>
  <p class="lede" data-i18n="introLede2">Setiap layar membawa rujukannya sendiri: surah, riwayat, derajat sanad. Termasuk hal-hal yang jarang naik mimbar.</p>
  <div class="rule"></div>
  <button id="start" data-i18n="introStart">Mulai Perjalanan</button>
  <p class="foot" data-i18n="introFoot">Sosok beliau tidak digambarkan. Yang Anda lihat di layar adalah kaligrafi nama beliau yang tersusun dari partikel cahaya — dan Anda menjalaninya sebagai seorang penziarah waktu, bukan sebagai beliau.</p>
</div>

<div id="toolbar">
  <span class="music-wrap">
    <input type="range" class="vol" id="musicVol" min="0" max="100" value="30" step="1"
           aria-label="Volume musik latar" title="Volume musik latar">
    <button class="tool-b" id="bMusic" aria-label="Musik latar" title="Musik latar">♪</button>
  </span>
  <button class="tool-b" id="bTts" aria-label="Toggle narration" title="Toggle narration">▶</button>
  <button class="tool-b" id="bLang" aria-label="Switch language">ID</button>
  <button class="tool-b" id="bTheme" aria-label="Toggle theme" title="Toggle dark/light mode">◑</button>
</div>

<audio id="bg-audio" src="bg-sound.mp3" loop preload="auto"></audio>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ============================================================
   ISI — Bab 1 s.d. 6
   n  = narator   a = aku (penziarah)   r = riwayat sahabat
   sb = sabda     ay = ayat             c = catatan "jarang diceritakan"
   q  = pilihan   k = penanda           j = lompat ke penanda
   ============================================================ */
const CH = [];

CH.push({
id:1, glyph:'أ', yr:'570', years:'c. 570 M · Tahun Gajah', title:'Sebelum Fajar',
blurb:'Lembah tanpa sungai, rumah tua Ibrahim, dan sebuah masyarakat yang mulia sekaligus bengis pada saat yang sama.',
nodes:[
{n:'Kamu berdiri di sebuah lembah batu yang tidak ditumbuhi apa pun. Tidak ada sungai. Tidak ada ladang. Hanya bebatuan hitam, sumur tua, dan bangunan kubus dari batu tanpa spesi di tengahnya. Namanya Bakkah — orang menyebutnya Mekah.'},
{a:'Kenapa ada kota di tempat yang bahkan tidak bisa menumbuhkan gandum?'},
{n:'Karena kota ini tidak dibangun di atas kesuburan. Ia dibangun di atas sebuah doa yang diucapkan ribuan tahun sebelumnya.'},
{ay:'رَّبَّنَا إِنِّي أَسْكَنتُ مِن ذُرِّيَّتِي بِوَادٍ غَيْرِ ذِي زَرْعٍ عِندَ بَيْتِكَ الْمُحَرَّمِ',
 m:'“Ya Tuhan kami, sesungguhnya aku telah menempatkan sebagian keturunanku di lembah yang tidak mempunyai tanaman, di dekat rumah-Mu yang dihormati.”',
 s:'QS Ibrahim: 37', qref:1},
{n:'Rumah itu dibangun kembali oleh Ibrahim dan Ismail sebagai tempat menyembah Tuhan Yang Satu. Empat puluh generasi kemudian, tiga ratus enam puluh berhala mengelilinginya. Ka‘bah masih berdiri; maknanya yang runtuh.'},
{ay:'وَإِذْ يَرْفَعُ إِبْرَاهِيمُ الْقَوَاعِدَ مِنَ الْبَيْتِ وَإِسْمَاعِيلُ رَبَّنَا تَقَبَّلْ مِنَّا ۖ إِنَّكَ أَنتَ السَّمِيعُ الْعَلِيمُ',
 m:'“Dan (ingatlah) ketika Ibrahim meninggikan pondasi Baitullah bersama Ismail: Ya Tuhan kami, terimalah dari kami. Sungguh Engkaulah Yang Maha Mendengar lagi Maha Mengetahui.”',
 s:'QS Al-Baqarah: 127', qref:1},
{n:'Pada tahun ini, dari selatan, datang pasukan Abrahah dari Yaman dengan gajah perang. Tujuannya menghancurkan Ka‘bah agar jamaah beralih ke katedral yang ia bangun di Shan‘a.'},
{ay:'أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ ۝ أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ ۝ وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ',
 m:'“Tidakkah engkau perhatikan bagaimana Tuhanmu telah bertindak terhadap pasukan bergajah? Bukankah Dia telah menjadikan tipu daya mereka sia-sia? Dan Dia mengirimkan kepada mereka burung yang berbondong-bondong.”',
 s:'QS Al-Fil: 1-3', qref:1},
{n:'Abdul Muthalib, penjaga Ka‘bah, datang menemui Abrahah — bukan untuk membela Ka‘bah, melainkan untuk meminta kembali dua ratus untanya yang dirampas. Abrahah heran. Jawabnya: “Aku pemilik unta, dan rumah ini punya Pemilik yang akan menjaganya.”',
 s:'Sirah Ibnu Hisyam', g:'sirah'},
{q:'Sebelum kita lanjut — apa yang ingin kau pahami lebih dulu tentang dunia ini?', o:[
  {l:'Seperti apa sebenarnya masyarakat Arab saat itu?', to:'jahil'},
  {l:'Mengapa Ka‘bah begitu menentukan bagi mereka?', to:'kabah'}
]},

{k:'jahil', n:'Sejarawan menyebut masa ini Jahiliyah — bukan berarti mereka bodoh. Mereka penghafal ribuan bait syair, ahli genealogi, navigator bintang, dan pedagang lintas benua. Yang “jahil” adalah tata nilainya.'},
{n:'Kehormatan diukur dari kabilah, bukan dari perbuatan. Yang lemah tidak punya hak. Riba menumpuk sampai orang menjual anaknya. Dan sebagian mereka mengubur bayi perempuan hidup-hidup.'},
{ay:'وَإِذَا الْمَوْءُودَةُ سُئِلَتْ ۝ بِأَيِّ ذَنبٍ قُتِلَتْ',
 m:'“Dan apabila bayi perempuan yang dikubur hidup-hidup ditanya: karena dosa apakah ia dibunuh?”',
 s:'QS At-Takwir: 8-9', qref:1},
{n:'Perhatikan bentuk kalimatnya. Yang ditanya bukan pembunuhnya — melainkan korbannya. Di pengadilan yang paling adil, suara pertama diberikan kepada yang paling tidak pernah punya suara.'},
{j:'gabung'},

{k:'kabah', n:'Ka‘bah adalah pusat ziarah seluruh Jazirah. Setiap kabilah menaruh berhalanya di sana, sehingga setiap kabilah punya alasan datang — dan setiap kunjungan berarti pasar, penginapan, air, dan pajak bagi Quraisy.'},
{n:'Karena itu, mengusik berhala bukan sekadar soal teologi. Ia mengguncang seluruh model ekonomi kota. Ini penting diingat: perlawanan terhadap dakwah nanti bukan murni soal keyakinan, tapi soal siapa yang kehilangan pendapatan.'},
{ay:'لِإِيلَافِ قُرَيْشٍ ۝ إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ',
 m:'“Karena kebiasaan orang-orang Quraisy — kebiasaan mereka bepergian pada musim dingin dan musim panas.”',
 s:'QS Quraisy: 1-2', qref:1},
{j:'gabung'},

{k:'gabung', c:'Islam tidak datang ke ruang kosong',
 x:'Ceramah sering menggambarkan Arab pra-Islam sebagai kegelapan total, lalu Islam menghapus semuanya. Yang terjadi lebih rumit dan lebih menarik: sebagian nilai mereka justru <em>dipertahankan</em> — menepati janji, memuliakan tamu, membela yang dizalimi, keberanian. Yang dibongkar adalah kezaliman strukturalnya.'},
{sb:'إِنَّمَا بُعِثْتُ لِأُتَمِّمَ صَالِحَ الْأَخْلَاقِ',
 m:'“Sesungguhnya aku diutus hanyalah untuk menyempurnakan akhlak yang mulia.”',
 s:'HR. Ahmad no. 8952; Al-Bukhari, Al-Adabul Mufrad no. 273', g:'hasan'},
{n:'“Menyempurnakan”, bukan “memulai dari nol”. Kata kerja itu mengandung sebuah sikap terhadap kebudayaan yang kelak akan terus terlihat di sepanjang perjalanan ini.'},
{n:'Di rumah Abdullah bin Abdul Muthalib, seorang perempuan bernama Aminah binti Wahb sedang mengandung. Suaminya berangkat berdagang ke Yatsrib, jatuh sakit di jalan, dan wafat di sana. Anak itu lahir sebagai yatim sebelum ia sempat melihat dunia.'}
]});

CH.push({
id:2, glyph:'ب', yr:'570', years:'570 – 582 M', title:'Yatim di Padang',
blurb:'Kehilangan ayah, ibu, dan kakek sebelum usia delapan. Lalu bertahun-tahun menggembala kambing dengan upah.',
nodes:[
{n:'Ia lahir pada hari Senin di bulan Rabiul Awal. Kita tahu harinya bukan dari perayaan, melainkan dari jawaban singkat beliau bertahun-tahun kemudian saat ditanya mengapa berpuasa di hari Senin.'},
{sb:'ذَاكَ يَوْمٌ وُلِدْتُ فِيهِ، وَيَوْمٌ بُعِثْتُ — أَوْ أُنْزِلَ عَلَيَّ فِيهِ',
 m:'“Itu hari aku dilahirkan, dan hari aku diutus — atau hari diturunkan wahyu kepadaku.”',
 s:'HR. Muslim no. 1162', g:'shahih'},
{n:'Bayi-bayi Mekah dititipkan ke ibu susu di pedalaman, agar tumbuh di udara bersih dan belajar bahasa Arab yang murni. Tapi ibu-ibu susu enggan mengambil bayi yatim — tidak ada ayah yang membayar. Halimah dari Bani Sa‘d mengambilnya karena tak kebagian bayi lain.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{a:'Jadi kesempatan pertamanya datang justru karena tidak ada yang menginginkannya.'},
{n:'Usia enam tahun, ia dibawa ibunya berziarah ke makam ayahnya di Yatsrib. Dalam perjalanan pulang, Aminah wafat di Abwa. Anak itu menyaksikannya. Usia delapan, kakeknya Abdul Muthalib menyusul. Pengasuhan berpindah ke pamannya, Abu Thalib — orang paling terhormat sekaligus paling miskin di Bani Hasyim.'},
{ay:'أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ ۝ وَوَجَدَكَ ضَالًّا فَهَدَىٰ ۝ وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ',
 m:'“Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungimu? Dan Dia mendapatimu sebagai seorang yang bingung, lalu Dia memberi petunjuk. Dan Dia mendapatimu sebagai seorang yang kekurangan, lalu Dia mencukupkan.”',
 s:'QS Ad-Duha: 6-8', qref:1},
{n:'Ayat itu turun jauh kemudian, sebagai penghiburan. Tapi lanjutannya bukan penghiburan — melainkan perintah.'},
{ay:'فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ ۝ وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ',
 m:'“Maka terhadap anak yatim, janganlah engkau berlaku sewenang-wenang. Dan terhadap orang yang meminta, janganlah engkau menghardik.”',
 s:'QS Ad-Duha: 9-10', qref:1},
{c:'Luka diubah jadi kebijakan, bukan jadi identitas',
 x:'Struktur surah ini jarang dibongkar di mimbar: pengakuan atas nikmat langsung disambung dengan kewajiban kepada orang yang <em>dulu seperti kita</em>. Bukan “bersyukurlah”, tapi “jangan lakukan pada mereka apa yang dulu bisa saja dilakukan padamu”. Yatim itu tidak diminta melupakan lukanya; ia diminta mengubahnya jadi aturan.'},
{sb:'أَنَا وَكَافِلُ الْيَتِيمِ فِي الْجَنَّةِ هَكَذَا — وَأَشَارَ بِالسَّبَّابَةِ وَالْوُسْطَى وَفَرَّجَ بَيْنَهُمَا',
 m:'“Aku dan penanggung anak yatim di surga seperti ini,” — beliau berisyarat dengan jari telunjuk dan jari tengah, lalu merenggangkan keduanya sedikit.',
 s:'HR. Al-Bukhari no. 5304', g:'shahih'},
{n:'Perhatikan isyaratnya: dua jari yang berdampingan, tetapi ada jarak. Bahkan dalam janji terindah, beliau tetap presisi.'},
{q:'Masa remajanya nyaris tidak pernah diceritakan. Kau ingin tahu apa?', o:[
  {l:'Ia bekerja apa untuk hidup?', to:'kerja'},
  {l:'Bagaimana ia lolos dari kerusakan zamannya?', to:'jaga'}
]},

{k:'kerja', n:'Ia menggembala kambing milik penduduk Mekah dengan upah beberapa qirath. Ini pekerjaan kasta bawah — upahnya kecil, jamnya panjang, dan tak ada gengsi di dalamnya.'},
{sb:'مَا بَعَثَ اللَّهُ نَبِيًّا إِلَّا رَعَى الْغَنَمَ. فَقَالَ أَصْحَابُهُ: وَأَنْتَ؟ فَقَالَ: نَعَمْ، كُنْتُ أَرْعَاهَا عَلَى قَرَارِيطَ لِأَهْلِ مَكَّةَ',
 m:'“Tidaklah Allah mengutus seorang nabi kecuali ia pernah menggembala kambing.” Para sahabat bertanya, “Termasuk engkau?” Beliau menjawab, “Ya. Aku menggembalanya dengan upah beberapa qirath milik penduduk Mekah.”',
 s:'HR. Al-Bukhari no. 2262', g:'shahih'},
{c:'Beliau menyebut upahnya',
 x:'Bagian yang paling sering dipotong dari hadis ini adalah <em>“عَلَى قَرَارِيطَ”</em> — dengan upah. Beliau tidak berhenti di “aku menggembala” yang terdengar puitis; beliau menyebut bahwa ia buruh yang dibayar. Tidak ada rasa malu terhadap kerja kasar, dan tidak ada usaha memoles asal-usul. Di hadapan para sahabat yang sudah menganggapnya pemimpin negara, ia tetap mengaku pernah jadi penggembala upahan.'},
{n:'Menggembala melatih hal yang aneh untuk seorang calon pemimpin: menjaga makhluk yang tidak bisa mengeluh, tidak bisa memilihmu, dan tidak akan berterima kasih. Kesabaran yang dilatih di sana tidak punya penonton.'},
{j:'g2'},

{k:'jaga', n:'Riwayat menyebut dua kali ia hendak ikut hiburan malam anak-anak muda Mekah, dan dua kali ia tertidur sebelum sampai. Ia juga menolak ikut menyembah berhala dan tidak pernah minum khamr.', s:'Sirah Ibnu Ishaq', g:'sirah'},
{n:'Tetapi jangan bayangkan ia menyendiri. Ia ikut Perang Fijar sebagai remaja — meski hanya memungut anak panah untuk paman-pamannya — dan ikut dalam pakta kemanusiaan yang akan kita temui di bab berikutnya. Ia hadir di masyarakatnya, hanya tidak larut.'},
{j:'g2'},

{k:'g2', n:'Ketika ia memasuki usia dua puluhan, seluruh Mekah sudah punya satu kata untuk menyebutnya. Bukan “calon nabi”. Bukan “orang saleh”. Sebuah kata yang lahir dari transaksi dagang: <strong>Al-Amin</strong> — yang tepercaya.'}
]});

CH.push({
id:3, glyph:'ج', yr:'595', years:'c. 595 – 610 M', title:'Al-Amin',
blurb:'Reputasi yang dibangun sebelum ada klaim apa pun. Sebuah pakta membela orang tertindas. Dan sebuah solusi cerdik yang mencegah perang saudara.',
nodes:[
{n:'Khadijah binti Khuwailid adalah pengusaha kafilah paling berhasil di Mekah. Ia mempekerjakan Muhammad untuk membawa dagangannya ke Syam. Laporan pelayannya, Maisarah, membuat ia mengambil keputusan yang tidak biasa bagi perempuan zaman itu: ia mengajukan lamaran lebih dulu.'},
{n:'Mereka menikah. Beliau berusia dua puluh lima tahun. Tentang usia Khadijah, riwayat berbeda — empat puluh dalam riwayat yang masyhur, dua puluh delapan dalam riwayat lain yang dikutip Ibnu Sa‘d dan Al-Baihaqi. Kita tidak tahu pasti, dan tidak perlu berpura-pura tahu.', s:'Perbandingan riwayat: Ibnu Sa‘d, Ath-Thabaqat', g:'sirah'},
{c:'Dua puluh lima tahun, satu istri',
 x:'Selama Khadijah hidup, beliau tidak menikahi siapa pun. Ini penting untuk diletakkan di tempatnya: seluruh pernikahan lain terjadi <em>setelah</em> usia lima puluh, di Madinah, dalam konteks politik, perlindungan janda perang, dan aliansi kabilah. Fase paling panjang dan paling produktif dalam hidup rumah tangga beliau justru monogami — dan ini nyaris tak pernah disebut.'},
{a:'Lalu apa yang membuatnya dipercaya seluruh kota, sebelum ia mengaku menerima wahyu apa pun?'},
{n:'Sekitar masa ini terjadi sesuatu yang menurutku adalah salah satu peristiwa paling terlupakan dalam sirah. Seorang pedagang dari Zabid datang ke Mekah, barangnya dibeli seorang bangsawan Quraisy, dan uangnya tidak dibayar. Ia tak punya kabilah pelindung. Secara hukum adat, ia tidak punya hak apa pun.'},
{n:'Ia naik ke bukit Abu Qubais dan meneriakkan syair keluhannya. Beberapa tokoh Quraisy berkumpul di rumah Abdullah bin Jud‘an dan bersumpah: selama masih ada laut membasahi rumput, mereka akan berdiri bersama siapa pun yang dizalimi di Mekah, penduduk asli maupun pendatang, sampai haknya dikembalikan. Namanya <strong>Hilful Fudhul</strong>.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{n:'Muhammad, saat itu masih berusia sekitar dua puluh tahun dan belum menerima wahyu, ikut menandatangani. Puluhan tahun kemudian, sebagai nabi dan kepala negara, beliau mengomentarinya:'},
{sb:'لَقَدْ شَهِدْتُ فِي دَارِ عَبْدِ اللَّهِ بْنِ جُدْعَانَ حِلْفًا مَا أُحِبُّ أَنَّ لِي بِهِ حُمْرَ النَّعَمِ، وَلَوْ أُدْعَى بِهِ فِي الْإِسْلَامِ لَأَجَبْتُ',
 m:'“Sungguh aku pernah menyaksikan di rumah Abdullah bin Jud‘an sebuah perjanjian yang aku tidak ingin menukarnya dengan unta merah sekalipun. Dan seandainya aku diajak kepada perjanjian semacam itu dalam Islam, pasti aku akan memenuhinya.”',
 s:'HR. Ahmad no. 1655; Al-Humaidi no. 552; Al-Baihaqi, As-Sunanul Kubra', g:'hasan'},
{c:'Pakta itu dibuat oleh orang-orang musyrik',
 x:'Ini kalimat yang seharusnya mengguncang. Sebuah aliansi yang disusun oleh penyembah berhala, tanpa satu pun rujukan wahyu, dinilai oleh Nabi ﷺ lebih berharga daripada unta merah — kekayaan paling mahal orang Arab. Dan beliau menyatakan <em>bersedia mengulanginya dalam Islam</em>.<br><br>Artinya: kerja sama lintas keyakinan untuk membela orang tertindas bukan kompromi akidah — ia bagian dari agama. Yang menjadi ukuran bukan siapa yang mengajak, melainkan apa yang diperjuangkan.'},
{q:'Kau ingin melihat satu lagi keputusannya sebelum wahyu?', o:[
  {l:'Ya — peristiwa Hajar Aswad', to:'hajar'},
  {l:'Apa hubungan reputasi ini dengan dakwahnya nanti?', to:'amin'}
]},

{k:'hajar', n:'Banjir merusak Ka‘bah. Quraisy membongkar dan membangunnya kembali secara gotong royong — setiap kabilah menangani satu sisi. Semua lancar sampai tiba giliran meletakkan kembali Hajar Aswad.'},
{n:'Setiap kabilah menuntut kehormatan itu. Perselisihan berlangsung empat hari. Bani Abdud Dar menyiapkan baskom berisi darah dan mencelupkan tangan ke dalamnya — sumpah mati. Mekah berada di ambang perang saudara karena sebongkah batu.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{n:'Akhirnya disepakati: orang pertama yang masuk dari pintu Bani Syaibah akan jadi hakim. Yang masuk adalah Muhammad. Semua berseru, “Al-Amin! Kami rela.”'},
{n:'Ia meminta sehelai kain, meletakkan batu itu di tengahnya, lalu meminta <em>setiap</em> pemuka kabilah memegang satu sisi kain dan mengangkatnya bersama-sama. Setelah sampai ketinggian yang dituju, ia sendiri yang meletakkan batu itu ke tempatnya.'},
{c:'Solusi yang tidak menciptakan pihak kalah',
 x:'Cara termudah adalah menunjuk satu kabilah paling kuat — dan meninggalkan dendam pada semua yang lain. Yang beliau lakukan sebaliknya: mengubah masalah “siapa yang berhak” menjadi “bagaimana semua bisa berhak”. Ini bukan kompromi yang melemahkan; ini desain ulang atas pertanyaannya. Di Hudaibiyah, tiga puluh tahun kemudian, kita akan melihat pola pikir yang persis sama.'},
{j:'g3'},

{k:'amin', n:'Bertahun-tahun kemudian, ketika beliau naik ke bukit Shafa dan bertanya kepada seluruh Quraisy, “Jika kukatakan ada pasukan berkuda di balik bukit hendak menyerang kalian, apakah kalian percaya?” — mereka menjawab serempak, “Ya. Kami tidak pernah mendapatimu berdusta.”', s:'HR. Al-Bukhari no. 4770', g:'shahih'},
{c:'Gelar itu diberikan oleh orang yang kelak memusuhinya',
 x:'“Al-Amin” bukan gelar dari pengikut. Ia lahir dari transaksi dagang, penitipan barang, dan penyelesaian sengketa — diberikan oleh orang-orang yang sebagian besar kelak memboikot, mengusir, dan memeranginya. Bahkan pada malam hijrah, barang titipan musuh-musuhnya masih ada di rumahnya.<br><br>Urutannya penting: <em>kepercayaan dibangun dulu, klaim kebenaran datang belakangan.</em> Bukan sebaliknya.'},
{j:'g3'},

{k:'g3', n:'Menjelang usia empat puluh, ia mulai sering menyendiri. Ia membawa bekal ke sebuah gua sempit di Jabal Nur, beberapa kilometer dari kota, dan tinggal di sana berhari-hari. Orang Arab menyebutnya <em>tahannuts</em> — menyepi untuk merenung.'},
{n:'Gua itu bernama Hira. Mulutnya menghadap ke arah Ka‘bah. Dan pada suatu malam di bulan Ramadan, kesunyian itu pecah.'}
]});

CH.push({
id:4, glyph:'د', yr:'610', years:'610 M · Ramadan', title:'Bacalah',
blurb:'Wahyu pertama, ketakutan yang jujur, dan seorang perempuan yang menilai kenabian dari rekam jejak sosial.',
nodes:[
{n:'Aisyah radhiyallahu ‘anha meriwayatkan permulaannya. Perhatikan bahwa perawi utama peristiwa paling sakral dalam sejarah Islam adalah seorang perempuan, yang meriwayatkannya dari Nabi sendiri.'},
{r:'Aisyah r.a.', x:'Permulaan wahyu yang datang kepada Rasulullah ﷺ adalah mimpi yang benar dalam tidur. Tidaklah beliau bermimpi kecuali mimpi itu datang seperti terangnya waktu subuh. Kemudian beliau menyukai menyendiri.',
 s:'HR. Al-Bukhari no. 3', g:'shahih'},
{n:'Di gua itu, Jibril datang dan berkata: <em>Iqra’</em> — Bacalah. Ia menjawab, “Aku tidak bisa membaca.” Jibril mendekapnya sampai ia kepayahan, lalu melepasnya dan mengulang. Tiga kali. Pada yang ketiga, kalimat itu berubah.'},
{ay:'اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ ۝ خَلَقَ الْإِنسَانَ مِنْ عَلَقٍ ۝ اقْرَأْ وَرَبُّكَ الْأَكْرَمُ ۝ الَّذِي عَلَّمَ بِالْقَلَمِ ۝ عَلَّمَ الْإِنسَانَ مَا لَمْ يَعْلَمْ',
 m:'“Bacalah dengan nama Tuhanmu yang menciptakan. Dia menciptakan manusia dari segumpal darah. Bacalah, dan Tuhanmulah Yang Maha Mulia — yang mengajar dengan pena, mengajarkan manusia apa yang tidak diketahuinya.”',
 s:'QS Al-‘Alaq: 1-5', qref:1},
{c:'Kata pertama agama ini adalah perintah membaca',
 x:'Bukan “sembahlah”, bukan “berimanlah”, bukan “berperanglah”. Perintah pertama adalah <em>membaca</em>, dan disebutkan pula alatnya: <em>pena</em>. Diturunkan di tengah masyarakat yang bangga pada hafalan lisan dan memandang rendah tulisan.<br><br>Dan ia turun kepada orang yang menjawab jujur, “aku tidak bisa membaca.” Wahyu pertama tidak mensyaratkan kemampuan — ia mensyaratkan kesediaan.'},
{n:'Beliau turun dari gunung dalam keadaan gemetar hebat, pulang, dan berkata kepada istrinya:'},
{sb:'زَمِّلُونِي زَمِّلُونِي ... لَقَدْ خَشِيتُ عَلَى نَفْسِي',
 m:'“Selimuti aku, selimuti aku... sungguh aku mengkhawatirkan diriku.”',
 s:'HR. Al-Bukhari no. 3; Muslim no. 160', g:'shahih'},
{a:'Ia takut. Tidak ada kemenangan, tidak ada euforia. Hanya seorang laki-laki empat puluh tahun yang ketakutan dan minta diselimuti istrinya.'},
{c:'Riwayat ini tidak dipoles',
 x:'Kalau kisah ini karangan, adegan inilah yang pertama akan dihapus. Seorang pendiri agama yang gemetar, ragu, dan mencemaskan kewarasannya sendiri bukan citra yang menjual. Justru karena tetap dipertahankan dalam kitab paling sahih, kejujuran teks ini punya bobot tersendiri.<br><br>Dan ada implikasi praktisnya: pengalaman spiritual yang mengguncang tidak otomatis membuat seseorang merasa hebat. Kadang ia membuat orang merasa kecil.'},
{n:'Khadijah tidak menenangkannya dengan “tenang saja” atau “kamu pasti nabi”. Ia mengajukan sebuah argumen.'},
{sb:'كَلَّا وَاللَّهِ، لَا يُخْزِيكَ اللَّهُ أَبَدًا؛ إِنَّكَ لَتَصِلُ الرَّحِمَ، وَتَحْمِلُ الْكَلَّ، وَتَكْسِبُ الْمَعْدُومَ، وَتَقْرِي الضَّيْفَ، وَتُعِينُ عَلَى نَوَائِبِ الْحَقِّ',
 m:'“Sekali-kali tidak. Demi Allah, Allah tidak akan pernah menghinakanmu. Sungguh engkau menyambung tali kekerabatan, menanggung beban orang lain, memberi kepada yang tidak punya, memuliakan tamu, dan menolong orang yang tertimpa musibah.” — perkataan Khadijah r.a.',
 s:'HR. Al-Bukhari no. 3', g:'shahih'},
{c:'Bukti kenabian yang diajukan Khadijah adalah rekam jejak sosial',
 x:'Ini mungkin argumen paling brilian di seluruh sirah, dan hampir selalu dilewati. Khadijah tidak menyebut satu pun mukjizat, mimpi, atau tanda langit. Ia menyebut <strong>lima perbuatan yang semuanya berdimensi sosial</strong>: silaturahmi, menanggung beban orang lain, memberi kepada yang tak punya, memuliakan tamu, menolong korban musibah.<br><br>Logikanya: Allah tidak akan menghinakan orang yang hidupnya seperti ini. Karakter moral dijadikan bukti epistemik. Bagi siapa pun yang ingin menilai klaim keagamaan hari ini, metode Khadijah masih relevan — <em>lihat bagaimana ia memperlakukan yang lemah.</em>'},
{n:'Khadijah membawanya kepada sepupunya, Waraqah bin Naufal — seorang tua yang telah memeluk Kristen dan menyalin Injil dalam bahasa Ibrani. Waraqah mengenali gambaran itu dan menyebutnya <em>an-namus</em>, pembawa wahyu yang pernah datang kepada Musa.'},
{r:'Waraqah bin Naufal', x:'“Andai saja aku masih hidup ketika kaummu mengusirmu.” Beliau bertanya, “Apakah mereka akan mengusirku?” Waraqah menjawab, “Ya. Tidak ada seorang pun yang membawa seperti yang engkau bawa kecuali dimusuhi.”',
 s:'HR. Al-Bukhari no. 3', g:'shahih'},
{c:'Pengesahan pertama datang dari seorang Kristen',
 x:'Orang pertama di luar keluarga yang membenarkan kenabian beliau bukan seorang Muslim — belum ada Muslim. Ia seorang Nasrani tua yang mengenali polanya dari kitab-kitab sebelumnya. Al-Qur’an kemudian membingkai hubungan ini bukan sebagai kebetulan, tapi sebagai kesinambungan.'},
{n:'Lalu wahyu berhenti. Berbulan-bulan, tanpa kabar. Masa itu disebut <em>fatratul wahyi</em>, dan beliau mengalami kesedihan yang berat.'},
{ay:'مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ',
 m:'“Tuhanmu tidak meninggalkanmu, dan tidak pula membencimu.”',
 s:'QS Ad-Duha: 3', qref:1},
{n:'Kemudian panggilan itu kembali — dan kali ini bukan lagi untuk membaca, melainkan untuk bangkit.'},
{ay:'يَا أَيُّهَا الْمُدَّثِّرُ ۝ قُمْ فَأَنذِرْ ۝ وَرَبَّكَ فَكَبِّرْ ۝ وَثِيَابَكَ فَطَهِّرْ ۝ وَالرُّجْزَ فَاهْجُرْ ۝ وَلَا تَمْنُن تَسْتَكْثِرُ ۝ وَلِرَبِّكَ فَاصْبِرْ',
 m:'“Wahai orang yang berselimut, bangunlah lalu berilah peringatan. Dan agungkanlah Tuhanmu, dan bersihkanlah pakaianmu, dan tinggalkanlah segala kekotoran. Dan janganlah engkau memberi dengan maksud memperoleh balasan yang lebih banyak. Dan karena Tuhanmu, bersabarlah.”',
 s:'QS Al-Muddatstsir: 1-7', qref:1},
{c:'“Jangan memberi karena mengharap lebih banyak”',
 x:'Di antara perintah-perintah agung itu terselip satu klausul yang terdengar sepele: <em>lā tamnun tastaktsir</em> — jangan memberi lalu mengharapkan balasan yang lebih besar. Pada wahyu tahap paling awal, ketika belum ada satu pun hukum ibadah yang rinci, Allah sudah mengatur <strong>motif</strong> di balik kedermawanan.<br><br>Agama ini mulai dari dalam, bukan dari daftar aturan.'}
]});

CH.push({
id:5, glyph:'ه', yr:'613', years:'613 – 619 M', title:'Yang Ditindas Lebih Dulu',
blurb:'Dakwah terbuka, dan sebuah pola yang berulang di sepanjang sejarah: yang dihajar duluan selalu yang paling tak berdaya.',
nodes:[
{n:'Tiga tahun pertama berlangsung diam-diam, berpusat di rumah Al-Arqam bin Abil Arqam — seorang pemuda dari Bani Makhzum, kabilah yang justru jadi musuh terkeras. Rumahnya di kaki bukit Shafa: dekat, tapi tak mencurigakan.'},
{n:'Lalu turun perintah untuk terbuka.'},
{ay:'فَاصْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ الْمُشْرِكِينَ',
 m:'“Maka sampaikanlah secara terang-terangan apa yang diperintahkan kepadamu, dan berpalinglah dari orang-orang musyrik.”',
 s:'QS Al-Hijr: 94', qref:1},
{n:'Beliau naik ke bukit Shafa dan menyeru seluruh kabilah. Setelah mereka mengakui bahwa ia tak pernah berdusta, ia menyampaikan peringatannya. Abu Lahab — pamannya sendiri — memotong dengan makian dan membubarkan majelis.', s:'HR. Al-Bukhari no. 4770', g:'shahih'},
{n:'Sejak itu, penindasan dimulai. Tetapi perhatikan siapa yang lebih dulu dihajar.'},
{n:'Bilal bin Rabah, budak Umayyah bin Khalaf, dijemur di padang pasir dengan batu besar di dada. Yang keluar dari mulutnya hanya satu kata berulang: <em>Ahad, Ahad.</em>', s:'Sirah Ibnu Hisyam; Ibnu Sa‘d', g:'sirah'},
{n:'Keluarga Yasir — Yasir, istrinya Sumayyah, dan anaknya Ammar — disiksa di terik Ramdha’. Sumayyah, seorang perempuan tua berstatus budak, wafat di sana. Ia menjadi syahid pertama dalam Islam.'},
{sb:'صَبْرًا آلَ يَاسِرٍ، فَإِنَّ مَوْعِدَكُمُ الْجَنَّةُ',
 m:'“Bersabarlah, wahai keluarga Yasir. Sesungguhnya tempat yang dijanjikan bagi kalian adalah surga.”',
 s:'Ibnu Ishaq; Al-Hakim, Al-Mustadrak', g:'dhaif', note:'Masyhur dalam kitab sirah; sebagian jalurnya mursal.'},
{c:'Nabi lewat dan tidak bisa menolong',
 x:'Riwayat ini jarang ditampilkan apa adanya: beliau melintasi keluarga Yasir yang sedang disiksa, dan yang bisa beliau lakukan hanyalah mengucapkan penghiburan. Ia tidak punya kuasa, tidak punya pasukan, tidak punya mukjizat yang dikeluarkan saat itu juga.<br><br>Ini penting untuk siapa pun yang menyangka bahwa kebenaran selalu datang dengan kemampuan menyelamatkan. Kadang yang tersedia hanya kesetiaan menemani.'},
{q:'Bagaimana mereka bertahan?', o:[
  {l:'Sebagian pergi mencari suaka', to:'habasy'},
  {l:'Sebagian bertahan dan diboikot', to:'boikot'}
]},

{k:'habasy', n:'Beliau menyuruh sebagian sahabat menyeberang ke Habasyah — kerajaan Kristen di Afrika. Alasannya beliau sebutkan sendiri: di sana ada raja yang di sisinya tidak ada seorang pun dizalimi.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{n:'Quraisy mengirim delegasi menuntut ekstradisi. Najasyi memanggil kedua pihak. Ja‘far bin Abi Thalib menjawab dengan menjelaskan kondisi mereka sebelum dan sesudah Islam, lalu membacakan awal Surah Maryam.'},
{ay:'وَاذْكُرْ فِي الْكِتَابِ مَرْيَمَ إِذِ انتَبَذَتْ مِنْ أَهْلِهَا مَكَانًا شَرْقِيًّا',
 m:'“Dan ceritakanlah kisah Maryam di dalam Kitab, ketika ia menjauhkan diri dari keluarganya ke suatu tempat di sebelah timur.”',
 s:'QS Maryam: 16', qref:1},
{n:'Najasyi mengambil sebatang tongkat, menggores garis di tanah, dan berkata bahwa perbedaan antara agama mereka tidak lebih lebar dari garis itu. Permintaan ekstradisi ditolak.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Suaka pertama umat Islam diberikan oleh negara Kristen',
 x:'Umat ini pertama kali diselamatkan bukan oleh sesama Muslim, melainkan oleh seorang raja Nasrani yang menolak menyerahkan pengungsi. Ketika Najasyi wafat, Nabi ﷺ menshalatkannya dari kejauhan.<br><br>Al-Qur’an merekam kedekatan ini secara eksplisit — dan ayat itu jarang dibacakan utuh di mimbar.'},
{ay:'وَلَتَجِدَنَّ أَقْرَبَهُم مَّوَدَّةً لِّلَّذِينَ آمَنُوا الَّذِينَ قَالُوا إِنَّا نَصَارَىٰ ۚ ذَٰلِكَ بِأَنَّ مِنْهُمْ قِسِّيسِينَ وَرُهْبَانًا وَأَنَّهُمْ لَا يَسْتَكْبِرُونَ',
 m:'“Dan sungguh engkau akan mendapati yang paling dekat persahabatannya dengan orang-orang beriman adalah mereka yang berkata, ‘Sesungguhnya kami orang Nasrani.’ Itu karena di antara mereka ada para pendeta dan rahib, dan karena mereka tidak menyombongkan diri.”',
 s:'QS Al-Ma’idah: 82', qref:1},
{j:'g5'},

{k:'boikot', n:'Sekitar tahun ketujuh kenabian, Quraisy menggantungkan piagam di dinding Ka‘bah: tidak ada yang boleh menikah, berdagang, atau bergaul dengan Bani Hasyim dan Bani Muthalib sampai mereka menyerahkan Muhammad.'},
{n:'Seluruh klan diasingkan ke lembah sempit Syi‘b Abi Thalib selama sekitar tiga tahun. Termasuk bayi, orang tua, dan mereka yang belum masuk Islam. Riwayat menyebut suara tangis anak-anak kelaparan terdengar sampai keluar lembah, dan sebagian mereka memakan dedaunan.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Yang diboikot bukan hanya orang Islam',
 x:'Boikot itu berbasis <em>kabilah</em>, bukan agama. Bani Hasyim yang masih musyrik ikut menderita karena solidaritas darah, sementara sebagian Muslim dari kabilah lain tidak terkena. Salah satu yang memutus boikot juga orang musyrik — Hisyam bin Amr dan beberapa rekannya, karena merasa itu keterlaluan.<br><br>Garis antara “kita” dan “mereka” di masa itu jauh lebih berantakan daripada yang biasa digambarkan.'},
{j:'g5'},

{k:'g5', n:'Abu Thalib melindunginya sampai akhir hayat tanpa pernah menyatakan syahadat. Perlindungan itu memakan seluruh kehormatan dan hartanya. Ketika beliau memohon agar pamannya mengucapkan kalimat itu di detik-detik terakhir, ia menolak.'},
{ay:'إِنَّكَ لَا تَهْدِي مَنْ أَحْبَبْتَ وَلَٰكِنَّ اللَّهَ يَهْدِي مَن يَشَاءُ',
 m:'“Sesungguhnya engkau tidak dapat memberi petunjuk kepada orang yang engkau cintai, tetapi Allah memberi petunjuk kepada siapa yang Dia kehendaki.”',
 s:'QS Al-Qashash: 56', qref:1},
{c:'Batas kuasa seorang nabi',
 x:'Ayat ini turun berkaitan dengan Abu Thalib, menurut riwayat Al-Bukhari no. 4772. Maknanya keras: <strong>bahkan Nabi tidak bisa memasukkan hidayah ke dalam dada orang yang paling ia cintai.</strong><br><br>Kalau beliau saja tidak bisa, maka siapa pun yang merasa berhak memaksa keyakinan orang lain sedang mengklaim wewenang yang tidak pernah diberikan kepada Rasulullah sendiri.'}
]});

CH.push({
id:6, glyph:'و', yr:'619', years:'619 – 620 M · ‘Amul Huzn', title:'Tahun Duka',
blurb:'Kehilangan pelindung dan penopang dalam satu tahun. Lalu Thaif — dan sebuah tawaran balas dendam yang ditolak.',
nodes:[
{n:'Boikot berakhir, tetapi tubuh dua orang paling penting dalam hidupnya sudah terlalu rapuh. Dalam rentang beberapa bulan, Abu Thalib wafat, lalu Khadijah wafat.'},
{a:'Satu perisai politiknya hilang. Satu penopang batinnya hilang. Dua puluh lima tahun pernikahan berakhir.'},
{n:'Beliau menamai tahun itu <em>‘Amul Huzn</em> — tahun kesedihan. Dan bertahun-tahun setelahnya, ketika sudah menikah lagi, beliau masih menyembelih kambing lalu mengirimkan dagingnya kepada teman-teman Khadijah.', s:'HR. Muslim no. 2435', g:'shahih'},
{r:'Aisyah r.a.', x:'“Aku tidak pernah cemburu kepada seorang pun dari istri-istri Nabi ﷺ seperti cemburuku kepada Khadijah, padahal aku tidak pernah melihatnya.”',
 s:'HR. Al-Bukhari no. 3816; Muslim no. 2435', g:'shahih'},
{c:'Kesetiaan yang tidak berhenti di kuburan',
 x:'Sering diceritakan sebagai romantisme belaka. Padahal ada dimensi etisnya: beliau menjaga <em>jaringan sosial</em> mendiang istrinya. Yang dikirimi daging bukan keluarga Khadijah, melainkan sahabat-sahabatnya. Menghormati orang yang wafat berarti merawat orang-orang yang dulu ia sayangi.'},
{n:'Tanpa pelindung, tekanan di Mekah menjadi mustahil. Beliau berjalan kaki sekitar seratus kilometer ke Thaif, kota kedua terpenting, berharap menemukan telinga yang mau mendengar.'},
{n:'Tiga bersaudara pemuka Bani Tsaqif menolaknya dengan cara yang menghina. Salah satunya berkata: apakah Allah tak menemukan orang lain selain kamu untuk diutus? Lalu mereka mengerahkan budak dan anak-anak untuk melempari beliau sepanjang jalan keluar kota, sampai kedua kakinya berdarah.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{n:'Beliau berteduh di kebun anggur milik dua bersaudara dari Mekah. Doa yang diriwayatkan diucapkan di sana sangat masyhur — meski sanadnya lemah, ia terlalu penting untuk disembunyikan darimu.'},
{sb:'اللَّهُمَّ إِلَيْكَ أَشْكُو ضَعْفَ قُوَّتِي، وَقِلَّةَ حِيلَتِي، وَهَوَانِي عَلَى النَّاسِ ... إِنْ لَمْ يَكُنْ بِكَ غَضَبٌ عَلَيَّ فَلَا أُبَالِي',
 m:'“Ya Allah, kepada-Mu aku mengadukan lemahnya kekuatanku, sedikitnya siasatku, dan hinanya aku di mata manusia... Jika Engkau tidak murka kepadaku, aku tidak peduli.”',
 s:'Ibnu Ishaq; Ath-Thabrani, Al-Mu‘jamul Kabir', g:'dhaif', note:'Populer dalam kitab sirah; para ahli hadis melemahkan sanadnya.'},
{n:'Yang berikut ini derajatnya sahih, dan justru lebih menentukan.'},
{r:'Aisyah r.a.', x:'Aku bertanya kepada Nabi ﷺ, adakah hari yang lebih berat dari Perang Uhud. Beliau menyebut hari di Thaif — lalu bercerita bahwa Jibril datang bersama Malaikat penjaga gunung, yang menawarkan untuk menimpakan dua gunung kepada penduduk kota itu.',
 s:'HR. Al-Bukhari no. 3231; Muslim no. 1795', g:'shahih'},
{n:'Tawarannya konkret. Kekuatan untuk menghancurkan kota yang baru saja menghinakannya sudah berada di tangannya. Jawabannya:'},
{sb:'بَلْ أَرْجُو أَنْ يُخْرِجَ اللَّهُ مِنْ أَصْلَابِهِمْ مَنْ يَعْبُدُ اللَّهَ وَحْدَهُ لَا يُشْرِكُ بِهِ شَيْئًا',
 m:'“Bahkan aku berharap Allah mengeluarkan dari sulbi mereka orang-orang yang menyembah Allah semata, tidak menyekutukan-Nya dengan sesuatu pun.”',
 s:'HR. Al-Bukhari no. 3231; Muslim no. 1795', g:'shahih'},
{c:'Yang ditolak bukan cuma balas dendam — tapi juga kesimpulan',
 x:'Beliau tidak berkata “maafkan mereka”. Beliau berkata: <em>lihat generasi berikutnya.</em> Orang-orang yang melempari beliau tidak dinilai sebagai vonis akhir atas seluruh kota; mereka dinilai sebagai satu titik dalam waktu yang jauh lebih panjang.<br><br>Dua puluh tahun kemudian, Thaif memeluk Islam. Dan salah satu keturunan mereka menjadi ahli hadis. Harapannya terbukti — tetapi yang bernilai adalah bahwa harapan itu diucapkan justru ketika masih berdarah.'},
{sb:'إِنِّي لَمْ أُبْعَثْ لَعَّانًا، وَإِنَّمَا بُعِثْتُ رَحْمَةً',
 m:'“Sesungguhnya aku tidak diutus sebagai pelaknat. Aku hanyalah diutus sebagai rahmat.”',
 s:'HR. Muslim no. 2599', g:'shahih'},
{n:'Dalam perjalanan pulang, ada masalah teknis: tanpa pelindung, ia tidak bisa masuk kembali ke kotanya sendiri. Ia mengirim pesan kepada beberapa tokoh Quraisy meminta jaminan keamanan. Dua menolak. Satu menerima.'},
{n:'Namanya Muth‘im bin ‘Adi — seorang musyrik yang tidak pernah masuk Islam. Ia mempersenjatai anak-anaknya dan mengawal Muhammad masuk Mekah secara terbuka.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Utang budi yang dibayar bertahun-tahun kemudian',
 x:'Setelah Perang Badar, ketika tawanan Quraisy berada di tangan beliau, Nabi ﷺ berkata bahwa seandainya Muth‘im masih hidup dan meminta tawanan-tawanan itu, beliau akan menyerahkan mereka kepadanya (HR. Al-Bukhari no. 3139).<br><br>Muth‘im mati dalam keadaan musyrik. Kebaikannya tetap diakui secara terbuka di depan umat. Pengakuan atas jasa tidak digantungkan pada kesamaan keyakinan — dan ini menjadi salah satu pola paling konsisten dalam hidup beliau.'},
{n:'Titik terendah sudah dilewati. Yang datang berikutnya adalah malam yang paling sulit dijelaskan dalam seluruh sirah.'}
]});
CH.push({
id:7, glyph:'ز', yr:'621', years:'c. 620 – 621 M', title:'Perjalanan Malam',
blurb:'Peristiwa paling sulit dijelaskan dalam sirah — dan mandat etika yang dibawanya pulang ke bumi.',
nodes:[
{n:'Pada suatu malam, beliau dibawa dari Masjidil Haram ke Baitul Maqdis, lalu naik melampaui langit. Al-Qur’an menyebutnya dalam satu ayat, dan pembukaannya adalah <em>Subhanalladzi</em> — Maha Suci Dia — bukan “Muhammad pergi”.'},
{ay:'سُبْحَانَ الَّذِي أَسْرَىٰ بِعَبْدِهِ لَيْلًا مِّنَ الْمَسْجِدِ الْحَرَامِ إِلَى الْمَسْجِدِ الْأَقْصَى الَّذِي بَارَكْنَا حَوْلَهُ لِنُرِيَهُ مِنْ آيَاتِنَا',
 m:'“Maha Suci Dia yang telah memperjalankan hamba-Nya pada suatu malam dari Masjidil Haram ke Masjidil Aqsa yang telah Kami berkahi sekelilingnya, agar Kami perlihatkan kepadanya sebagian dari tanda-tanda Kami.”',
 s:'QS Al-Isra’: 1', qref:1},
{c:'Gelar yang dipakai pada puncak tertinggi adalah “hamba”',
 x:'Di momen paling mulia yang pernah dialami seorang manusia, Al-Qur’an tidak menyebutnya <em>nabi-Nya</em>, <em>kekasih-Nya</em>, atau <em>rasul-Nya</em>. Kata yang dipakai adalah <strong>بِعَبْدِهِ</strong> — dengan <em>hamba</em>-Nya.<br><br>Puncak kemuliaan manusia, dalam kosakata Al-Qur’an, adalah kesadaran penuh bahwa ia hamba. Bukan kenaikan status, melainkan kejernihan tentang posisi.'},
{n:'Di Baitul Maqdis beliau mengimami para nabi terdahulu. Lalu naik melewati lapis demi lapis langit hingga Sidratul Muntaha — batas yang tak bisa dilampaui makhluk.', s:'HR. Al-Bukhari no. 3887; Muslim no. 162', g:'shahih'},
{ay:'مَا زَاغَ الْبَصَرُ وَمَا طَغَىٰ ۝ لَقَدْ رَأَىٰ مِنْ آيَاتِ رَبِّهِ الْكُبْرَىٰ',
 m:'“Penglihatannya tidak menyimpang dan tidak melampaui batas. Sungguh ia telah melihat sebagian dari tanda-tanda Tuhannya yang paling besar.”',
 s:'QS An-Najm: 17-18', qref:1},
{n:'Kewajiban shalat ditetapkan lima puluh kali sehari. Dalam perjalanan turun, Musa menyarankan agar diminta keringanan. Beliau kembali berulang kali sampai menjadi lima.', s:'HR. Al-Bukhari no. 349; Muslim no. 162', g:'shahih'},
{c:'Nabi meminta keringanan, berkali-kali',
 x:'Adegan ini sering dibaca sekadar sebagai kelucuan sejarah. Padahal ia memuat prinsip: <strong>beban ibadah boleh dinegosiasikan atas dasar kemampuan manusia</strong>, dan yang melakukan negosiasi itu adalah Nabi sendiri, atas nasihat nabi lain.<br><br>Beliau tidak menganggap “semakin berat semakin saleh”. Beliau memperhitungkan umatnya yang paling lemah, bukan yang paling kuat.'},
{q:'Apa sebenarnya yang beliau bawa pulang dari langit?', o:[
  {l:'Bukankah cuma perintah shalat?', to:'kode'},
  {l:'Bagaimana orang menanggapinya?', to:'tanggap'}
]},

{k:'kode', n:'Bacalah lanjutan Surah Al-Isra’ setelah ayat pertama itu. Surah yang membuka dengan perjalanan menembus langit ternyata isinya adalah manual berperilaku di bumi.'},
{ay:'وَقَضَىٰ رَبُّكَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ وَبِالْوَالِدَيْنِ إِحْسَانًا ۚ ... فَلَا تَقُل لَّهُمَا أُفٍّ وَلَا تَنْهَرْهُمَا وَقُل لَّهُمَا قَوْلًا كَرِيمًا',
 m:'“Dan Tuhanmu telah memerintahkan agar kamu jangan menyembah selain Dia, dan hendaklah berbuat baik kepada kedua orang tua... maka janganlah engkau mengatakan kepada keduanya perkataan ‘ah’, dan janganlah membentak keduanya, dan ucapkanlah kepada keduanya perkataan yang mulia.”',
 s:'QS Al-Isra’: 23', qref:1},
{ay:'وَآتِ ذَا الْقُرْبَىٰ حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا ۝ إِنَّ الْمُبَذِّرِينَ كَانُوا إِخْوَانَ الشَّيَاطِينِ',
 m:'“Dan berikanlah haknya kepada kerabat dekat, juga kepada orang miskin dan orang dalam perjalanan; dan janganlah kamu menghambur-hamburkan hartamu secara boros. Sesungguhnya para pemboros itu saudara-saudara setan.”',
 s:'QS Al-Isra’: 26-27', qref:1},
{ay:'وَلَا تَقْفُ مَا لَيْسَ لَكَ بِهِ عِلْمٌ ۚ إِنَّ السَّمْعَ وَالْبَصَرَ وَالْفُؤَادَ كُلُّ أُولَٰئِكَ كَانَ عَنْهُ مَسْئُولًا',
 m:'“Dan janganlah engkau mengikuti sesuatu yang tidak engkau ketahui. Sesungguhnya pendengaran, penglihatan, dan hati — semuanya akan dimintai pertanggungjawaban.”',
 s:'QS Al-Isra’: 36', qref:1},
{c:'Mi‘raj bukan pelarian spiritual',
 x:'Deretan perintah setelah kisah Isra’ berbunyi seperti kode etik sipil: hormati orang tua, tunaikan hak kerabat dan orang miskin, jangan boros, jangan membunuh anak karena takut miskin, jangan mendekati zina, sempurnakan takaran, jangan berjalan dengan sombong — dan <strong>jangan mengikuti sesuatu yang tidak kau ketahui</strong>.<br><br>Ayat 36 itu, dalam praktiknya, adalah perintah verifikasi. Diturunkan dalam surah yang sama dengan mukjizat paling sulit dipercaya di seluruh sirah. Iman diminta, tapi kecerobohan berpikir tetap dilarang.'},
{j:'g7'},

{k:'tanggap', n:'Sebagian orang yang sudah beriman justru berbalik ketika mendengar cerita ini. Riwayat menyimpan fakta itu apa adanya — tidak ada usaha menutupi bahwa peristiwa ini memang berat diterima.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{n:'Orang-orang berlari mengabari Abu Bakar, mengira ia akan goyah. Jawabnya kira-kira: jika ia yang mengatakannya, maka itu benar — aku bahkan membenarkannya dalam perkara kabar dari langit yang jauh lebih jauh dari ini. Sejak itu ia dijuluki <em>Ash-Shiddiq</em>.', s:'Sirah Ibnu Ishaq', g:'sirah'},
{n:'Ketika ditantang membuktikan, beliau menggambarkan Baitul Maqdis secara rinci kepada orang-orang yang pernah ke sana, dan menyebutkan kafilah-kafilah yang sedang dalam perjalanan pulang beserta perkiraan waktu tibanya.', s:'HR. Al-Bukhari no. 3886', g:'shahih'},
{c:'Klaim yang bisa diuji',
 x:'Perhatikan bentuk pembuktiannya. Beliau tidak berkata “percaya saja”. Beliau menyebutkan hal-hal <strong>yang bisa dicek</strong> oleh pendengarnya: bentuk bangunan yang mereka kenal, dan kedatangan kafilah yang akan terbukti dalam hitungan hari.<br><br>Iman diminta pada hal yang gaib, tetapi pada hal yang bisa diperiksa, beliau justru menyerahkan diri untuk diperiksa.'},
{j:'g7'},

{k:'g7', n:'Sementara itu, di sebuah oasis dua ratus kilometer ke utara, sekelompok orang dari Yatsrib datang ke Mekah saat musim haji. Mereka bukan datang untuk berdagang.'}
]});

CH.push({
id:8, glyph:'ح', yr:'622', years:'621 – 622 M', title:'Hijrah',
blurb:'Dua baiat, dua perempuan yang ikut bersumpah, sebuah upaya pembunuhan, dan barang titipan musuh yang tetap dikembalikan.',
nodes:[
{n:'Yatsrib sedang lelah oleh perang saudara antara Aus dan Khazraj yang berlangsung puluhan tahun. Mereka butuh seseorang yang tidak berpihak pada salah satu kubu. Dua belas orang berbaiat di Aqabah pada tahun pertama.'},
{n:'Beliau mengutus Mush‘ab bin Umair — seorang pemuda yang dulu paling wangi dan paling perlente di Mekah — sebagai duta pertama Islam. Bukan sahabat paling senior. Yang dikirim adalah yang paling cakap berkomunikasi.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{n:'Setahun kemudian, tujuh puluh tiga laki-laki dan <strong>dua perempuan</strong> datang berbaiat: Nusaibah binti Ka‘ab (Ummu ‘Umarah) dan Asma’ binti ‘Amr. Baiat ini bukan sekadar ikrar iman — ia perjanjian politik dan pertahanan.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Dua perempuan menandatangani perjanjian pertahanan',
 x:'Baiat Aqabah II adalah kontrak yang isinya mencakup kesediaan melindungi beliau seperti melindungi keluarga sendiri. Dua perempuan hadir dan ikut terikat di dalamnya.<br><br>Nusaibah kelak bertempur di Uhud, terluka belasan kali, dan menjadi salah satu yang bertahan melindungi Nabi ketika barisan berantakan. Nama itu jarang sekali disebut dari mimbar, padahal beliau sendiri menyebutnya berulang kali (HR. Al-Bukhari no. 4064 tentang keteguhan Ummu ‘Umarah di Uhud).'},
{n:'Ketika Quraisy mengetahui rencana perpindahan itu, mereka bermusyawarah di Darun Nadwah. Keputusannya: satu pemuda dari tiap kabilah menusuk bersama-sama, agar Bani Hasyim tak sanggup menuntut balas kepada seluruh Quraisy sekaligus.'},
{ay:'وَإِذْ يَمْكُرُ بِكَ الَّذِينَ كَفَرُوا لِيُثْبِتُوكَ أَوْ يَقْتُلُوكَ أَوْ يُخْرِجُوكَ ۚ وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ ۖ وَاللَّهُ خَيْرُ الْمَاكِرِينَ',
 m:'“Dan ingatlah ketika orang-orang kafir merencanakan tipu daya terhadapmu untuk menahanmu, membunuhmu, atau mengusirmu. Mereka membuat tipu daya, dan Allah pun membalas tipu daya. Dan Allah sebaik-baik pembalas tipu daya.”',
 s:'QS Al-Anfal: 30', qref:1},
{n:'Malam itu beliau meminta Ali bin Abi Thalib tidur di tempat tidurnya. Bukan hanya sebagai umpan.'},
{a:'Lalu untuk apa lagi?'},
{n:'Untuk mengembalikan barang-barang titipan. Orang-orang Quraisy — termasuk yang malam itu berdiri di depan pintu untuk membunuhnya — masih menyimpan harta mereka di rumah Muhammad, karena tidak ada tempat yang lebih aman di seluruh Mekah.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Ini mungkin detail paling padat makna di seluruh sirah',
 x:'Pada malam ketika sekelompok orang datang untuk membunuhnya, harta <em>mereka</em> masih dititipkan di rumahnya. Dan hal terakhir yang ia urus sebelum melarikan diri dari kota adalah memastikan titipan itu kembali kepada pemiliknya.<br><br>Tiga belas tahun dimusuhi, diboikot, ditindas, dan hendak dibunuh — tak satu pun mengubah status barang orang lain di tangannya. Amanah tidak gugur oleh permusuhan.<br><br>Ayat tentang menunaikan amanat (QS An-Nisa’: 58) baru turun bertahun-tahun kemudian. Beliau sudah menjalankannya sebelum ia jadi ayat.'},
{n:'Bersama Abu Bakar, beliau bersembunyi tiga malam di Gua Tsur. Pengejar sampai ke mulut gua. Abu Bakar gemetar bukan karena takut mati, melainkan karena jika mereka menunduk sedikit saja, mereka akan terlihat.'},
{ay:'ثَانِيَ اثْنَيْنِ إِذْ هُمَا فِي الْغَارِ إِذْ يَقُولُ لِصَاحِبِهِ لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا',
 m:'“...ketika keduanya berada dalam gua, ketika itu ia berkata kepada sahabatnya: Jangan bersedih, sesungguhnya Allah bersama kita.”',
 s:'QS At-Taubah: 40', qref:1},
{n:'Operasi ini disokong sebuah tim kecil yang rapi: Abdullah bin Abu Bakar membawa kabar dari kota, Asma’ binti Abu Bakar mengantar bekal, dan Amir bin Fuhairah — seorang bekas budak — menggiring kambing di belakang mereka untuk menghapus jejak kaki.', s:'HR. Al-Bukhari no. 3905', g:'shahih'},
{c:'Tawakal yang disertai perencanaan',
 x:'Sering peristiwa ini diceritakan sebagai murni mukjizat. Padahal riwayat Al-Bukhari sendiri merinci sebuah operasi dengan pembagian peran: kurir intelijen, logistik, penghapus jejak, penunjuk jalan yang bahkan disewa dari seorang musyrik bernama Abdullah bin Uraiqith.<br><br>Menyewa penunjuk jalan non-Muslim untuk misi paling menentukan dalam sejarah Islam. Kompetensi diperlakukan sebagai kompetensi.'},
{n:'Suraqah bin Malik memburu mereka demi hadiah seratus unta. Kudanya terperosok berkali-kali. Ia menyerah, meminta jaminan keamanan — dan beliau memberinya, bahkan menjanjikan sesuatu yang saat itu terdengar mustahil: bahwa suatu hari Suraqah akan memakai gelang Kisra, raja Persia.', s:'HR. Al-Bukhari no. 3906', g:'shahih'},
{n:'Setelah singgah di Quba dan membangun masjid pertama, beliau memasuki Yatsrib. Sejak hari itu kota tersebut berganti nama: <strong>Madinah</strong> — kota.'},
{c:'Kalender Islam tidak dimulai dari kelahiran atau wahyu',
 x:'Bertahun-tahun kemudian, Umar bin Khattab bermusyawarah untuk menetapkan titik nol penanggalan. Pilihan yang tersedia: tahun kelahiran Nabi, tahun turunnya wahyu pertama, atau tahun wafatnya. Yang dipilih adalah <strong>hijrah</strong>.<br><br>Artinya, peristiwa yang dijadikan patokan sejarah bukan momen mistis, bukan pula kemenangan militer — melainkan saat sebuah komunitas mulai <em>membangun masyarakat</em>. Bab berikutnya menjelaskan mengapa.'}
]});

CH.push({
id:9, glyph:'ط', yr:'622', years:'622 – 624 M', title:'Konstitusi Madinah',
blurb:'Yang pertama dibangun bukan benteng. Dan dokumen politik yang menjamin kemajemukan — jarang sekali dibahas isinya.',
nodes:[
{n:'Tiga hal pertama yang beliau kerjakan di Madinah, berurutan: membangun masjid, mempersaudarakan pendatang dengan penduduk asli, dan menulis sebuah perjanjian tertulis dengan seluruh penghuni kota — termasuk yang bukan Muslim.'},
{a:'Tidak ada benteng. Tidak ada istana. Tidak ada pasukan.'},
{n:'Masjid dibangun dari batu bata lumpur, atap pelepah kurma, tiang batang pohon. Beliau ikut memikul batu bersama para sahabat. Tanahnya milik dua anak yatim, Sahl dan Suhail — dan beliau menolak menerimanya sebagai hadiah, lalu membelinya.', s:'HR. Al-Bukhari no. 428', g:'shahih'},
{c:'Membeli tanah dari dua anak yatim',
 x:'Kedua anak itu menawarkan tanah mereka secara cuma-cuma untuk masjid. Beliau menolak dan bersikeras membayar. Padahal ia baru saja tiba sebagai pengungsi tanpa harta, dan proyek itu untuk rumah ibadah.<br><br>Alasannya jelas bagi siapa pun yang pernah jadi yatim: hak anak yatim tidak boleh menjadi sumbangan, sekalipun untuk masjid, sekalipun mereka sendiri yang menawarkan.'},
{n:'Lalu <em>mu’akhah</em>: setiap Muhajirin dipasangkan dengan satu Anshar. Bukan sekadar simbolis — pada awalnya pasangan ini bahkan saling mewarisi.'},
{n:'Sebagian Anshar menawarkan separuh hartanya. Tetapi Abdurrahman bin Auf menjawab dengan kalimat yang mengubah arah ekonomi Madinah.'},
{r:'Abdurrahman bin Auf r.a.', x:'“Semoga Allah memberkahi hartamu dan keluargamu. Tunjukkan saja aku di mana pasarnya.”',
 s:'HR. Al-Bukhari no. 2048; no. 3937', g:'shahih'},
{c:'Martabat lebih dipilih daripada bantuan',
 x:'Skema bantuan terbesar dalam sejarah Islam awal justru <em>ditolak dengan sopan</em> oleh penerimanya, yang lebih memilih akses ke pasar. Beberapa bulan kemudian ia sudah mandiri.<br><br>Nabi ﷺ tidak menegurnya. Beliau menyetujui — dan kemudian membuka pasar sendiri untuk kaum Muslim, tanpa memungut sewa maupun pajak, sebagai alternatif dari pasar yang sudah ada.<br><br>Kesalehan sosial dalam sirah tidak berhenti pada memberi. Ia meluas ke <strong>menciptakan akses agar orang tidak perlu diberi</strong>.'},
{q:'Sekarang bagian yang paling jarang dibahas isinya. Siap?', o:[
  {l:'Ya — apa isi Piagam Madinah?', to:'piagam'},
  {l:'Bagaimana kehidupan sehari-harinya diatur?', to:'harian'}
]},

{k:'piagam', n:'Dokumen itu — disebut <em>Ash-Shahifah</em> — dicatat lengkap oleh Ibnu Ishaq dan dikutip Ibnu Hisyam. Ia mengikat Muhajirin, Anshar, dan suku-suku Yahudi Madinah dalam satu entitas politik.', s:'Sirah Ibnu Hisyam, Ash-Shahifah', g:'sirah'},
{n:'Pasal pembukanya menyatakan bahwa mereka semua adalah <em>ummatun wahidah min dunin nas</em> — satu umat, terpisah dari yang lain. Kata “umat” di sini jelas bermakna komunitas politik, bukan komunitas akidah.'},
{n:'Pasal tentang Yahudi Bani ‘Auf berbunyi: mereka satu umat bersama kaum mukminin; <strong>bagi orang Yahudi agama mereka, dan bagi kaum Muslim agama mereka</strong> — mencakup sekutu dan diri mereka sendiri.', s:'Sirah Ibnu Hisyam, Ash-Shahifah', g:'sirah'},
{n:'Pasal-pasal lain mengatur: kewajiban bersama menanggung biaya perang bila kota diserang, larangan melindungi pelaku kejahatan sekalipun ia kerabat, jaminan bahwa orang yang dizalimi wajib dibela, dan bahwa perselisihan yang membahayakan dikembalikan kepada Allah dan Muhammad.'},
{c:'Kemajemukan yang ditulis, bukan sekadar ditoleransi',
 x:'Yang jarang ditekankan: ini <strong>dokumen tertulis</strong>, bukan kebijakan lisan yang bisa ditarik sewaktu-waktu. Ada pasal, ada pihak, ada kewajiban timbal balik, ada mekanisme sengketa.<br><br>Non-Muslim dalam dokumen ini bukan “tamu yang ditoleransi”. Mereka pihak dengan hak dan beban yang setara dalam urusan pertahanan dan keamanan kota.<br><br>Konflik dengan sebagian suku Yahudi yang terjadi belakangan adalah soal <em>pelanggaran perjanjian pada masa perang</em> — dan itu perlu dibaca sebagai kasus hukum atas pihak tertentu, bukan sebagai pembatalan prinsip yang tertulis di sini.'},
{j:'g9'},

{k:'harian', n:'Panggilan shalat belum ada bentuknya. Diusulkan lonceng seperti Nasrani, terompet seperti Yahudi, api seperti Majusi. Semua ditolak. Lalu seorang sahabat biasa, Abdullah bin Zaid, bermimpi tentang lafal azan.', s:'HR. Abu Dawud no. 499', g:'shahih'},
{n:'Beliau membenarkan mimpi itu dan memerintahkan agar Bilal yang mengumandangkannya, karena suaranya lebih bagus. Umar lalu datang mengaku bermimpi hal yang sama.'},
{c:'Syiar terbesar Islam berasal dari mimpi seorang sahabat biasa',
 x:'Azan bukan turun sebagai wahyu. Ia lahir dari usulan warga, disaring melalui musyawarah, disahkan oleh Nabi, dan pelaksanaannya diserahkan kepada orang yang paling kompeten — seorang bekas budak dari Habasyah.<br><br>Ada seluruh teori kepemimpinan di dalam satu keputusan kecil ini.'},
{n:'Di serambi masjid tinggal <em>Ahlus Suffah</em> — para pendatang tanpa keluarga dan tanpa harta. Mereka hidup dari kelebihan makanan jamaah. Ini lembaga kesejahteraan sosial pertama dalam sejarah komunitas ini, dan letaknya menempel pada rumah ibadah.'},
{n:'Ketika beliau pertama tiba, seorang ulama Yahudi bernama Abdullah bin Salam datang mengujinya. Kalimat pertama yang ia dengar dari beliau di hadapan orang banyak adalah ini:'},
{sb:'أَيُّهَا النَّاسُ، أَفْشُوا السَّلَامَ، وَأَطْعِمُوا الطَّعَامَ، وَصِلُوا الْأَرْحَامَ، وَصَلُّوا بِاللَّيْلِ وَالنَّاسُ نِيَامٌ، تَدْخُلُوا الْجَنَّةَ بِسَلَامٍ',
 m:'“Wahai manusia, tebarkanlah salam, berilah makan, sambunglah tali kekerabatan, dan shalatlah di malam hari ketika orang-orang sedang tidur — niscaya kalian masuk surga dengan selamat.”',
 s:'HR. At-Tirmidzi no. 2485; Ibnu Majah no. 1334', g:'shahih'},
{c:'Pidato pembuka sebuah negara',
 x:'Tiga dari empat perintah dalam kalimat pertama beliau di Madinah adalah <strong>tindakan sosial horizontal</strong>: menyapa, memberi makan, merawat kekerabatan. Hanya satu yang vertikal, dan itu pun ibadah yang paling tersembunyi.<br><br>Urutan ini bukan kebetulan. Ia menjadi cetak biru bagaimana komunitas itu dibangun.'},
{j:'g9'},

{k:'g9', n:'Selama dua tahun, kota itu tumbuh. Tetapi Mekah tidak melupakan. Harta kaum Muhajirin di sana telah disita, dan sebuah bentrokan besar tinggal menunggu waktu.'}
]});

CH.push({
id:10, glyph:'ي', yr:'624', years:'624 – 628 M', title:'Perang, Kekalahan, Perjanjian',
blurb:'Musyawarah yang mengalahkan pendapat Nabi sendiri, teguran Al-Qur’an yang terbuka, dan kemenangan yang berbentuk konsesi.',
nodes:[
{n:'Di Badar, tahun kedua Hijriah, sekitar tiga ratus orang berhadapan dengan seribu. Sebelum bertempur, terjadi sesuatu yang menentukan seluruh cara Islam mengambil keputusan.'},
{n:'Beliau menempatkan pasukan di suatu titik. Al-Hubab bin Al-Mundzir bertanya: apakah posisi ini wahyu dari Allah, atau pendapat dan siasat perang? Beliau menjawab bahwa itu pendapat dan siasat. Al-Hubab lalu mengusulkan maju ke sumber air terdekat dan menutup sumur-sumur lainnya. Usul itu diterima dan dijalankan.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Nabi membedakan mana wahyu, mana ijtihadnya sendiri',
 x:'Pertanyaan Al-Hubab hanya mungkin diajukan jika kultur itu <em>sudah membolehkannya</em>. Dan jawaban Nabi ﷺ membuat garis yang sangat penting: <strong>tidak semua yang keluar dari mulut seorang pemimpin adalah kebenaran mutlak.</strong><br><br>Sebagian besar keputusan beliau sebagai kepala negara adalah ijtihad — bisa didiskusikan, bisa dikoreksi, bahkan bisa keliru. Ini fondasi seluruh tradisi musyawarah dalam Islam, dan sering hilang ketika sirah diceritakan sebagai rangkaian keajaiban.'},
{n:'Setelah kemenangan, ada tujuh puluh tawanan. Beliau bermusyawarah. Abu Bakar mengusulkan tebusan, Umar mengusulkan eksekusi. Beliau memilih tebusan — dan bagi tawanan yang tak mampu membayar tetapi bisa membaca, tebusannya adalah <strong>mengajari sepuluh anak Madinah membaca dan menulis</strong>.', s:'Ibnu Sa‘d, Ath-Thabaqat; HR. Ahmad no. 2216', g:'hasan'},
{c:'Tebusan berupa literasi',
 x:'Musuh yang baru saja berusaha memusnahkanmu dijadikan guru bagi anak-anakmu. Kebijakan tawanan perang yang membayar dirinya dengan pengetahuan — pada abad ketujuh.<br><br>Program ini melahirkan generasi pertama Muslim yang melek huruf di Madinah, termasuk beberapa yang kelak menjadi penulis wahyu.'},
{n:'Lalu turun ayat yang menegur keputusan itu.'},
{ay:'مَا كَانَ لِنَبِيٍّ أَن يَكُونَ لَهُ أَسْرَىٰ حَتَّىٰ يُثْخِنَ فِي الْأَرْضِ ۚ تُرِيدُونَ عَرَضَ الدُّنْيَا وَاللَّهُ يُرِيدُ الْآخِرَةَ',
 m:'“Tidak pantas bagi seorang nabi mempunyai tawanan sebelum ia dapat melumpuhkan musuhnya di bumi. Kamu menghendaki harta benda duniawi, sedangkan Allah menghendaki akhirat.”',
 s:'QS Al-Anfal: 67', qref:1},
{c:'Kitab suci ini mengoreksi nabinya sendiri, secara terbuka',
 x:'Ini bukan satu-satunya. Ada teguran soal tawanan Badar. Ada QS ‘Abasa: 1-10 yang menegur beliau karena berpaling dari seorang buta demi melayani bangsawan. Ada QS At-Tahrim: 1 soal urusan rumah tangga. Ada QS At-Taubah: 43 soal izin yang terlalu cepat diberikan.<br><br>Dan semuanya <strong>dibacakan di depan umum, dihafal, dan dilestarikan</strong> oleh umat yang mencintainya. Tidak ada yang menyensornya.<br><br>Bagi siapa pun yang menilai keaslian sebuah teks, ini bukti yang berat: pemalsu tidak memasukkan bab kelemahan tokohnya ke dalam kitab suci.'},
{q:'Setahun kemudian datang Uhud. Kau ingin melihat keputusan apa di sana?', o:[
  {l:'Ketika Nabi kalah suara dalam musyawarah', to:'uhud'},
  {l:'Ketika beliau hendak melaknat musuhnya', to:'laknat'}
]},

{k:'uhud', n:'Pendapat beliau: bertahan di dalam kota. Pendapat mayoritas, terutama para pemuda yang tak sempat ikut Badar: keluar menyongsong musuh. Beliau mengikuti mayoritas.'},
{n:'Ketika sebagian mereka kemudian menyesal dan menawarkan agar beliau memilih pendapatnya sendiri, beliau menolak — karena baju besi sudah dipakai, dan keputusan yang sudah diambil tidak dicabut hanya karena orang jadi ragu.', s:'HR. Ahmad; Sirah Ibnu Hisyam', g:'sirah'},
{n:'Uhud berakhir dengan kekalahan. Tujuh puluh sahabat gugur, termasuk Hamzah. Gigi beliau patah dan wajahnya terluka. Musyawarah itu, secara hasil, terbukti salah.'},
{n:'Lalu turun ayat berikut — setelah kekalahan itu, bukan sebelumnya.'},
{ay:'فَبِمَا رَحْمَةٍ مِّنَ اللَّهِ لِنتَ لَهُمْ ۖ وَلَوْ كُنتَ فَظًّا غَلِيظَ الْقَلْبِ لَانفَضُّوا مِنْ حَوْلِكَ ۖ فَاعْفُ عَنْهُمْ وَاسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِي الْأَمْرِ',
 m:'“Maka berkat rahmat Allah engkau berlaku lemah lembut terhadap mereka. Sekiranya engkau bersikap keras dan berhati kasar, tentulah mereka menjauh dari sekitarmu. Maka maafkanlah mereka, mohonkanlah ampunan untuk mereka, dan bermusyawarahlah dengan mereka dalam urusan itu.”',
 s:'QS Ali ‘Imran: 159', qref:1},
{c:'Perintah bermusyawarah turun justru setelah musyawarah menghasilkan bencana',
 x:'Ini mungkin salah satu ayat paling kontra-intuitif dalam Al-Qur’an, dan urutan turunnya nyaris tak pernah ditekankan.<br><br>Setelah tujuh puluh orang gugur karena keputusan kolektif yang keliru, respons yang diberikan bukan “mulai sekarang jangan bermusyawarah lagi, ikuti aku saja”. Melainkan: <em>maafkan mereka, mohonkan ampun untuk mereka, dan tetaplah bermusyawarah dengan mereka.</em><br><br>Musyawarah dijaga bukan karena selalu menghasilkan keputusan terbaik — melainkan karena ia membentuk masyarakat yang lebih baik. Nilainya ada pada prosesnya, bukan cuma pada hasilnya.'},
{j:'g10'},

{k:'laknat', n:'Dalam keadaan terluka di Uhud, beliau hendak mendoakan keburukan atas para pemimpin Quraisy yang menyerangnya. Sebelum sempat, turun ayat.', s:'HR. Al-Bukhari no. 4069', g:'shahih'},
{ay:'لَيْسَ لَكَ مِنَ الْأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ',
 m:'“Itu sama sekali bukan urusanmu — apakah Allah menerima tobat mereka, atau mengazab mereka, karena sesungguhnya mereka orang-orang zalim.”',
 s:'QS Ali ‘Imran: 128', qref:1},
{c:'Vonis atas orang lain bukan kewenangan siapa pun',
 x:'Kalimat ini dialamatkan kepada Nabi ﷺ, di hari ketika pamannya dibunuh dan wajahnya sendiri berdarah. Kalau di situasi seperti itu pun beliau diberitahu bahwa nasib akhir orang lain bukan urusannya, maka tidak ada seorang pun sesudahnya yang punya wewenang lebih besar.<br><br>Dan sebagian orang yang hampir dilaknat malam itu — Khalid bin Walid, Ikrimah bin Abi Jahal, Abu Sufyan — kelak menjadi Muslim.'},
{j:'g10'},

{k:'g10', n:'Tahun kelima, Madinah dikepung sepuluh ribu pasukan gabungan. Strategi yang menyelamatkan kota bukan berasal dari tradisi Arab.'},
{n:'Salman Al-Farisi, seorang Persia, mengusulkan menggali parit — teknik yang lazim di negerinya dan sama sekali asing bagi Jazirah. Beliau menerimanya, dan ikut menggali bersama semua orang.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Teknologi asing diadopsi tanpa keberatan identitas',
 x:'Tidak ada perdebatan apakah menggali parit itu “cara orang Persia” atau “bukan tradisi kita”. Yang ditanyakan hanya apakah itu bekerja.<br><br>Prinsip yang sama muncul berulang: penunjuk jalan musyrik saat hijrah, cincin stempel bergaya Romawi untuk surat diplomatik, dan kelak sistem administrasi yang diadopsi dari luar. Identitas tidak dipertaruhkan pada perkakas.'},
{n:'Tahun keenam, beliau berangkat ke Mekah untuk umrah tanpa niat perang, dan dicegat di Hudaibiyah. Yang terjadi berikutnya membuat sebagian sahabat nyaris memberontak.'},
{n:'Perjanjian yang disepakati tampak merugikan sepenuhnya: umrah ditunda setahun; gencatan senjata sepuluh tahun; siapa pun dari Quraisy yang lari ke Madinah harus dikembalikan, tetapi tidak sebaliknya.'},
{n:'Bahkan penulisan naskahnya dipersoalkan. Ketika ditulis <em>Bismillahirrahmanirrahim</em>, pihak Quraisy menolak dan meminta lafal yang biasa mereka pakai. Beliau menyetujui. Ketika ditulis “Muhammad Rasulullah”, mereka menolak. Beliau memerintahkan agar kata itu dihapus, dan menghapusnya sendiri karena Ali tak sanggup melakukannya.', s:'HR. Al-Bukhari no. 2731-2732', g:'shahih'},
{c:'Melepas gelar demi hasil',
 x:'Beliau merelakan penyebutan status kenabiannya dihapus dari sebuah dokumen — bukan karena ragu, melainkan karena tahu bahwa perdamaian sepuluh tahun lebih berharga daripada satu kata di atas kertas.<br><br>Sebagian orang hari ini akan menyebut ini “menjual prinsip”. Al-Qur’an menyebutnya <em>fathan mubina</em>.'},
{ay:'إِنَّا فَتَحْنَا لَكَ فَتْحًا مُّبِينًا',
 m:'“Sesungguhnya Kami telah memberikan kepadamu kemenangan yang nyata.”',
 s:'QS Al-Fath: 1', qref:1},
{n:'Umar mendatangi beliau dengan marah dan bertanya berulang kali mengapa mereka harus menerima kehinaan itu. Bertahun-tahun kemudian ia berkata bahwa ia terus bersedekah dan berpuasa karena menyesali kata-katanya hari itu.', s:'HR. Al-Bukhari no. 2731', g:'shahih'},
{n:'Setelah naskah ditandatangani, beliau memerintahkan para sahabat menyembelih hewan kurban dan bercukur di tempat. Tidak seorang pun bergerak. Beliau mengulanginya tiga kali. Tetap tidak ada yang bergerak.'},
{n:'Beliau masuk ke tendanya dengan gundah. Ummu Salamah, istri beliau, memberi saran: jangan bicara pada siapa pun, keluarlah dan sembelihlah hewanmu sendiri, lalu panggil tukang cukur. Beliau melakukannya. Melihat itu, seluruh pasukan bergerak serentak.', s:'HR. Al-Bukhari no. 2731', g:'shahih'},
{c:'Kebuntuan sebuah negara dipecahkan oleh nasihat seorang perempuan',
 x:'Ini tercatat dalam Shahih Al-Bukhari, bukan dalam kitab pinggiran. Nabi ﷺ menghadapi pembangkangan massal — mungkin krisis kepemimpinan paling serius dalam hidupnya — dan yang menyelesaikannya adalah analisis psikologi massa dari Ummu Salamah.<br><br>Beliau tidak mendebatnya, tidak “mempertimbangkannya nanti”. Beliau langsung menjalankannya.<br><br>Dua tahun kemudian, jumlah orang yang masuk Islam selama gencatan senjata Hudaibiyah melebihi seluruh yang masuk selama sembilan belas tahun sebelumnya.'},
{n:'Sebelum kita meninggalkan bab perang, satu hal yang wajib kau bawa.'},
{sb:'انْطَلِقُوا بِاسْمِ اللَّهِ ... وَلَا تَقْتُلُوا شَيْخًا فَانِيًا، وَلَا طِفْلًا، وَلَا صَغِيرًا، وَلَا امْرَأَةً، وَلَا تَغُلُّوا',
 m:'“Berangkatlah dengan nama Allah... janganlah kalian membunuh orang tua renta, anak-anak, anak kecil, atau perempuan; dan janganlah kalian berkhianat dalam harta rampasan.”',
 s:'HR. Abu Dawud no. 2614; lih. pula Muslim no. 1731', g:'hasan'},
{c:'Aturan perang yang mendahului zamannya',
 x:'Larangan ini dikeluarkan berabad-abad sebelum Konvensi Jenewa: non-kombatan tidak boleh disentuh, pohon tidak boleh ditebang, rumah ibadah dan penghuninya tidak diganggu, jenazah tidak dimutilasi, dan harta rampasan tidak boleh diselewengkan.<br><br>Bahwa ada pihak yang hari ini melanggarnya sambil mengaku mengikuti beliau adalah masalah tersendiri — tetapi teksnya tidak ambigu, dan usianya empat belas abad.'}
]});

CH.push({
id:11, glyph:'ك', yr:'630', years:'630 M · Ramadan 8 H', title:'Ketika Kuasa Ada di Tangan',
blurb:'Sepuluh ribu pasukan memasuki kota yang dua puluh tahun menyiksanya. Ujian sesungguhnya bukan bertahan — melainkan menang.',
nodes:[
{n:'Quraisy melanggar gencatan senjata dengan membantu sekutunya menyerang sekutu Madinah. Beliau bergerak dengan sepuluh ribu orang. Mekah tidak punya kekuatan untuk melawan.'},
{n:'Dua puluh satu tahun sebelumnya, kota yang sama menyiksa pengikutnya, memboikot keluarganya sampai anak-anak makan daun, dan mengirim pembunuh ke kamarnya.'},
{a:'Setiap orang di kota itu tahu apa yang biasanya terjadi pada kota yang kalah.'},
{n:'Sa‘d bin ‘Ubadah, pembawa panji Anshar, berseru saat memasuki kota: hari ini hari pembantaian besar. Beliau mendengarnya, mencopot panji itu darinya, dan mengoreksi kalimatnya.', s:'HR. Al-Bukhari no. 4280', g:'shahih'},
{sb:'الْيَوْمَ يَوْمُ الْمَرْحَمَةِ',
 m:'“Hari ini adalah hari kasih sayang.”',
 s:'Sirah Ibnu Hisyam; lih. HR. Al-Bukhari no. 4280', g:'sirah'},
{n:'Perintah operasi yang beliau keluarkan hampir seluruhnya bersifat menahan diri: siapa yang masuk rumahnya dan menutup pintunya, aman; siapa yang masuk Masjidil Haram, aman; siapa yang masuk rumah Abu Sufyan, aman.'},
{a:'Rumah Abu Sufyan. Panglima yang memimpin pasukan di Uhud dan Khandaq. Rumahnya dijadikan zona aman.'},
{n:'Beliau berdiri di depan Ka‘bah, di hadapan orang-orang yang mengusirnya, dan bertanya menurut mereka apa yang akan ia lakukan. Mereka menjawab: saudara yang mulia, putra saudara yang mulia. Beliau lalu mengutip perkataan Nabi Yusuf kepada saudara-saudara yang melemparkannya ke sumur.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{ay:'لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ ۖ يَغْفِرُ اللَّهُ لَكُمْ ۖ وَهُوَ أَرْحَمُ الرَّاحِمِينَ',
 m:'“Tidak ada cercaan atas kalian pada hari ini. Semoga Allah mengampuni kalian. Dan Dia Maha Penyayang di antara para penyayang.”',
 s:'QS Yusuf: 92', qref:1},
{n:'Lalu: “Pergilah, kalian bebas.”', s:'Sirah Ibnu Hisyam', g:'sirah'},
{c:'Amnesti umum, bukan pengampunan bersyarat',
 x:'Tidak ada pengadilan massal, tidak ada daftar panjang eksekusi, tidak ada perampasan properti. Hindun binti ‘Utbah, yang mencabik jasad Hamzah, hidup. Wahsyi, yang membunuhnya, hidup. Ikrimah bin Abi Jahal, Abu Sufyan, Shafwan bin Umayyah — semuanya hidup.<br><br>Ujian karakter yang sesungguhnya bukanlah ketika seseorang tak berdaya. Ia datang ketika seseorang <strong>bisa membalas dan memilih tidak</strong>.'},
{q:'Ada satu keputusan lagi hari itu yang lebih halus, tapi lebih tajam.', o:[
  {l:'Tunjukkan', to:'kunci'}
]},

{k:'kunci', n:'Kunci Ka‘bah dipegang turun-temurun oleh keluarga Bani Syaibah. Pemegangnya saat itu, Utsman bin Thalhah, pernah menolak membukakan pintu untuk beliau di masa sebelum hijrah dan memperlakukannya dengan kasar.'},
{n:'Setelah kota jatuh, kunci itu diambil. Paman beliau, Abbas, dan Ali meminta agar hak penjagaan Ka‘bah diserahkan kepada keluarga Nabi — permintaan yang sepenuhnya masuk akal secara politik.'},
{n:'Beliau memanggil Utsman bin Thalhah dan mengembalikan kunci itu kepadanya, dan menyatakan bahwa hak itu tetap pada keluarganya selamanya. Riwayat menyebut turunnya ayat berikut berkaitan dengan peristiwa ini.', s:'Sirah Ibnu Hisyam; riwayat asbabun nuzul', g:'sirah'},
{ay:'إِنَّ اللَّهَ يَأْمُرُكُمْ أَن تُؤَدُّوا الْأَمَانَاتِ إِلَىٰ أَهْلِهَا وَإِذَا حَكَمْتُم بَيْنَ النَّاسِ أَن تَحْكُمُوا بِالْعَدْلِ',
 m:'“Sesungguhnya Allah menyuruh kamu menyampaikan amanat kepada yang berhak menerimanya, dan apabila kamu menetapkan hukum di antara manusia, hendaknya kamu menetapkannya dengan adil.”',
 s:'QS An-Nisa’: 58', qref:1},
{c:'Kekuasaan absolut, dan jabatan tetap tidak dibagikan ke keluarga',
 x:'Ini keputusan yang paling mudah dilanggar dan paling sedikit dibicarakan. Beliau memegang seluruh kota, tanpa oposisi, dan keluarganya sendiri yang meminta. Jabatan itu tetap dikembalikan kepada pemegang haknya — seorang yang beberapa tahun sebelumnya memperlakukannya dengan kasar, dan yang saat itu bahkan belum masuk Islam.<br><br>Keluarga Bani Syaibah memegang kunci Ka‘bah sampai hari ini.'},
{n:'Tiga ratus enam puluh berhala di sekeliling Ka‘bah dirobohkan. Sambil merobohkannya beliau membaca:'},
{ay:'وَقُلْ جَاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُ ۚ إِنَّ الْبَاطِلَ كَانَ زَهُوقًا',
 m:'“Dan katakanlah: Kebenaran telah datang dan kebatilan telah lenyap. Sungguh, kebatilan itu pasti lenyap.”',
 s:'QS Al-Isra’: 81', qref:1},
{n:'Lalu Bilal — bekas budak yang pernah dijemur di padang pasir kota itu dengan batu di dadanya — diperintahkan naik ke atas Ka‘bah untuk mengumandangkan azan. Beberapa bangsawan Quraisy menggerutu tentang “budak hitam itu”.', s:'Sirah Ibnu Hisyam', g:'sirah'},
{ay:'يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُم مِّن ذَكَرٍ وَأُنثَىٰ وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارَفُوا ۚ إِنَّ أَكْرَمَكُمْ عِندَ اللَّهِ أَتْقَاكُمْ',
 m:'“Wahai manusia, sungguh Kami telah menciptakan kamu dari seorang laki-laki dan seorang perempuan, dan menjadikan kamu berbangsa-bangsa dan bersuku-suku agar kamu saling mengenal. Sungguh yang paling mulia di antara kamu di sisi Allah adalah yang paling bertakwa.”',
 s:'QS Al-Hujurat: 13', qref:1},
{c:'Simbol yang dipilih dengan sengaja',
 x:'Dari sepuluh ribu orang, yang dinaikkan ke atas bangunan paling suci di kota paling bergengsi adalah bekas budak Afrika. Di kota yang seluruh tatanan sosialnya disusun berdasarkan garis keturunan.<br><br>Ini bukan kelembutan personal. Ini pernyataan politik tentang bagaimana masyarakat baru itu akan menilai manusia.'}
]});

CH.push({
id:12, glyph:'ل', yr:'632', years:'632 M · 10 – 11 H', title:'Khutbah Terakhir',
blurb:'Riba pertama yang dihapus adalah riba pamannya sendiri. Dan kata-kata terakhirnya menyebut orang paling lemah.',
nodes:[
{n:'Tahun kesepuluh Hijriah, beliau menunaikan haji bersama lebih dari seratus ribu orang. Di Arafah, di atas untanya, beliau menyampaikan pidato yang kalimat-kalimatnya diulang oleh penyeru agar terdengar sampai ke tepi kerumunan.'},
{sb:'إِنَّ دِمَاءَكُمْ وَأَمْوَالَكُمْ عَلَيْكُمْ حَرَامٌ، كَحُرْمَةِ يَوْمِكُمْ هَذَا، فِي شَهْرِكُمْ هَذَا، فِي بَلَدِكُمْ هَذَا',
 m:'“Sesungguhnya darah kalian dan harta kalian haram atas kalian, sebagaimana haramnya hari kalian ini, di bulan kalian ini, di negeri kalian ini.”',
 s:'HR. Al-Bukhari no. 1739; Muslim no. 1218', g:'shahih'},
{n:'Lalu beliau menghapus dua warisan paling merusak dari masa jahiliyah — dan memulai keduanya dari keluarganya sendiri.'},
{n:'Tuntutan darah jahiliyah dihapus, dan yang pertama dibatalkan adalah tuntutan darah atas kematian anak Rabi‘ah bin Al-Harits, dari keluarga beliau sendiri. Riba jahiliyah dihapus, dan yang pertama dihapuskan adalah <strong>riba Abbas bin Abdul Muthalib — paman beliau</strong>.', s:'HR. Muslim no. 1218', g:'shahih'},
{c:'Reformasi dimulai dari rumah sendiri',
 x:'Ini bukan detail dekoratif. Dalam satu pidato, beliau menghapus dua sistem yang menguntungkan keluarganya, dan menyebut nama pamannya secara terbuka di hadapan seratus ribu orang.<br><br>Kalau kau ingin satu ukuran untuk menilai kejujuran seorang pembaru, ukurannya ada di sini: <em>siapa yang pertama kali dirugikan oleh aturan yang ia buat.</em>'},
{n:'Beliau melanjutkan dengan pesan tentang perempuan, memperingatkan agar bertakwa dalam memperlakukan mereka, dan menyebut bahwa mereka memiliki hak atas kalian sebagaimana kalian memiliki hak atas mereka.', s:'HR. Muslim no. 1218', g:'shahih'},
{sb:'يَا أَيُّهَا النَّاسُ، إِنَّ رَبَّكُمْ وَاحِدٌ، وَإِنَّ أَبَاكُمْ وَاحِدٌ. لَا فَضْلَ لِعَرَبِيٍّ عَلَى أَعْجَمِيٍّ، وَلَا لِعَجَمِيٍّ عَلَى عَرَبِيٍّ، وَلَا لِأَحْمَرَ عَلَى أَسْوَدَ، وَلَا أَسْوَدَ عَلَى أَحْمَرَ، إِلَّا بِالتَّقْوَى',
 m:'“Wahai manusia, sesungguhnya Tuhan kalian satu dan ayah kalian satu. Tidak ada keutamaan bagi orang Arab atas non-Arab, tidak pula non-Arab atas orang Arab, tidak pula orang berkulit merah atas yang berkulit hitam, tidak pula yang hitam atas yang merah — kecuali dengan takwa.”',
 s:'HR. Ahmad no. 23489', g:'hasan'},
{n:'Berkali-kali beliau bertanya kepada kerumunan apakah ia sudah menyampaikan, dan mereka menjawab ya. Lalu beliau mengangkat jarinya ke langit dan berkata: “Ya Allah, saksikanlah.”'},
{ay:'الْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِي وَرَضِيتُ لَكُمُ الْإِسْلَامَ دِينًا',
 m:'“Pada hari ini telah Aku sempurnakan agamamu untukmu, dan telah Aku cukupkan nikmat-Ku bagimu, dan telah Aku ridai Islam sebagai agamamu.”',
 s:'QS Al-Ma’idah: 3', qref:1},
{n:'Umar menangis mendengarnya. Ketika ditanya mengapa, ia menjawab bahwa setelah kesempurnaan tidak ada lagi kecuali kekurangan. Tiga bulan kemudian beliau jatuh sakit.', s:'Riwayat Ath-Thabari; lih. HR. Al-Bukhari no. 45', g:'sirah'},
{q:'Kita sampai di bagian terakhir.', o:[
  {l:'Lanjutkan', to:'wafat'}
]},

{k:'wafat', n:'Beliau sakit selama sekitar dua minggu, dirawat di kamar Aisyah. Ketika tak sanggup lagi mengimami shalat, beliau memerintahkan Abu Bakar menggantikan.'},
{n:'Di antara kalimat-kalimat terakhirnya, yang berulang kali diriwayatkan, adalah dua hal.'},
{sb:'الصَّلَاةَ الصَّلَاةَ، وَمَا مَلَكَتْ أَيْمَانُكُمْ',
 m:'“Shalat, shalat — dan orang-orang yang kalian miliki (para budak).”',
 s:'HR. Abu Dawud no. 5156; Ibnu Majah no. 2698; Ahmad', g:'shahih'},
{c:'Kata terakhirnya menyebut kelompok paling tak berdaya',
 x:'Berhentilah sejenak di sini. Seorang kepala negara, di menit-menit terakhir hidupnya, dengan seluruh warisan yang bisa ia titipkan — memilih menyebut <strong>shalat</strong> dan <strong>budak</strong>.<br><br>Hubungan vertikal dengan Tuhan, dan perlakuan terhadap manusia yang paling tidak punya kuasa untuk membela dirinya. Dua hal itu diletakkan berdampingan, dalam satu napas.<br><br>Seluruh sirah, kalau dipadatkan, bermuara di kalimat ini.'},
{n:'Beliau wafat pada hari Senin, di kamar itu, di usia enam puluh tiga tahun. Ketika para sahabat memeriksa apa yang ditinggalkannya, mereka menemukan hal berikut.'},
{r:'Aisyah r.a.', x:'Rasulullah ﷺ wafat sementara baju besinya masih tergadai pada seorang Yahudi dengan tiga puluh sha‘ gandum.',
 s:'HR. Al-Bukhari no. 2916', g:'shahih'},
{c:'Wafat dalam keadaan berutang, dan kepada seorang Yahudi',
 x:'Penguasa seluruh Jazirah Arab meninggal tanpa harta, dengan baju besinya digadaikan untuk membeli gandum bagi keluarganya. Dua fakta yang tersimpan sekaligus dalam satu riwayat pendek:<br><br>Pertama, tidak ada akumulasi kekayaan sama sekali dari kekuasaan yang ia pegang.<br>Kedua, pada tahun terakhir hidupnya, di ibu kota negara Islam, transaksi kredit dengan seorang Yahudi berjalan normal — dan ia tidak mencari pemberi pinjaman sesama Muslim untuk “alasan keamanan”.'},
{n:'Umar menolak percaya dan mengancam siapa pun yang mengatakan beliau wafat. Abu Bakar masuk, membuka kain penutup wajah beliau, menciumnya, lalu keluar menemui orang banyak.'},
{r:'Abu Bakar Ash-Shiddiq r.a.', x:'“Barangsiapa menyembah Muhammad, sesungguhnya Muhammad telah wafat. Dan barangsiapa menyembah Allah, sesungguhnya Allah Maha Hidup dan tidak akan mati.” Lalu ia membacakan ayat.',
 s:'HR. Al-Bukhari no. 1241-1242', g:'shahih'},
{ay:'وَمَا مُحَمَّدٌ إِلَّا رَسُولٌ قَدْ خَلَتْ مِن قَبْلِهِ الرُّسُلُ ۚ أَفَإِن مَّاتَ أَوْ قُتِلَ انقَلَبْتُمْ عَلَىٰ أَعْقَابِكُمْ',
 m:'“Dan Muhammad hanyalah seorang rasul; sebelumnya telah berlalu beberapa rasul. Apakah jika ia wafat atau dibunuh, kamu berbalik ke belakang?”',
 s:'QS Ali ‘Imran: 144', qref:1},
{n:'Umar berkata bahwa kakinya tak sanggup menopang tubuhnya ketika mendengar ayat itu, seolah baru pertama kali diturunkan.'},
{c:'Pesan terakhir kepada umat: jangan mengkultuskan aku',
 x:'Beliau sudah memperingatkannya jauh sebelum itu: <em>“Janganlah kalian berlebihan memujiku sebagaimana orang Nasrani berlebihan memuji putra Maryam. Aku hanyalah hamba-Nya. Maka katakanlah: hamba Allah dan rasul-Nya.”</em> (HR. Al-Bukhari no. 3445).<br><br>Dan ketika matahari gerhana pada hari putranya Ibrahim wafat, dan orang-orang mulai mengaitkan keduanya, beliau segera membantahnya: matahari dan bulan adalah tanda-tanda Allah yang tidak gerhana karena kematian atau kelahiran siapa pun (HR. Al-Bukhari no. 1043).<br><br>Bahkan kesedihannya sendiri tidak ia biarkan menjadi mitos.'},
{n:'Perjalanan garis waktunya berakhir di sini. Tapi masih ada satu ruang lagi — berisi hal-hal yang tak masuk ke dalam kronologi mana pun, dan justru karena itu paling jarang terdengar.'}
]});

CH.push({
id:13, glyph:'م', yr:'—', years:'Lintas waktu · tematik', title:'Yang Jarang Naik Mimbar',
blurb:'Delapan tema yang tidak punya tempat dalam kronologi: rumah tangga, hewan, anak-anak, humor, rasisme, batas otoritas, kesederhanaan, dan tetangga.',
nodes:[
{n:'Ruang ini tidak berurutan. Pilih apa yang ingin kau dengar. Kau bisa kembali ke sini sesudahnya.'},

{k:'hub', q:'Mana yang ingin kau buka?', o:[
  {l:'Di dalam rumah — istri dan pelayan', to:'rumah'},
  {l:'Hewan dan lingkungan', to:'alam'},
  {l:'Anak-anak', to:'anak'},
  {l:'Beliau bercanda', to:'canda'},
  {l:'Rasisme dan kesetaraan', to:'ras'},
  {l:'Batas otoritasnya sendiri', to:'batas'},
  {l:'Kesederhanaan dan utang', to:'zuhud'},
  {l:'Tetangga dan yang berbeda agama', to:'tetangga'},
  {l:'Cukup — tutup perjalanan ini', to:'akhir'}
]},

{k:'rumah', r:'Al-Aswad bin Yazid, bertanya kepada Aisyah r.a.', x:'Aku bertanya kepada Aisyah, apa yang biasa dilakukan Nabi ﷺ di rumahnya. Ia menjawab: beliau mengerjakan pekerjaan keluarganya — dan apabila tiba waktu shalat, beliau keluar untuk shalat.',
 s:'HR. Al-Bukhari no. 676', g:'shahih'},
{n:'Riwayat lain merinci: beliau menjahit sandalnya sendiri, menambal bajunya, dan memerah susu kambingnya.', s:'HR. Ahmad no. 26194', g:'hasan'},
{r:'Anas bin Malik r.a.', x:'Aku melayani Nabi ﷺ selama sepuluh tahun. Beliau tidak pernah sekalipun berkata “ah” kepadaku. Tidak pernah menegur sesuatu yang kulakukan dengan “mengapa kau lakukan ini”, dan tidak pernah menegur sesuatu yang tidak kulakukan dengan “mengapa tidak kau lakukan”.',
 s:'HR. Al-Bukhari no. 6038; Muslim no. 2309', g:'shahih'},
{c:'Sepuluh tahun tanpa satu bentakan',
 x:'Anas mulai melayani beliau pada usia sekitar sepuluh tahun — seorang anak, di rumah kepala negara, selama satu dekade penuh. Kalau ada satu tempat di mana karakter seseorang tak bisa disembunyikan, itu adalah di hadapan pelayannya sendiri.<br><br>Perhatikan struktur kesaksiannya: bukan “beliau baik”, melainkan tiga hal spesifik yang <em>tidak pernah</em> terjadi. Kesaksian negatif jauh lebih sulit dipalsukan daripada pujian.'},
{sb:'خَيْرُكُمْ خَيْرُكُمْ لِأَهْلِهِ، وَأَنَا خَيْرُكُمْ لِأَهْلِي',
 m:'“Sebaik-baik kalian adalah yang paling baik kepada keluarganya, dan aku adalah yang paling baik di antara kalian kepada keluargaku.”',
 s:'HR. At-Tirmidzi no. 3895; Ibnu Majah no. 1977', g:'shahih'},
{j:'hub'},

{k:'alam', r:'Abu Hurairah r.a.', x:'Nabi ﷺ bersabda bahwa seorang perempuan disiksa karena seekor kucing yang ia kurung sampai mati — ia tidak memberinya makan, dan tidak pula melepaskannya agar bisa memakan serangga tanah.',
 s:'HR. Al-Bukhari no. 3482; Muslim no. 2242', g:'shahih'},
{n:'Dan kebalikannya: seorang laki-laki yang turun ke sumur untuk mengambil air dengan sepatunya demi seekor anjing yang kehausan. Para sahabat bertanya apakah ada pahala pada binatang. Jawabnya:'},
{sb:'فِي كُلِّ كَبِدٍ رَطْبَةٍ أَجْرٌ',
 m:'“Pada setiap makhluk bernyawa yang memiliki hati basah, ada pahala.”',
 s:'HR. Al-Bukhari no. 2363; Muslim no. 2244', g:'shahih'},
{n:'Suatu kali beliau masuk ke kebun seorang Anshar dan seekor unta mendatanginya lalu merintih dan meneteskan air mata. Beliau mengusap punggungnya, lalu memanggil pemiliknya.'},
{sb:'أَفَلَا تَتَّقِي اللَّهَ فِي هَذِهِ الْبَهِيمَةِ الَّتِي مَلَّكَكَ اللَّهُ إِيَّاهَا؟ فَإِنَّهُ شَكَا إِلَيَّ أَنَّكَ تُجِيعُهُ وَتُدْئِبُهُ',
 m:'“Tidakkah engkau bertakwa kepada Allah dalam urusan binatang yang Allah jadikan milikmu ini? Sungguh ia mengadu kepadaku bahwa engkau membiarkannya lapar dan memaksanya bekerja terlalu keras.”',
 s:'HR. Abu Dawud no. 2549', g:'shahih'},
{sb:'مَا مِنْ مُسْلِمٍ يَغْرِسُ غَرْسًا، أَوْ يَزْرَعُ زَرْعًا، فَيَأْكُلُ مِنْهُ طَيْرٌ أَوْ إِنْسَانٌ أَوْ بَهِيمَةٌ، إِلَّا كَانَ لَهُ بِهِ صَدَقَةٌ',
 m:'“Tidaklah seorang Muslim menanam tanaman atau menabur benih, lalu dimakan oleh burung, manusia, atau binatang, kecuali itu menjadi sedekah baginya.”',
 s:'HR. Al-Bukhari no. 2320; Muslim no. 1553', g:'shahih'},
{c:'Kepemilikan bukan izin untuk menyakiti',
 x:'Kalimat kepada pemilik unta itu tajam: <em>“binatang yang Allah jadikan milikmu”</em> — kepemilikan diakui, lalu justru dijadikan dasar tuntutan tanggung jawab, bukan pembenaran.<br><br>Dan yang paling sering dilewatkan: seekor unta digambarkan <em>mengadu</em>. Bahasa yang biasanya dipakai untuk korban yang mencari keadilan.'},
{n:'Ada juga riwayat masyhur tentang menanam bibit meski kiamat sudah di depan mata. Statusnya diperdebatkan — sebagian ahli menilainya hasan atau sahih, sebagian melemahkannya. Kau berhak tahu keduanya.'},
{sb:'إِنْ قَامَتِ السَّاعَةُ وَبِيَدِ أَحَدِكُمْ فَسِيلَةٌ، فَإِنِ اسْتَطَاعَ أَنْ لَا تَقُومَ حَتَّى يَغْرِسَهَا فَلْيَغْرِسْهَا',
 m:'“Jika kiamat terjadi sementara di tangan salah seorang dari kalian ada bibit kurma, maka jika ia sanggup menanamnya sebelum kiamat itu terjadi, hendaklah ia menanamnya.”',
 s:'HR. Ahmad no. 12902', g:'hasan', note:'Dinilai sahih oleh Al-Albani (Ash-Shahihah no. 9); sebagian ulama lain melemahkannya.'},
{j:'hub'},

{k:'anak', r:'Abu Hurairah r.a.', x:'Nabi ﷺ mencium Hasan bin Ali, sementara Al-Aqra‘ bin Habis duduk di dekatnya. Al-Aqra‘ berkata bahwa ia punya sepuluh anak dan tak pernah mencium seorang pun dari mereka. Nabi ﷺ memandangnya, lalu bersabda: “Siapa yang tidak menyayangi, tidak akan disayangi.”',
 s:'HR. Al-Bukhari no. 5997; Muslim no. 2318', g:'shahih'},
{n:'Beliau juga memendekkan shalat berjamaah — ibadah paling formal dalam Islam — karena satu alasan.'},
{sb:'إِنِّي لَأَدْخُلُ فِي الصَّلَاةِ وَأَنَا أُرِيدُ إِطَالَتَهَا، فَأَسْمَعُ بُكَاءَ الصَّبِيِّ فَأَتَجَوَّزُ فِي صَلَاتِي، مِمَّا أَعْلَمُ مِنْ شِدَّةِ وَجْدِ أُمِّهِ مِنْ بُكَائِهِ',
 m:'“Sungguh aku masuk ke dalam shalat dan aku ingin memanjangkannya. Lalu aku mendengar tangis seorang bayi, maka aku meringankan shalatku, karena aku tahu betapa berat perasaan ibunya mendengar tangisan itu.”',
 s:'HR. Al-Bukhari no. 709; Muslim no. 470', g:'shahih'},
{c:'Alasannya bukan bayinya — tapi ibunya',
 x:'Baca ulang bagian akhirnya. Yang beliau pertimbangkan bukan kenyamanan si bayi, melainkan <strong>kecemasan ibunya</strong> yang sedang shalat di belakang dan tidak bisa berbuat apa-apa.<br><br>Itu tingkat kepekaan yang tidak muncul dari aturan. Ia muncul dari kebiasaan memperhatikan orang.'},
{n:'Dan beliau pernah mengimami shalat sambil menggendong cucunya, Umamah — meletakkannya ketika sujud, mengangkatnya lagi ketika berdiri.', s:'HR. Al-Bukhari no. 516; Muslim no. 543', g:'shahih'},
{j:'hub'},

{k:'canda', n:'Ini sisi yang hampir sepenuhnya hilang dari citra populer beliau.'},
{r:'Abu Hurairah r.a.', x:'Para sahabat berkata, “Wahai Rasulullah, engkau bercanda dengan kami.” Beliau menjawab: “Sungguh aku bercanda, tetapi aku tidak mengatakan kecuali yang benar.”',
 s:'HR. At-Tirmidzi no. 1990', g:'hasan'},
{n:'Seorang laki-laki datang meminta seekor tunggangan. Beliau menjawab bahwa ia akan memberinya seekor <em>anak unta</em>. Laki-laki itu protes — apa gunanya anak unta? Jawab beliau: bukankah setiap unta adalah anak dari seekor unta betina?', s:'HR. Abu Dawud no. 4998; At-Tirmidzi no. 1991', g:'shahih'},
{n:'Ada pula riwayat masyhur tentang seorang perempuan tua yang diberitahu bahwa tidak ada nenek-nenek di surga — lalu beliau menjelaskan bahwa penghuni surga dikembalikan menjadi muda. Perlu kau tahu: sanad riwayat ini lemah.'},
{sb:'إِنَّ الْجَنَّةَ لَا يَدْخُلُهَا عَجُوزٌ ... إِنَّ اللَّهَ تَعَالَى يُنْشِئُهُنَّ إِنْشَاءً فَيَجْعَلُهُنَّ أَبْكَارًا',
 m:'“Sesungguhnya tidak masuk surga seorang nenek tua... Sesungguhnya Allah menciptakan mereka kembali menjadi gadis-gadis muda.”',
 s:'At-Tirmidzi, Asy-Syama’il Al-Muhammadiyah', g:'dhaif', note:'Sangat populer di ceramah; sanadnya dinilai lemah oleh sebagian ahli hadis.'},
{c:'Humor yang tidak dibangun di atas dusta atau penghinaan',
 x:'Kaidahnya jelas dari hadis pertama: bercanda diperbolehkan, <strong>berbohong tidak</strong> — bahkan untuk membuat orang tertawa. Perhatikan bahwa lelucon anak unta itu tetap sepenuhnya benar secara faktual; itulah bentuk humor yang beliau pakai.<br><br>Dan tidak ada satu pun riwayat sahih di mana beliau melucu dengan merendahkan fisik, kemiskinan, atau kekurangan seseorang.'},
{j:'hub'},

{k:'ras', n:'Abu Dzar, salah satu sahabat paling awal dan paling zuhud, pernah bertengkar dengan Bilal dan menyebutnya “anak perempuan hitam”.'},
{sb:'أَعَيَّرْتَهُ بِأُمِّهِ؟ إِنَّكَ امْرُؤٌ فِيكَ جَاهِلِيَّةٌ',
 m:'“Engkau menghinanya dengan menyebut ibunya? Sesungguhnya engkau orang yang di dalam dirimu masih ada sifat jahiliyah.”',
 s:'HR. Al-Bukhari no. 30; Muslim no. 1661', g:'shahih'},
{n:'Abu Dzar meletakkan pipinya di tanah dan bersumpah tidak akan mengangkatnya sampai Bilal menginjaknya. Ia sahabat senior; yang ia hina bekas budak.'},
{c:'Rasisme disebut “jahiliyah” — bukan kekhilafan kecil',
 x:'Kata yang dipakai bukan “kurang sopan” atau “kurang bijak”. Kata yang dipakai adalah <em>jahiliyah</em> — istilah yang dipakai untuk menyebut seluruh sistem lama yang dibongkar Islam.<br><br>Dan yang ditegur bukan orang biasa, melainkan salah satu dari lima orang pertama yang masuk Islam.'},
{n:'Dalam hal keadilan hukum, prinsipnya diucapkan dengan menyebut nama putrinya sendiri, ketika sebagian orang meminta keringanan hukuman bagi seorang perempuan bangsawan yang mencuri.'},
{sb:'إِنَّمَا أَهْلَكَ الَّذِينَ قَبْلَكُمْ أَنَّهُمْ كَانُوا إِذَا سَرَقَ فِيهِمُ الشَّرِيفُ تَرَكُوهُ، وَإِذَا سَرَقَ فِيهِمُ الضَّعِيفُ أَقَامُوا عَلَيْهِ الْحَدَّ. وَايْمُ اللَّهِ، لَوْ أَنَّ فَاطِمَةَ بِنْتَ مُحَمَّدٍ سَرَقَتْ لَقَطَعْتُ يَدَهَا',
 m:'“Sesungguhnya yang membinasakan umat-umat sebelum kalian adalah: apabila orang terhormat di antara mereka mencuri, mereka membiarkannya; dan apabila orang lemah yang mencuri, mereka menegakkan hukuman atasnya. Demi Allah, seandainya Fatimah binti Muhammad mencuri, sungguh aku akan memotong tangannya.”',
 s:'HR. Al-Bukhari no. 3475; Muslim no. 1688', g:'shahih'},
{c:'Diagnosis tentang mengapa peradaban runtuh',
 x:'Bagian pertama hadis ini jauh lebih sering dilewati daripada bagian kedua yang dramatis. Padahal di situlah analisisnya: umat terdahulu binasa bukan karena kurang ibadah — melainkan karena <strong>hukum berlaku berbeda bagi yang kuat dan yang lemah</strong>.'},
{j:'hub'},

{k:'batas', n:'Beliau melihat penduduk Madinah melakukan penyerbukan silang pada pohon kurma, lalu memberi pendapat bahwa mungkin itu tidak perlu. Mereka mengikutinya, dan panen tahun itu buruk.'},
{sb:'إِنَّمَا أَنَا بَشَرٌ، إِذَا أَمَرْتُكُمْ بِشَيْءٍ مِنْ دِينِكُمْ فَخُذُوا بِهِ، وَإِذَا أَمَرْتُكُمْ بِشَيْءٍ مِنْ رَأْيِي فَإِنَّمَا أَنَا بَشَرٌ ... أَنْتُمْ أَعْلَمُ بِأَمْرِ دُنْيَاكُمْ',
 m:'“Sesungguhnya aku hanyalah manusia. Apabila aku memerintahkan sesuatu tentang agama kalian, ambillah. Dan apabila aku memerintahkan sesuatu berdasarkan pendapatku, maka aku hanyalah manusia... Kalian lebih tahu tentang urusan dunia kalian.”',
 s:'HR. Muslim no. 2362-2363', g:'shahih'},
{c:'Nabi mengakui bahwa ia bisa keliru soal teknis',
 x:'Ini hadis yang sangat besar konsekuensinya, dan sangat jarang dibahas utuh. Beliau <strong>menarik pendapatnya sendiri</strong> dan menyerahkan urusan teknis kepada ahlinya.<br><br>Konsekuensinya untuk hari ini: otoritas keagamaan tidak otomatis menjadi otoritas pertanian, kedokteran, ekonomi, atau teknik. Batas itu ditarik oleh Nabi sendiri, bukan oleh orang sekuler.'},
{n:'Beliau juga menolak dikultuskan, bahkan dalam bentuk yang paling halus.'},
{sb:'لَا تُطْرُونِي كَمَا أَطْرَتِ النَّصَارَى ابْنَ مَرْيَمَ، فَإِنَّمَا أَنَا عَبْدُهُ، فَقُولُوا: عَبْدُ اللَّهِ وَرَسُولُهُ',
 m:'“Janganlah kalian berlebihan memujiku sebagaimana orang Nasrani berlebihan memuji putra Maryam. Aku hanyalah hamba-Nya. Maka katakanlah: hamba Allah dan rasul-Nya.”',
 s:'HR. Al-Bukhari no. 3445', g:'shahih'},
{n:'Ketika seorang laki-laki gemetar ketakutan saat berbicara dengannya, beliau menenangkannya dengan mengatakan bahwa ia hanyalah anak dari seorang perempuan Quraisy yang biasa makan daging kering.', s:'HR. Ibnu Majah no. 3312', g:'hasan'},
{j:'hub'},

{k:'zuhud', r:'Umar bin Khattab r.a.', x:'Aku masuk menemui Rasulullah ﷺ dan beliau sedang berbaring di atas tikar. Aku duduk, dan kulihat bekas anyaman tikar itu membekas di lambungnya. Aku memandang lemari beliau, dan isinya hanya segenggam gandum, sedikit daun penyamak, dan sehelai kulit tergantung. Air mataku mengalir.',
 s:'HR. Al-Bukhari no. 4913; Muslim no. 1479', g:'shahih'},
{n:'Umar berkata bahwa Kisra dan Kaisar bergelimang kemewahan, sementara beliau yang seorang utusan Allah hidup seperti ini. Beliau bangkit dan menjawab.'},
{sb:'أَمَا تَرْضَى أَنْ تَكُونَ لَهُمُ الدُّنْيَا وَلَنَا الْآخِرَةُ؟',
 m:'“Tidakkah engkau rida jika dunia untuk mereka, dan akhirat untuk kita?”',
 s:'HR. Al-Bukhari no. 4913; Muslim no. 1479', g:'shahih'},
{c:'Kesederhanaan sebagai pilihan, bukan sebagai kemiskinan',
 x:'Penting untuk membedakan keduanya. Beliau punya akses ke seperlima harta rampasan dari seluruh ekspedisi — kekayaan yang sangat besar. Yang terjadi adalah harta itu terus keluar hampir secepat masuknya.<br><br>Riwayat menyebut beliau pernah gelisah semalaman hanya karena teringat ada beberapa dinar di rumahnya yang belum dibagikan (HR. Al-Bukhari no. 1221).<br><br>Ini bukan asketisme yang menolak dunia. Ini penolakan untuk <em>menimbun</em>.'},
{j:'hub'},

{k:'tetangga', sb:'مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ',
 m:'“Jibril terus-menerus berpesan kepadaku tentang tetangga, sampai aku mengira bahwa ia akan menjadikannya ahli waris.”',
 s:'HR. Al-Bukhari no. 6014; Muslim no. 2624', g:'shahih'},
{n:'Perhatikan bahwa hadis ini tidak menyebut agama tetangga. Dan dalam praktiknya, sebagian tetangga beliau di Madinah memang Yahudi.'},
{r:'Anas bin Malik r.a.', x:'Seorang anak Yahudi biasa melayani Nabi ﷺ. Ketika ia sakit, beliau datang menjenguknya dan duduk di sisi kepalanya.',
 s:'HR. Al-Bukhari no. 1356', g:'shahih'},
{n:'Suatu kali sebuah iring-iringan jenazah lewat, dan beliau berdiri menghormatinya. Para sahabat memberi tahu bahwa itu jenazah seorang Yahudi.'},
{sb:'أَلَيْسَتْ نَفْسًا؟',
 m:'“Bukankah ia juga sebuah jiwa?”',
 s:'HR. Al-Bukhari no. 1312; Muslim no. 961', g:'shahih'},
{c:'Tiga kata yang memuat seluruh prinsip',
 x:'<em>Alaisat nafsan?</em> — Bukankah ia juga sebuah jiwa? Sebuah pertanyaan retoris yang dijawab dengan berdiri.<br><br>Yang layak dihormati adalah kemanusiaannya, bukan keanggotaannya dalam kelompok. Kalimat ini diucapkan oleh kepala negara, di ibu kotanya, di masa perang dengan sebagian suku Yahudi yang melanggar perjanjian — dan tetap saja, jenazah seorang Yahudi biasa dihormati.<br><br>Konflik politik tidak diizinkan meluas menjadi penghapusan martabat manusia.'},
{n:'Dan satu lagi, tentang bagaimana beliau memperlakukan orang yang paling menjijikkan sekalipun di mata masyarakat: beliau melarang para sahabat melaknat seorang peminum khamr yang berulang kali dihukum, dan berkata bahwa orang itu mencintai Allah dan Rasul-Nya.', s:'HR. Al-Bukhari no. 6780', g:'shahih'},
{j:'hub'},

{k:'akhir', n:'Kau sudah menyusuri enam puluh tiga tahun, dari lembah tanpa tanaman sampai sebuah kamar kecil di Madinah.'},
{n:'Jika ada satu benang yang mengikat semuanya, mungkin ini: <strong>setiap kali kuasa bertambah di tangannya, ia dipakai untuk melindungi orang yang tidak punya kuasa.</strong> Di Mekah ia tak berdaya dan menolak balas dendam. Di Madinah ia berkuasa dan menulis perlindungan bagi yang berbeda. Di Fathu Makkah ia menang total dan membebaskan semua orang. Di ranjang kematiannya ia menyebut para budak.'},
{n:'Yang kau baca di sini baru permukaannya. Setiap bab punya kitab-kitab tebal di belakangnya — Ar-Rahiq Al-Makhtum, Sirah Ibnu Hisyam, Fiqhus Sirah karya Al-Buthi dan Al-Ghazali, dan tentu saja kitab-kitab hadis induknya.'},
{c:'Cara memakai media ini',
 x:'Semua yang kau baca punya rujukan yang bisa kau cek — dan sebagian sengaja ditandai <em>dhaif</em> agar kau tidak menyebarkannya sebagai sahih. Itu bukan kelemahan; itu caranya bekerja.<br><br>Tombol <strong>Rujukan</strong> mengumpulkan seluruh sumber per bab. Bawalah ke guru atau kitabnya. Media ini hanya pintu — bukan ruangannya.'},
{n:'Semoga perjalanan ini menambah kedekatan, bukan sekadar informasi. Kau bisa kembali ke Peta Waktu kapan saja untuk mengulang bab mana pun.'},
{j:'hub'}
]});
/* ============================================================
   SCENE — WebGL
   Satu-satunya "karakter" di layar adalah kaligrafi مُحَمَّد
   yang tersusun dari ribuan partikel. Tidak ada figur manusia.
   ============================================================ */
const Scene = (function(){

const cv = document.getElementById('gl');
let renderer, cam, scene, bgScene, bgCam;
let stars, dust, glyph, bgMesh;
let W = innerWidth, H = innerHeight;
const IS_SMALL = Math.min(innerWidth, innerHeight) < 700;
const N = IS_SMALL ? 5200 : 10000;
const clock = { t: 0, last: performance.now() };
const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------- suasana per bab ---------- */
const MOODS = {
  0:  {top:'#0a1024', bot:'#05070f', glow:'#22407a', colA:'#C8A03C', colB:'#EBD08A', stars:1.0, turb:0.00, pat:.30, dust:.45, hz:.10},
  1:  {top:'#0b1128', bot:'#05070f', glow:'#1d3a70', colA:'#8FB4E8', colB:'#C8A03C', stars:1.25, turb:0.02, pat:.34, dust:.40, hz:.16},
  2:  {top:'#141326', bot:'#080a14', glow:'#4a3a5e', colA:'#C9A9D8', colB:'#EBD08A', stars:.85, turb:0.03, pat:.22, dust:.55, hz:.26},
  3:  {top:'#161a2a', bot:'#0a0c16', glow:'#5a4a2c', colA:'#E2B25C', colB:'#F0DDB0', stars:.70, turb:0.01, pat:.40, dust:.60, hz:.30},
  4:  {top:'#06070f', bot:'#03040a', glow:'#8a6a1e', colA:'#FFE9AE', colB:'#FFFFFF', stars:.35, turb:0.02, pat:.16, dust:.28, hz:.04},
  5:  {top:'#1a1220', bot:'#0a0710', glow:'#7a2f2a', colA:'#D9705F', colB:'#E8C070', stars:.55, turb:0.09, pat:.20, dust:.85, hz:.22},
  6:  {top:'#12141c', bot:'#070810', glow:'#3a3a44', colA:'#9AA3B2', colB:'#C86A5E', stars:.40, turb:0.14, pat:.10, dust:1.00, hz:.30},
  7:  {top:'#0a1638', bot:'#040814', glow:'#3C6FD0', colA:'#9EC5FF', colB:'#FFF4D0', stars:1.60, turb:0.02, pat:.55, dust:.22, hz:.00, drift:1.7},
  8:  {top:'#0a1024', bot:'#05070f', glow:'#2a4a86', colA:'#A8C8F0', colB:'#EBD08A', stars:1.35, turb:0.05, pat:.24, dust:.55, hz:.20},
  9:  {top:'#0b1a1c', bot:'#050c0e', glow:'#2f7a62', colA:'#6FD0A8', colB:'#EBD08A', stars:.80, turb:0.01, pat:.48, dust:.42, hz:.24},
  10: {top:'#1a1416', bot:'#0a0708', glow:'#7a3a24', colA:'#D98A5C', colB:'#E8D2A0', stars:.60, turb:0.11, pat:.18, dust:.95, hz:.34},
  11: {top:'#1c1608', bot:'#0c0904', glow:'#B08020', colA:'#FFD98A', colB:'#FFFFFF', stars:.55, turb:0.02, pat:.62, dust:.55, hz:.28},
  12: {top:'#0d1220', bot:'#05070e', glow:'#3a5a8a', colA:'#CFE0F5', colB:'#EBD08A', stars:1.05, turb:0.01, pat:.26, dust:.38, hz:.14},
  13: {top:'#101526', bot:'#06080f', glow:'#4a5a3a', colA:'#C8D8A0', colB:'#EBD08A', stars:.95, turb:0.01, pat:.44, dust:.45, hz:.12}
};

/* nilai yang dianimasikan */
const cur = {
  top:new THREE.Color('#0a1024'), bot:new THREE.Color('#05070f'), glow:new THREE.Color('#22407a'),
  colA:new THREE.Color('#C8A03C'), colB:new THREE.Color('#EBD08A'),
  stars:1, turb:0, pat:.3, dust:.5, hz:.1, drift:1
};
const tgt = JSON.parse(JSON.stringify({stars:1,turb:0,pat:.3,dust:.5,hz:.1,drift:1}));
tgt.top=new THREE.Color('#0a1024'); tgt.bot=new THREE.Color('#05070f'); tgt.glow=new THREE.Color('#22407a');
tgt.colA=new THREE.Color('#C8A03C'); tgt.colB=new THREE.Color('#EBD08A');

let morph = 0, morphT = 1;     // 0 = tersebar, 1 = membentuk kata
let rose  = 0, roseT  = 0;     // 0 = kaligrafi, 1 = rozet geometris
let bloom = 0;                 // kilatan sesaat
let pointer = {x:0,y:0,tx:0,ty:0};

/* ===== ENV SCENE — low-poly 3D environment ===== */
let envScene = null, envCam = null;
let envObjects = [];           // meshes cleared per scene change
let envAmbient = null, envDir = null;
let envActive = false;

const CHAPTER_SCENES = [
  'mecca','desert','mecca','cave','mecca',
  'mountains','ascent','migration','madinah',
  'battlefield','mecca','arafah','interior'
];

/* ---- geometry helpers ---- */
function makeFlat(color){ return new THREE.MeshLambertMaterial({color, flatShading:true}); }

function randV(lo,hi){ return lo + Math.random()*(hi-lo); }

function buildTerrain(color, rough, w, segs){
  const g = new THREE.PlaneGeometry(w||200, w||200, segs||22, segs||22);
  const pos = g.attributes.position;
  for(let i=0;i<pos.count;i++){
    pos.setZ(i, pos.getZ(i) + (Math.random()-0.5)*rough);
  }
  g.computeVertexNormals();
  const m = new THREE.Mesh(g, makeFlat(color));
  m.rotation.x = -Math.PI/2;
  m.position.y = -8;
  return m;
}

function buildMountain(x, z, h, color, segs){
  const g = new THREE.ConeGeometry(h*0.55, h, segs||7);
  const pos = g.attributes.position;
  for(let i=0;i<pos.count;i++){
    if(Math.abs(pos.getY(i) - g.parameters.height/2) > 0.5){
      pos.setX(i, pos.getX(i)+(Math.random()-0.5)*h*0.18);
      pos.setZ(i, pos.getZ(i)+(Math.random()-0.5)*h*0.18);
    }
  }
  g.computeVertexNormals();
  const m = new THREE.Mesh(g, makeFlat(color));
  m.position.set(x, h/2-8, z);
  return m;
}

function buildKaabah(px, py, pz){
  const g = new THREE.Group();
  const body = new THREE.Mesh(new THREE.BoxGeometry(10,14,10), makeFlat(0x0E0A06));
  g.add(body);
  const band = new THREE.Mesh(new THREE.BoxGeometry(10.3,2.2,10.3), makeFlat(0xC8A03C));
  band.position.y = 2.5;
  g.add(band);
  const door = new THREE.Mesh(new THREE.BoxGeometry(2,4,0.3), makeFlat(0xC8A03C));
  door.position.set(0,-2,5.2);
  g.add(door);
  g.position.set(px||0, (py||0)-1, pz||-22);
  return g;
}

function buildSkyDome(zenith, horizon){
  const g = new THREE.SphereGeometry(280, 18, 9);
  g.scale(-1,1,1);
  const mat = new THREE.ShaderMaterial({
    vertexShader:`varying vec3 vP; void main(){ vP=position; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }`,
    fragmentShader:`precision mediump float; varying vec3 vP; uniform vec3 uZ,uH;
      void main(){ float t=clamp(normalize(vP).y*.7+.4,0.,1.); gl_FragColor=vec4(mix(uH,uZ,t),1.0); }`,
    uniforms:{ uZ:{value:new THREE.Color(zenith)}, uH:{value:new THREE.Color(horizon)} },
    side:THREE.BackSide, depthWrite:false
  });
  return new THREE.Mesh(g, mat);
}

function buildPalm(x,z){
  const g = new THREE.Group();
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.35,0.5,9,6), makeFlat(0x5A4020));
  trunk.position.set(x,-3.5,z);
  g.add(trunk);
  const top = new THREE.Mesh(new THREE.ConeGeometry(3.5,6,8), makeFlat(0x2E4E18));
  top.position.set(x,3,z);
  g.add(top);
  return g;
}

function buildBox(x,y,z,w,h,d,color){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), makeFlat(color));
  m.position.set(x,y,z);
  return m;
}

/* ---- scene builders ---- */
const SCENE_BUILDERS = {
  mecca(es, al, dl){
    al.color.set(0x302010); al.intensity=0.6;
    dl.color.set(0xFFDDA0); dl.intensity=0.8; dl.position.set(30,20,-10);
    es.fog = new THREE.Fog(0xC4A070, 80, 240);
    es.add(buildSkyDome('#0D1428','#5A3018'));
    es.add(buildTerrain(0xB8A870, 0.7));
    es.add(buildKaabah(0,-1,-22));
    [[-60,-80,28],[28,-70,22],[-28,-100,35],[10,-120,42]].forEach(([x,z,h])=>es.add(buildMountain(x,z,h,0x8A7050)));
    for(let i=0;i<14;i++) es.add(buildBox(randV(-50,50),-7.5,randV(-15,-70),randV(1.5,4),randV(1,3),randV(1.5,4),0x9A8860));
  },
  desert(es,al,dl){
    al.color.set(0x504030); al.intensity=0.6;
    dl.color.set(0xFFE0A0); dl.intensity=0.8; dl.position.set(0,40,20);
    es.fog = new THREE.Fog(0xD0B880, 100, 320);
    es.add(buildSkyDome('#2A3A50','#7A5030'));
    es.add(buildTerrain(0xC4AC78, 0.4));
    [[-70,-90,20],[60,-80,18]].forEach(([x,z,h])=>es.add(buildMountain(x,z,h,0xA08860,6)));
    for(let i=0;i<8;i++) es.add(buildBox(randV(-60,60),-7.5,randV(-20,-80),randV(1,2.5),randV(0.5,1.5),randV(1,2.5),0xB0906A));
  },
  cave(es,al,dl){
    al.color.set(0x050308); al.intensity=0.35;
    dl.color.set(0xC8A03C); dl.intensity=0.5; dl.position.set(8,18,5);
    es.fog = new THREE.Fog(0x050308, 12, 60);
    es.add(buildSkyDome('#020406','#0A0810'));
    const wc=0x1A1410;
    [[-8,-5,-8,14,22,6],[8,-5,-8,14,22,6],[-5,-5,-18,22,18,8],[0,-5,-24,18,14,6]].forEach(([x,y,z,w,h,d])=>es.add(buildBox(x,y,z,w,h,d,wc)));
    es.add(buildBox(0,-9,-12,14,1,16,0x2A2018));
    const spot = new THREE.PointLight(0xC8A03C, 0.8, 30);
    spot.position.set(3,2,2); es.add(spot);
    for(let i=0;i<20;i++){
      const pl=new THREE.PointLight(0xFFEE88,randV(0.05,0.15),8);
      pl.position.set(randV(-25,25),-6+Math.random()*4,-50-Math.random()*30);
      es.add(pl);
    }
  },
  mountains(es,al,dl){
    al.color.set(0x202835); al.intensity=0.45;
    dl.color.set(0xFFC080); dl.intensity=0.7; dl.position.set(-40,15,10);
    es.fog = new THREE.Fog(0xB0987A, 50, 180);
    es.add(buildSkyDome('#1A2A4A','#6A4020'));
    es.add(buildTerrain(0x907858, 1.2));
    [[-35,-40,40],[-10,-55,55],[25,-45,48],[-50,-60,35],[40,-70,42],[0,-80,60],[-20,-35,28],[15,-30,22]].forEach(([x,z,h])=>es.add(buildMountain(x,z,h,0x6A5840+Math.floor(Math.random()*0x101010),7)));
  },
  ascent(es,al,dl){
    al.color.set(0x050508); al.intensity=0.25;
    dl.color.set(0x8090D0); dl.intensity=0.4; dl.position.set(0,50,0);
    es.fog = new THREE.Fog(0x020408, 150, 400);
    es.add(buildSkyDome('#020308','#050A18'));
    const floor = buildTerrain(0x0A0C14, 0, 400, 4);
    floor.position.y = -45;
    es.add(floor);
    for(let i=0;i<40;i++){
      const pl=new THREE.PointLight(0xFFEEAA,randV(0.06,0.18),10);
      pl.position.set(randV(-80,80),-42,randV(-100,-200));
      es.add(pl);
    }
    const glow=new THREE.PointLight(0x8FA8D8,0.6,80);
    glow.position.set(0,30,0); es.add(glow);
  },
  migration(es,al,dl){
    al.color.set(0x181424); al.intensity=0.3;
    dl.color.set(0xC0A060); dl.intensity=0.45; dl.position.set(-20,10,30);
    es.fog = new THREE.Fog(0x1C2030, 60, 200);
    es.add(buildSkyDome('#040810','#2A3828'));
    es.add(buildTerrain(0x8A7860, 0.6));
    [[-60,-30,25],[-45,-50,20]].forEach(([x,z,h])=>es.add(buildMountain(x,z,h,0x706050,6)));
    es.add(buildPalm(40,-50)); es.add(buildPalm(55,-40));
    for(let i=0;i<6;i++) es.add(buildBox(randV(-40,30),-7.5,randV(-20,-70),randV(1,3),randV(0.5,2),randV(1,3),0x907860));
  },
  madinah(es,al,dl){
    al.color.set(0x607080); al.intensity=0.7;
    dl.color.set(0xFFF0D0); dl.intensity=0.9; dl.position.set(20,50,10);
    es.fog = new THREE.Fog(0xB0C8D0, 100, 300);
    es.add(buildSkyDome('#2A5A8A','#8AB0C0'));
    es.add(buildTerrain(0x6A8450, 0.3));
    [[-20,-30],[-5,-55],[18,-42],[30,-25],[-35,-48],[8,-70],[-15,-65],[25,-60]].forEach(([x,z])=>es.add(buildPalm(x,z)));
    [[0,-7,-60,18,10,14],[20,-7,-70,10,8,10],[-20,-7,-65,12,9,12]].forEach(([x,y,z,w,h,d])=>es.add(buildBox(x,y,z,w,h,d,0xC8B88A)));
    const dome=new THREE.Mesh(new THREE.SphereGeometry(4,8,5,0,Math.PI*2,0,Math.PI/2),makeFlat(0xD0C890));
    dome.position.set(-5,5,-58); es.add(dome);
  },
  battlefield(es,al,dl){
    al.color.set(0x3A3020); al.intensity=0.45;
    dl.color.set(0xFFC060); dl.intensity=1.0; dl.position.set(50,15,-30);
    es.fog = new THREE.Fog(0xC0A860, 70, 220);
    es.add(buildSkyDome('#2A3A4A','#8A6030'));
    es.add(buildTerrain(0xB0A080, 0.5));
    for(let i=0;i<16;i++) es.add(buildBox(randV(-80,80),-7.5,randV(-10,-100),randV(1.5,5),randV(0.8,2.5),randV(1.5,5),0x908060));
    [[-60,-60,18],[50,-70,22]].forEach(([x,z,h])=>es.add(buildMountain(x,z,h,0x7A6848,6)));
  },
  arafah(es,al,dl){
    al.color.set(0x506070); al.intensity=0.7;
    dl.color.set(0xFFF0E0); dl.intensity=1.0; dl.position.set(0,60,30);
    es.fog = new THREE.Fog(0xB0C0C8, 120, 380);
    es.add(buildSkyDome('#1A3A5A','#8AA0C0'));
    es.add(buildTerrain(0xB8B090, 0.2));
    es.add(buildMountain(0,-60,28,0x8A8060,9));
    for(let i=0;i<120;i++) es.add(buildBox(randV(-70,70),-7.2,randV(-15,-90),0.4,0.8,0.4,0xE0D0B0));
  },
  interior(es,al,dl){
    al.color.set(0x201808); al.intensity=0.35;
    dl.color.set(0xC08020); dl.intensity=0.0;
    es.fog = new THREE.Fog(0x100C06, 8, 30);
    es.add(buildSkyDome('#060402','#0C0804'));
    const wc=0x9A8A60, fc=0x7A6040;
    es.add(buildBox(0,-8.5,0,12,0.5,10,fc));
    es.add(buildBox(-6,-4,0,0.5,9,10,wc));
    es.add(buildBox(6,-4,0,0.5,9,10,wc));
    es.add(buildBox(0,-4,-5,12,9,0.5,wc));
    es.add(buildBox(0,-0.5,0,12,0.4,10,0x6A5030));
    es.add(buildBox(0,-8.1,0,8,0.12,6,0x4A3820));
    const lamp=new THREE.PointLight(0xC08020,0.5,14);
    lamp.position.set(2,-6,-2); es.add(lamp);
  }
};

function buildEnvScene(sceneId){
  if(envScene){
    envObjects.forEach(o=>envScene.remove(o));
    envObjects=[];
  } else {
    envScene = new THREE.Scene();
    envAmbient = new THREE.AmbientLight(0x302010, 0.6);
    envDir = new THREE.DirectionalLight(0xFFDDA0, 0.8);
    envDir.position.set(30,20,-10);
    envCam = new THREE.PerspectiveCamera(52, W/H, 0.1, 600);
    envCam.position.set(0, 2, 18);
  }
  envScene.add(envAmbient);
  envScene.add(envDir);
  envObjects.push(envAmbient, envDir);

  const builder = SCENE_BUILDERS[sceneId];
  if(builder){
    builder(envScene, envAmbient, envDir);
    envScene.children.forEach(c=>{ if(!envObjects.includes(c)) envObjects.push(c); });
  }

  if(bgMesh) bgMesh.material.uniforms.uBgAlpha.value = 0.68;
  envActive = true;
}
/* ===== END ENV SCENE ===== */

/* ---------- shader ---------- */
const BG_V = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy,0.0,1.0); }`;
const BG_F = `
precision mediump float;
varying vec2 vUv;
uniform vec3 uTop,uBot,uGlow;
uniform float uTime,uPat,uAsp,uHz,uBgAlpha;
void main(){
  vec3 col = mix(uBot, uTop, pow(vUv.y, 0.85));
  vec2 q = vUv - vec2(0.5,0.55); q.x *= uAsp;
  float r = length(q);
  col += uGlow * exp(-r*2.6) * 0.55;
  float a = atan(q.y,q.x);
  float petal = cos(a*8.0)*0.5+0.5;
  float ring = sin(r*44.0 - uTime*0.12 + petal*2.4);
  float pat = smoothstep(0.86,1.0,ring) * smoothstep(0.70,0.14,r) * smoothstep(0.02,0.13,r);
  float ring2 = sin(r*17.0 + uTime*0.06 - petal*3.1);
  pat += smoothstep(0.92,1.0,ring2) * smoothstep(0.78,0.20,r) * 0.7;
  col += uGlow * pat * uPat * 0.85;
  float hz = smoothstep(0.30,0.16,vUv.y);
  col = mix(col, uBot*0.35, hz*uHz);
  float hl = exp(-abs(vUv.y-0.20)*70.0);
  col += uGlow*hl*uHz*0.5;
  gl_FragColor = vec4(col, uBgAlpha);
}`;

const GL_V = `
attribute vec3 aTarget, aScatter, aRose;
attribute float aRand;
uniform float uTime,uMorph,uRose,uSize,uTurb,uPix,uBloom;
varying float vR;
void main(){
  vec3 p = mix(aScatter, aTarget, uMorph);
  p = mix(p, aRose, uRose);
  float t = uTime + aRand*6.2831;
  float amp = 0.055 + uTurb*1.15;
  p.x += sin(t*0.72 + p.y*0.42)*amp;
  p.y += cos(t*0.58 + p.x*0.36)*amp*0.9;
  p.z += sin(t*0.41 + aRand*11.0)*(0.55 + uTurb*2.2);
  p *= 1.0 + uBloom*0.09;
  vec4 mv = modelViewMatrix * vec4(p,1.0);
  gl_Position = projectionMatrix * mv;
  gl_PointSize = uSize*(0.55 + aRand*0.85)*(260.0/max(-mv.z,1.0))*uPix*(1.0+uBloom*0.7);
  vR = aRand;
}`;

const GL_F = `
precision mediump float;
uniform vec3 uColA,uColB;
uniform float uOpacity,uTime,uBloom;
varying float vR;
void main(){
  vec2 d = gl_PointCoord - 0.5;
  float r = dot(d,d);
  if(r > 0.25) discard;
  float a = pow(1.0 - r*4.0, 2.1);
  float tw = 0.62 + 0.38*sin(uTime*1.7 + vR*37.0);
  vec3 c = mix(uColA, uColB, vR);
  c += vec3(uBloom*0.5);
  gl_FragColor = vec4(c, a*uOpacity*tw);
}`;

const ST_V = `
attribute float aR;
uniform float uTime,uPix,uAmt;
varying float vA;
void main(){
  vec4 mv = modelViewMatrix*vec4(position,1.0);
  gl_Position = projectionMatrix*mv;
  float tw = 0.35+0.65*sin(uTime*0.7 + aR*54.0);
  vA = tw*uAmt;
  gl_PointSize = (0.7+aR*2.1)*uPix*(300.0/max(-mv.z,1.0));
}`;
const ST_F = `
precision mediump float; varying float vA;
uniform vec3 uCol;
void main(){
  vec2 d=gl_PointCoord-0.5; float r=dot(d,d);
  if(r>0.25) discard;
  gl_FragColor = vec4(uCol, pow(1.0-r*4.0,2.0)*vA*0.9);
}`;

/* ---------- pengambilan bentuk kaligrafi ---------- */
function sampleWord(word, fontStack){
  const w = 1024, h = 384;
  const c = document.createElement('canvas'); c.width=w; c.height=h;
  const x = c.getContext('2d', {willReadFrequently:true});
  x.fillStyle='#000'; x.fillRect(0,0,w,h);
  x.fillStyle='#fff'; x.textAlign='center'; x.textBaseline='middle';
  try{ x.direction='rtl'; }catch(e){}
  x.font = '210px ' + fontStack;
  x.fillText(word, w/2, h/2 + 12);
  let d;
  try{ d = x.getImageData(0,0,w,h).data; }catch(e){ return null; }
  const pts=[]; const step=2;
  for(let y=0;y<h;y+=step) for(let px=0;px<w;px+=step){
    if(d[(y*w+px)*4] > 118) pts.push([px/w - 0.5, 0.5 - y/h]);
  }
  return pts.length > 400 ? pts : null;
}

/* cadangan: rozet 8 lipat bila font Arab gagal dimuat */
function fallbackShape(){
  const pts=[];
  for(let i=0;i<3000;i++){
    const a = Math.random()*Math.PI*2;
    const k = 0.5 + 0.5*Math.cos(a*8);
    const r = (0.16 + 0.20*k) * (0.85 + Math.random()*0.18);
    pts.push([Math.cos(a)*r*1.9, Math.sin(a)*r]);
  }
  return pts;
}

function rosettePoint(i, n){
  const a = (i/n)*Math.PI*2*7.0;
  const k = 0.5 + 0.5*Math.cos(a*8.0);
  const r = 5.0 + 5.5*k + (i%17)/17*1.4;
  return [Math.cos(a)*r*1.35, Math.sin(a)*r*0.78, (Math.random()-0.5)*3];
}

/* ---------- init ---------- */
function init(){
  renderer = new THREE.WebGLRenderer({canvas:cv, antialias:!IS_SMALL, alpha:false, powerPreference:'high-performance'});
  renderer.setPixelRatio(Math.min(devicePixelRatio||1, IS_SMALL?1.6:2));
  renderer.setSize(W,H,false);
  renderer.autoClear = false;

  bgScene = new THREE.Scene();
  bgCam = new THREE.OrthographicCamera(-1,1,1,-1,0,1);
  bgMesh = new THREE.Mesh(new THREE.PlaneGeometry(2,2), new THREE.ShaderMaterial({
    vertexShader:BG_V, fragmentShader:BG_F, depthTest:false, depthWrite:false,
    uniforms:{
      uTop:{value:cur.top.clone()}, uBot:{value:cur.bot.clone()}, uGlow:{value:cur.glow.clone()},
      uTime:{value:0}, uPat:{value:.3}, uAsp:{value:W/H}, uHz:{value:.1}, uBgAlpha:{value:1.0}
    },
    transparent:true
  }));
  bgScene.add(bgMesh);

  scene = new THREE.Scene();
  cam = new THREE.PerspectiveCamera(48, W/H, 0.1, 900);
  cam.position.set(0,0, IS_SMALL ? 34 : 27);

  /* bintang */
  const sn = IS_SMALL ? 900 : 2000;
  const sp = new Float32Array(sn*3), sr = new Float32Array(sn);
  for(let i=0;i<sn;i++){
    const R = 130 + Math.random()*260;
    const th = Math.random()*Math.PI*2, ph = Math.acos(2*Math.random()-1);
    sp[i*3]   = R*Math.sin(ph)*Math.cos(th);
    sp[i*3+1] = R*Math.sin(ph)*Math.sin(th)*0.75;
    sp[i*3+2] = R*Math.cos(ph) - 120;
    sr[i] = Math.random();
  }
  const sg = new THREE.BufferGeometry();
  sg.setAttribute('position', new THREE.BufferAttribute(sp,3));
  sg.setAttribute('aR', new THREE.BufferAttribute(sr,1));
  stars = new THREE.Points(sg, new THREE.ShaderMaterial({
    vertexShader:ST_V, fragmentShader:ST_F, transparent:true, depthWrite:false,
    blending:THREE.AdditiveBlending,
    uniforms:{uTime:{value:0},uPix:{value:renderer.getPixelRatio()},uAmt:{value:1},uCol:{value:new THREE.Color('#dbe6ff')}}
  }));
  scene.add(stars);

  /* debu / pasir */
  const dn = IS_SMALL ? 500 : 1100;
  const dp = new Float32Array(dn*3), dr = new Float32Array(dn);
  for(let i=0;i<dn;i++){
    dp[i*3]   = (Math.random()-0.5)*70;
    dp[i*3+1] = (Math.random()-0.5)*44;
    dp[i*3+2] = Math.random()*30 - 2;
    dr[i] = Math.random();
  }
  const dg = new THREE.BufferGeometry();
  dg.setAttribute('position', new THREE.BufferAttribute(dp,3));
  dg.setAttribute('aR', new THREE.BufferAttribute(dr,1));
  dust = new THREE.Points(dg, new THREE.ShaderMaterial({
    vertexShader:ST_V, fragmentShader:ST_F, transparent:true, depthWrite:false,
    blending:THREE.AdditiveBlending,
    uniforms:{uTime:{value:0},uPix:{value:renderer.getPixelRatio()},uAmt:{value:.5},uCol:{value:new THREE.Color('#e8d9b4')}}
  }));
  scene.add(dust);

  buildGlyph();
  addEventListener('resize', resize);
  addEventListener('pointermove', e=>{
    pointer.tx = (e.clientX/W - .5)*2; pointer.ty = (e.clientY/H - .5)*2;
  }, {passive:true});
  loop();
}

function buildGlyph(){
  let pts = sampleWord('مُحَمَّد', '"Amiri","Traditional Arabic","Scheherazade New","Noto Naskh Arabic","Geeza Pro",serif');
  if(!pts) pts = fallbackShape();

  const SX = IS_SMALL ? 30 : 34, SY = IS_SMALL ? 30 : 34;
  const pos = new Float32Array(N*3), tar = new Float32Array(N*3),
        sca = new Float32Array(N*3), ros = new Float32Array(N*3), rnd = new Float32Array(N);

  for(let i=0;i<N;i++){
    const p = pts[(Math.random()*pts.length)|0];
    const jx = (Math.random()-0.5)*0.010, jy = (Math.random()-0.5)*0.010;
    tar[i*3]   = (p[0]+jx)*SX;
    tar[i*3+1] = (p[1]+jy)*SY*0.62;
    tar[i*3+2] = (Math.random()-0.5)*1.7;

    const R = 16 + Math.random()*40, a = Math.random()*Math.PI*2, b = Math.acos(2*Math.random()-1);
    sca[i*3]   = R*Math.sin(b)*Math.cos(a)*1.3;
    sca[i*3+1] = R*Math.sin(b)*Math.sin(a)*0.85;
    sca[i*3+2] = R*Math.cos(b)*0.5 - 10;

    const rp = rosettePoint(i,N);
    ros[i*3]=rp[0]; ros[i*3+1]=rp[1]; ros[i*3+2]=rp[2];

    pos[i*3]=sca[i*3]; pos[i*3+1]=sca[i*3+1]; pos[i*3+2]=sca[i*3+2];
    rnd[i]=Math.random();
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(pos,3));
  g.setAttribute('aTarget', new THREE.BufferAttribute(tar,3));
  g.setAttribute('aScatter', new THREE.BufferAttribute(sca,3));
  g.setAttribute('aRose', new THREE.BufferAttribute(ros,3));
  g.setAttribute('aRand', new THREE.BufferAttribute(rnd,1));

  glyph = new THREE.Points(g, new THREE.ShaderMaterial({
    vertexShader:GL_V, fragmentShader:GL_F, transparent:true, depthWrite:false,
    blending:THREE.AdditiveBlending,
    uniforms:{
      uTime:{value:0}, uMorph:{value:0}, uRose:{value:0}, uSize:{value:IS_SMALL?2.5:2.2},
      uTurb:{value:0}, uPix:{value:renderer.getPixelRatio()}, uBloom:{value:0},
      uColA:{value:cur.colA.clone()}, uColB:{value:cur.colB.clone()}, uOpacity:{value:0.9}
    }
  }));
  scene.add(glyph);
}

function resize(){
  W=innerWidth; H=innerHeight;
  renderer.setSize(W,H,false);
  cam.aspect=W/H; cam.updateProjectionMatrix();
  if(envCam){ envCam.aspect=W/H; envCam.updateProjectionMatrix(); }
  bgMesh.material.uniforms.uAsp.value = W/H;
}

function loop(){
  requestAnimationFrame(loop);
  const now = performance.now();
  const dt = Math.min((now-clock.last)/1000, .05); clock.last = now;
  clock.t += dt;
  const t = clock.t;
  const k = 1 - Math.pow(0.001, dt);   // faktor lerp stabil

  cur.top.lerp(tgt.top,k); cur.bot.lerp(tgt.bot,k); cur.glow.lerp(tgt.glow,k);
  cur.colA.lerp(tgt.colA,k); cur.colB.lerp(tgt.colB,k);
  ['stars','turb','pat','dust','hz','drift'].forEach(p => cur[p] += (tgt[p]-cur[p])*k);
  morph += (morphT - morph) * (1 - Math.pow(0.004, dt));
  rose  += (roseT  - rose ) * (1 - Math.pow(0.02,  dt));
  bloom += (0 - bloom) * (1 - Math.pow(0.02, dt));

  const bu = bgMesh.material.uniforms;
  bu.uTop.value.copy(cur.top); bu.uBot.value.copy(cur.bot); bu.uGlow.value.copy(cur.glow);
  bu.uTime.value = t; bu.uPat.value = cur.pat; bu.uHz.value = cur.hz;

  const gu = glyph.material.uniforms;
  gu.uTime.value = t; gu.uMorph.value = morph; gu.uRose.value = rose;
  gu.uTurb.value = cur.turb; gu.uBloom.value = bloom;
  gu.uColA.value.copy(cur.colA); gu.uColB.value.copy(cur.colB);

  stars.material.uniforms.uTime.value = t;
  stars.material.uniforms.uAmt.value = cur.stars;
  stars.rotation.y = t * 0.008 * cur.drift;
  stars.rotation.x = Math.sin(t*0.03)*0.05;

  dust.material.uniforms.uTime.value = t;
  dust.material.uniforms.uAmt.value = cur.dust;
  dust.rotation.z = t * 0.012;
  dust.position.x = Math.sin(t*0.09)*2.4;

  if(!RM){
    pointer.x += (pointer.tx - pointer.x)*0.045;
    pointer.y += (pointer.ty - pointer.y)*0.045;
  }
  cam.position.x = pointer.x*1.9 + Math.sin(t*0.16)*0.7;
  cam.position.y = -pointer.y*1.2 + Math.cos(t*0.13)*0.5 + 1.2;
  cam.lookAt(0, 0.6, 0);

  renderer.clear();
  if(envActive && envScene && envCam){
    envCam.position.x = Math.sin(t*0.04)*1.8 + pointer.x*0.6;
    envCam.position.y = 2 + Math.cos(t*0.03)*0.5 - pointer.y*0.4;
    envCam.lookAt(0, 0, -20);
    renderer.render(envScene, envCam);
  }
  renderer.render(bgScene, bgCam);
  renderer.render(scene, cam);
}

/* ---------- API publik ---------- */
return {
  start(){
    if(document.fonts && document.fonts.ready){
      document.fonts.ready.then(()=>{ init(); setTimeout(()=>{ morphT = 1; }, 260); });
    } else { init(); morphT = 1; }
  },
  setScene(chapterIndex){
    const id = CHAPTER_SCENES[chapterIndex] || 'mecca';
    if(!renderer){ setTimeout(()=>this.setScene(chapterIndex), 400); return; }
    buildEnvScene(id);
  },
  mood(id){
    const m = MOODS[id] || MOODS[0];
    tgt.top.set(m.top); tgt.bot.set(m.bot); tgt.glow.set(m.glow);
    tgt.colA.set(m.colA); tgt.colB.set(m.colB);
    tgt.stars=m.stars; tgt.turb=m.turb; tgt.pat=m.pat; tgt.dust=m.dust; tgt.hz=m.hz;
    tgt.drift = m.drift || 1;
  },
  /* kaligrafi buyar lalu terbentuk lagi — dipakai saat ganti bab */
  reform(){ morphT = 0; setTimeout(()=>{ morphT = 1; }, 620); },
  /* saat ayat dibacakan: partikel mekar jadi rozet iluminasi */
  rosette(on){ roseT = on ? 1 : 0; },
  pulse(v){ bloom = Math.max(bloom, v===undefined?0.85:v); },
  /* guncangan halus untuk bab-bab berat */
  strain(v){ tgt.turb = v; }
};
})();
/* ============ i18n ============ */
const I18N = {
  id:{
    lang:'ID',
    introTitle:'Cahaya di Atas Cahaya',
    introTag:'Sirah · dengan aparatus sumbernya',
    introLede1:'Menyusuri hidup Rasulullah ﷺ dari Tahun Gajah hingga wafat — bukan sebagai dongeng heroik, melainkan sebagai rekaman keputusan seorang manusia yang setiap langkahnya bisa dilacak sumbernya.',
    introLede2:'Setiap layar membawa rujukannya sendiri: surah, riwayat, derajat sanad. Termasuk hal-hal yang jarang naik mimbar.',
    introStart:'Mulai Perjalanan',
    introFoot:'Sosok beliau tidak digambarkan. Yang Anda lihat di layar adalah kaligrafi nama beliau yang tersusun dari partikel cahaya — dan Anda menjalaninya sebagai seorang penziarah waktu, bukan sebagai beliau.',
    btnBack:'Kembali', btnMap:'Peta Waktu', btnRef:'Rujukan',
