/* English chapter metadata (titles / years / blurbs) */
const CH_META_EN = [
  {title:'Before the Dawn',    years:'c. 570 CE · Year of the Elephant',   blurb:'A valley without a river, the ancient house of Ibrāhīm, and a society that was noble and brutal at the same time.'},
  {title:'Orphan in the Desert', years:'570–582 CE',                        blurb:'Losing father, mother, and grandfather before age eight. Then years of herding sheep for wages.'},
  {title:'Al-Amīn',            years:'c. 595–610 CE',                       blurb:'A reputation built before any claim. A pact to defend the oppressed. And a clever solution that averted civil war.'},
  {title:'Read!',              years:'610 CE · Ramaḍān',                    blurb:'The first revelation, honest fear, and a woman who assessed prophethood by social record.'},
  {title:'The First Oppressed', years:'613–619 CE',                         blurb:'Open preaching, and a pattern repeated through history: those struck first are always the most powerless.'},
  {title:'Year of Grief',      years:"619–620 CE · ʿĀmul Ḥuzn",           blurb:"Loss of protector and support in one year. Then Ṭā'if — and an offer of revenge that was refused."},
  {title:'The Night Journey',  years:'c. 620–621 CE',                       blurb:'The most difficult event to explain in the Sīrah — and the ethical mandate it brought back to earth.'},
  {title:'The Migration',      years:'621–622 CE',                          blurb:'Two pledges, two women who swore the oath, an assassination attempt, and enemy deposits returned in full.'},
  {title:'The Madinah Charter', years:'622–624 CE',                         blurb:'The first thing built was not a fort. And a political document guaranteeing pluralism — rarely read in full.'},
  {title:'War, Defeat, Treaty', years:'624–628 CE',                         blurb:"A consultation that overruled the Prophet's own view, scripture's open correction, and a victory shaped like concession."},
  {title:'When Power Is in Hand', years:'630 CE · Ramaḍān 8 AH',           blurb:'Ten thousand troops enter the city that oppressed them for twenty years. The real test is not endurance — it is victory.'},
  {title:'The Final Sermon',   years:'632 CE · 10–11 AH',                  blurb:"The first usury abolished was his own uncle's. And his last words named the most powerless."},
  {title:'Rarely from the Pulpit', years:'Thematic · cross-timeline',       blurb:'Eight themes outside the chronology: home, animals, children, humor, racism, limits of authority, simplicity, and neighbors.'},
];

let currentLang = localStorage.getItem('sirah:lang') || 'id';
let t = () => I18N[currentLang];

function applyI18n(){
  const T = t();
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k = el.dataset.i18n;
    if(T[k] !== undefined) el.innerHTML = T[k];
  });
  document.documentElement.lang = currentLang;
  const bLang = document.getElementById('bLang');
  if(bLang) bLang.textContent = currentLang.toUpperCase();
}

function toggleLang(){
  currentLang = currentLang === 'id' ? 'en' : 'id';
  localStorage.setItem('sirah:lang', currentLang);
  applyI18n();
  // re-render current node with new lang strings
  if(typeof render === 'function') render();
  if(typeof buildRail === 'function') buildRail();
  if(typeof syncRail === 'function') syncRail();
}

function toggleTheme(){
  const html = document.documentElement;
  const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
  html.dataset.theme = next;
  localStorage.setItem('sirah:theme', next);
  const btn = document.getElementById('bTheme');
  if(btn) btn.textContent = next === 'dark' ? '◑' : '○';
}

/* restore saved theme */
(function(){
  const saved = localStorage.getItem('sirah:theme');
  if(saved) document.documentElement.dataset.theme = saved;
})();

/* ============================================================
   TTS — Web Speech API narasi otomatis
   Membaca terjemahan/makna; melewati teks Arab asli.
   ============================================================ */
const TTS = (function(){
  const synth = window.speechSynthesis;
  if (!synth) return { speak(){}, toggle(){return false;}, stop(){}, isEnabled(){return false;}, updateBtn(){} };

  let enabled = localStorage.getItem('sirah:tts') === '1';
  let voices = [];

  function loadVoices(){
    voices = synth.getVoices();
  }
  loadVoices();
  if (synth.onvoiceschanged !== undefined) synth.onvoiceschanged = loadVoices;

  function pickVoice(){
    return voices.find(v => v.lang === 'id-ID') ||
           voices.find(v => v.lang.startsWith('id')) ||
           voices.find(v => v.lang.startsWith('ms')) ||
           voices[0] || null;
  }

  function stripHTML(s){
    const d = document.createElement('div');
    d.innerHTML = String(s);
    return (d.textContent || d.innerText || '')
      .replace(/ﷺ/g, ', sallallahu alaihi wasallam,')
      .replace(/[^\S\n]+/g, ' ')
      .trim();
  }

  function getReadable(n, nt){
    const f = k => (nt && nt[k] !== undefined ? nt[k] : n[k]);
    if (n.j !== undefined) return null;
    if (n.n !== undefined) return stripHTML(f('n'));
    if (n.a !== undefined) return stripHTML(f('a'));
    if (n.r !== undefined) return stripHTML(f('x'));
    if (n.sb !== undefined) return stripHTML(f('m'));
    if (n.ay !== undefined) return stripHTML(f('m'));
    if (n.c !== undefined)  return stripHTML(f('c')) + '. ' + stripHTML(f('x'));
    if (n.q !== undefined)  return stripHTML(f('q'));
    return null;
  }

  function isChoiceNode(n){ return !!(n.q || n.o); }

  function speak(n, transNode, advanceFn){
    if (!enabled) return;
    synth.cancel();
    const text = getReadable(n, transNode);
    if (!text) {
      if (!isChoiceNode(n) && advanceFn) setTimeout(advanceFn, 300);
      return;
    }
    const utt = new SpeechSynthesisUtterance(text);
    utt.lang  = (currentLang === 'en') ? 'en-US' : 'id-ID';
    utt.voice = pickVoice();
    utt.rate  = 0.88;
    utt.pitch = 1.0;
    utt.volume = 1.0;
    utt.onend = () => {
      if (enabled && !isChoiceNode(n) && advanceFn) setTimeout(advanceFn, 700);
    };
    utt.onerror = () => {
      if (enabled && !isChoiceNode(n) && advanceFn) setTimeout(advanceFn, 400);
    };
    synth.speak(utt);
  }

  function stop(){ synth.cancel(); }

  function toggle(){
    enabled = !enabled;
    localStorage.setItem('sirah:tts', enabled ? '1' : '0');
    if (!enabled) synth.cancel();
    updateBtn();
    return enabled;
  }

  function updateBtn(){
    const btn = document.getElementById('bTts');
    if (!btn) return;
    btn.textContent = enabled ? '⏸' : '▶';
    btn.setAttribute('aria-label', enabled ? 'Matikan narasi' : 'Aktifkan narasi');
    btn.title = enabled ? 'Matikan narasi' : 'Aktifkan narasi';
  }

  return { speak, toggle, stop, isEnabled:()=>enabled, updateBtn };
})();

/* ============================================================
   MUSIC — musik latar (loop, on/off, volume default 30%)
   ============================================================ */
const Music = (function(){
  const audio  = document.getElementById('bg-audio');
  const btn    = document.getElementById('bMusic');
  const slider = document.getElementById('musicVol');
  if (!audio) return { toggle(){return false;}, play(){}, pause(){}, arm(){}, isEnabled(){return false;}, updateBtn(){} };

  /* default ON; hormati preferensi tersimpan */
  let enabled = localStorage.getItem('sirah:music') !== '0';
  let vol = parseFloat(localStorage.getItem('sirah:musicVol'));
  if (isNaN(vol)) vol = 0.30;                 // volume default 30%
  vol = Math.max(0, Math.min(1, vol));

  audio.loop = true;
  audio.volume = vol;
  if (slider) slider.value = Math.round(vol * 100);

  function tryPlay(){
    if (!enabled) return;
    const p = audio.play();
    if (p && p.catch) p.catch(()=>{ /* diblokir autoplay — tunggu gestur */ });
  }

  /* mulai pada gestur pengguna pertama bila autoplay diblokir */
  function arm(){
    const kick = ()=>{ if (enabled && audio.paused) tryPlay(); };
    ['pointerdown','keydown','touchstart'].forEach(ev =>
      document.addEventListener(ev, kick, { passive:true }));
  }

  function play(){  enabled = true;  save(); tryPlay();      updateBtn(); }
  function pause(){ enabled = false; save(); audio.pause();  updateBtn(); }
  function toggle(){ enabled ? pause() : play(); return enabled; }

  function setVolume(v){
    vol = Math.max(0, Math.min(1, v));
    audio.volume = vol;
    localStorage.setItem('sirah:musicVol', vol.toFixed(2));
    if (slider) slider.value = Math.round(vol * 100);
    /* geser slider dari nol = anggap ingin mendengar musik */
    if (vol > 0 && !enabled) play();
  }

  function save(){ localStorage.setItem('sirah:music', enabled ? '1' : '0'); }

  function updateBtn(){
    if (!btn) return;
    btn.classList.toggle('off', !enabled);
    const label = enabled ? 'Matikan musik latar' : 'Hidupkan musik latar';
    btn.setAttribute('aria-label', label);
    btn.title = label;
  }

  return { toggle, play, pause, setVolume, isEnabled:()=>enabled, updateBtn, arm };
})();

/* ============================================================
   ENGINE — alur naratif, percabangan, rujukan, navigasi
   ============================================================ */
(function(){
const $ = id => document.getElementById(id);
const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;

const el = {
  rail:$('rail'), kick:$('kick'), ttl:$('ttl'), yrs:$('yrs'),
  plate:$('plate'), sp:$('sp'), spn:$('spn'), body:$('body'),
  refs:$('refs'), choices:$('choices'), hint:$('hint'), prog:$('prog').firstElementChild,
  scroll:$('scroll'),
  map:$('shMap'), ref:$('shRef'), mapList:$('mapList'), refList:$('refList'), refSub:$('refSub'),
  intro:$('intro')
};

let ci = 0, ni = 0, hist = [], seen = {}, progress = {}, choiceLog = {};

/* localStorage bookmark — works in all browsers */
const bookmark = {
  save(){
    try{ localStorage.setItem('sirah:bm', JSON.stringify({progress, choiceLog})); }catch(e){}
  },
  load(){
    try{ const d=localStorage.getItem('sirah:bm'); return d?JSON.parse(d):null; }catch(e){ return null; }
  }
};
/* ── English translations for all CH narrative content ── */
const CH_TRANSLATIONS = { en: [
/* ── CH 1 · Before Dawn ── */
[
{n:'You stand in a valley of black stone where nothing grows. No river. No fields. Only black rocks, an ancient well, and a cube-shaped building of uncemented stone at its center. Its name is Bakkah — what people call Makkah.'},
{a:'Why is there a city in a place that cannot even grow wheat?'},
{n:'Because this city was not built on fertility. It was built on a prayer uttered thousands of years before.'},
{m:'"Our Lord, I have settled some of my descendants in an uncultivated valley near Your sacred House, our Lord, that they may establish prayer."'},
{n:'That house was rebuilt by Ibrahim and Ismail as a place to worship the One God. Forty generations later, three hundred and sixty idols surrounded it. The Ka\'bah still stood; its meaning had crumbled.'},
{m:'"And [remember] when Ibrahim was raising the foundations of the House together with Ismail, [saying]: Our Lord, accept this from us. Indeed, You are the All-Hearing, the All-Knowing."'},
{n:'That year, from the south, came the army of Abrahah from Yemen with war elephants. His goal was to destroy the Ka\'bah so that pilgrims would travel to the cathedral he had built in Sana\'a instead.'},
{m:'"Have you not seen how your Lord dealt with the Companions of the Elephant? Did He not make their scheme go astray? And He sent against them flights of birds."'},
{n:'Abdul Muttalib, guardian of the Ka\'bah, went to Abrahah — not to defend the Ka\'bah, but to reclaim the two hundred camels that had been seized. Abrahah was astonished. He replied: "I am the owner of my camels, and this house has an Owner who will protect it."'},
{q:'Before we continue — what would you like to understand first about this world?', o:['What was Arab society actually like?','Why was the Ka\'bah so central to them?']},
{n:'Historians call this period Jahiliyyah — not meaning they were ignorant. They were memorizers of thousands of verses of poetry, experts in genealogy, navigators by the stars, and traders across continents. What was "jahil" was their value system.'},
{n:'Honor was measured by tribe, not by deeds. The weak had no rights. Usury accumulated until people sold their children. And some of them buried infant daughters alive.'},
{m:'"And when the infant girl who was buried alive is asked — for what sin was she killed?"'},
{n:'Note the structure of the sentence. The one questioned is not the killer — but the victim. In the most just of courts, the first voice is given to those who never had a voice.'},
null,
{n:'The Ka\'bah was the pilgrimage center for all of Arabia. Every tribe kept its idols there, so every tribe had a reason to come — and every visit meant markets, lodging, water, and taxes for the Quraysh.'},
{n:'For this reason, disturbing the idols was not merely a theological matter. It shook the entire economic model of the city. This is important to remember: the resistance to the later mission was not purely about belief, but about who would lose their income.'},
{m:'"For the customary practices of the Quraysh — their custom of making the winter and summer journeys."'},
null,
{c:'Islam did not come to an empty space', x:'Sermons often portray pre-Islamic Arabia as total darkness, then Islam wiped everything away. What actually happened was more complex and more interesting: some of their values were <em>preserved</em> — keeping promises, honoring guests, defending the oppressed, courage. What was dismantled was their structural injustice.'},
{m:'"Indeed, I was sent only to perfect noble character."'},
{n:'"To perfect," not "to begin from scratch." That verb contains an attitude toward culture that will continue to appear throughout this entire journey.'},
{n:'In the house of Abdullah ibn Abdul Muttalib, a woman named Aminah bint Wahb was pregnant. Her husband had gone to trade in Yathrib, fell ill on the way, and died there. The child was born an orphan before he could see the world.'}
],
/* ── CH 2 · Orphan in the Plains ── */
[
{n:'He was born on a Monday in the month of Rabi\' al-Awwal. We know the day not from celebrations, but from his brief answer years later when asked why he fasted on Mondays.'},
{m:'"That is the day I was born, and the day I was sent — or the day revelation came down to me."'},
{n:'Babies of Makkah were entrusted to wet nurses in the countryside, to grow up in clean air and learn pure Arabic. But the wet nurses were reluctant to take an orphan\'s baby — there was no father to pay. Halimah from the Bani Sa\'d tribe took him because there were no other babies left.'},
{a:'So his first opportunity came precisely because nobody else wanted him.'},
{n:'At age six, his mother took him to visit his father\'s grave in Yathrib. On the journey home, Aminah died at Abwa\'. The child witnessed it. At age eight, his grandfather Abdul Muttalib followed. Guardianship passed to his uncle, Abu Talib — the most respected yet most impoverished man of the Bani Hashim clan.'},
{m:'"Did He not find you an orphan and give shelter? And He found you lost and guided you. And He found you poor and made you self-sufficient."'},
{n:'That verse came down much later, as comfort. But its continuation is not comfort — it is a command.'},
{m:'"So as for the orphan, do not oppress him. And as for the petitioner, do not repel him."'},
{c:'A wound transformed into policy, not into identity', x:'The structure of this surah is rarely unpacked at the pulpit: the acknowledgment of blessing is immediately joined with a duty toward those <em>who were once like us</em>. Not "be grateful," but "do not do to them what could have been done to you." The orphan is not asked to forget his wound; he is asked to turn it into a rule.'},
{m:'"I and the one who cares for an orphan will be in Paradise like this" — and he indicated with his index finger and middle finger, spreading them slightly apart.'},
{n:'Notice his gesture: two fingers side by side, yet with a gap between them. Even in his most beautiful promise, he remained precise.'},
{q:'His adolescence is almost never spoken of. What would you like to know?', o:['What work did he do to survive?','How did he escape the corruption of his age?']},
{n:'He herded the camels and sheep of Makkah\'s people for a few qirat in wages. This was a lower-class job — little pay, long hours, and no prestige.'},
{m:'"Allah has not sent a prophet who did not herd sheep." His companions asked, "Even you?" He replied, "Yes. I herded them for a few qirat belonging to the people of Makkah."'},
{c:'He mentioned his wages', x:'The part most often cut from this hadith is <em>"\'ala qararit"</em> — for wages. He did not stop at "I herded sheep," which sounds poetic; he specified that he was a paid laborer. No shame about manual work, and no effort to polish his origins. Before companions who already regarded him as head of state, he still admitted he had once been a hired shepherd.'},
{n:'Herding trained something odd for a future leader: caring for creatures who cannot complain, cannot choose you, and will not thank you. The patience trained there had no audience.'},
null,
{n:'Accounts record that twice he tried to join the nightlife of the young men of Makkah, and twice he fell asleep before he got there. He also refused to join in worshipping idols and never drank wine.'},
{n:'But do not picture him as a recluse. He participated in the Fijar War as a youth — though only gathering arrows for his uncles — and took part in a humanitarian pact we will encounter in the next chapter. He was present in his society; he simply did not dissolve into it.'},
null,
{n:'When he entered his twenties, all of Makkah already had one word to describe him. Not "future prophet." Not "holy man." A word born from commercial transactions: <strong>Al-Amin</strong> — the trustworthy.'}
],
/* ── CH 3 · Al-Amin ── */
[
{n:'Khadijah bint Khuwaylid was the most successful caravan merchant in Makkah. She hired Muhammad to carry her goods to Syria. The report of her servant Maysarah led her to make a decision unusual for a woman of that era: she proposed marriage first.'},
{n:'They married. He was twenty-five years old. As for Khadijah\'s age, accounts differ — forty in the most well-known account, twenty-eight in another cited by Ibn Sa\'d and al-Bayhaqi. We do not know for certain, and need not pretend otherwise.'},
{c:'Twenty-five years old, one wife', x:'During Khadijah\'s lifetime, he married no one else. This is important to place in context: all other marriages occurred <em>after</em> the age of fifty, in Madinah, in political contexts, for the protection of war widows and tribal alliances. The longest and most productive phase of his married life was monogamous — and this is almost never mentioned.'},
{a:'So what made him trusted by the entire city, before he claimed to receive any revelation whatsoever?'},
{n:'Around this time something occurred that I consider one of the most forgotten events in the sirah. A merchant from Zabid came to Makkah, his goods were purchased by a Qurayshi nobleman, and the money was not paid. He had no protecting tribe. By customary law, he had no rights whatsoever.'},
{n:'He climbed Abu Qubays hill and cried out his complaint in verse. Several Qurayshi leaders gathered at the house of Abdullah ibn Jud\'an and swore: as long as the sea washes the land, they would stand with whoever was wronged in Makkah — native or stranger — until rights were restored. It was called <strong>Hilf al-Fudul</strong>.'},
{n:'Muhammad, then around twenty years old and not yet having received any revelation, signed it. Decades later, as a prophet and head of state, he commented on it:'},
{m:'"I once witnessed at the house of Abdullah ibn Jud\'an a pact that I would not trade for red camels. And if I were invited to such a pact in Islam, I would certainly accept."'},
{c:'That pact was made by polytheists', x:'This is a sentence that should shake us. An alliance crafted by idol-worshippers, with no reference to any revelation, was valued by the Prophet ﷺ more than the most precious camels — and he declared he would <em>repeat it in Islam</em>.<br><br>This means: cooperation across beliefs to defend the oppressed is not a compromise of faith — it is part of religion. The measure is not who invites you, but what is being fought for.'},
{q:'Would you like to see one more of his decisions before the revelation?', o:['Yes — the Black Stone incident','What is the connection between this reputation and his mission later?']},
{n:'A flood damaged the Ka\'bah. The Quraysh demolished and rebuilt it collectively — each tribe handled one side. Everything went smoothly until the turn came to replace the Black Stone.'},
{n:'Every tribe demanded that honor. The dispute lasted four days. Bani \'Abd al-Dar prepared a basin of blood and dipped their hands in it — an oath unto death. Makkah stood on the verge of civil war over a piece of stone.'},
{n:'Finally it was agreed: the first man to enter through the Bani Shaybah gate would be the judge. The one who entered was Muhammad. Everyone cried out, "Al-Amin! We accept him."'},
{n:'He called for a cloth, placed the stone in its center, then asked <em>every</em> tribal leader to hold one edge of the cloth and lift it together. Once it had reached the desired height, he himself placed the stone into its position.'},
{c:'A solution that created no losers', x:'The easiest course would have been to appoint the most powerful tribe — and leave resentment in all the others. What he did instead was transform the question of "who has the right" into "how can everyone have the right." This is not a weakening compromise; it is a redesign of the question itself. At Hudaybiyyah, thirty years later, we will see exactly the same pattern of thinking.'},
null,
{n:'Years later, when he climbed Mount Safa and asked all of Quraysh, "If I were to tell you there is a cavalry force behind this hill about to attack you, would you believe me?" — they answered in unison, "Yes. We have never found you to lie."'},
{c:'That title was given by those who would later oppose him', x:'"Al-Amin" was not a title from followers. It was born from commercial transactions, goods held in trust, and dispute resolution — given by people who would later boycott, expel, and fight against him. Even on the night of the migration, the possessions of his enemies were still in his home.<br><br>The order matters: <em>trust was built first, claims of truth came later.</em> Not the other way around.'},
null,
{n:'Approaching the age of forty, he began to spend more time in solitude. He would take provisions to a narrow cave on Jabal Nur, a few kilometers from the city, and stay there for days at a time. The Arabs called it <em>tahannuts</em> — seclusion for contemplation.'},
{n:'The cave was called Hira. Its opening faced the Ka\'bah. And on a night in the month of Ramadan, that silence was broken.'}
],
/* ── CH 4 · Read ── */
[
{n:'\'A\'ishah, may Allah be pleased with her, narrated the beginning. Note that the primary narrator of the most sacred event in Islamic history is a woman, who narrated it from the Prophet himself.'},
{x:'The beginning of the revelation that came to the Messenger of Allah ﷺ was a true dream in sleep. He would not dream but that his dream would come like the brightness of the daybreak. Then he came to love seclusion.'},
{n:'In that cave, Jibril came and said: <em>Iqra\'</em> — Read. He replied, "I cannot read." Jibril embraced him until he was exhausted, then released him and repeated. Three times. At the third, the words changed.'},
{m:'"Read in the name of your Lord who created. He created mankind from a clinging clot. Read, and your Lord is Most Generous — who taught by the pen, taught mankind what they did not know."'},
{c:'The first word of this religion is a command to read', x:'Not "worship," not "believe," not "fight." The first command is to <em>read</em>, and even the instrument is named: <em>the pen</em>. Revealed in the midst of a society that prided itself on oral memorization and looked down on writing.<br><br>And it was given to a man who honestly replied, "I cannot read." The first revelation required no prior ability — it required willingness.'},
{n:'He came down from the mountain trembling violently, returned home, and said to his wife:'},
{m:'"Wrap me, wrap me... I feared for myself."'},
{a:'He was afraid. No triumph, no euphoria. Only a forty-year-old man frightened, asking his wife to wrap him in a blanket.'},
{c:'This account has not been polished', x:'If this story were a fabrication, this scene would be the first thing removed. A religion\'s founder trembling, doubting, and fearing for his own sanity is not a compelling image. Precisely because it remained in the most authentic of books, the honesty of this text carries its own weight.<br><br>And it has a practical implication: a spiritual experience that shakes you does not automatically make you feel great. Sometimes it makes you feel small.'},
{n:'Khadijah did not comfort him with "calm down" or "you must be a prophet." She presented an argument.'},
{m:'"By no means! By Allah, Allah will never disgrace you. You maintain family ties, you bear the burdens of others, you give to those who have nothing, you honor guests, and you help those who suffer calamity." — words of Khadijah, may Allah be pleased with her.'},
{c:'The proof of prophethood Khadijah offered was a social track record', x:'This may be the most brilliant argument in all of the sirah, and it is almost always passed over. Khadijah did not mention a single miracle, dream, or sign from the sky. She named <strong>five deeds, all of them social in dimension</strong>: maintaining kinship, bearing others\' burdens, giving to those who have nothing, honoring guests, helping victims of calamity.<br><br>The logic: Allah will not disgrace someone who lives like this. Moral character was used as epistemic proof. For anyone today who wants to evaluate religious claims, Khadijah\'s method remains relevant — <em>look at how he treats the weak.</em>'},
{n:'Khadijah brought him to her cousin, Waraqah ibn Nawfal — an elderly man who had become a Christian and copied the Gospel in Hebrew. Waraqah recognized the description and called it <em>al-Namus</em>, the bearer of revelation who had once come to Musa.'},
{x:'"If only I were still alive when your people drive you out." He asked, "Will they drive me out?" Waraqah replied, "Yes. No one has ever brought what you have brought without being opposed."'},
{c:'The first validation came from a Christian', x:'The first person outside the family to affirm his prophethood was not a Muslim — none yet existed. He was an elderly Christian who recognized the pattern from previous scriptures. The Quran later framed this connection not as coincidence, but as continuity.'},
{n:'Then the revelation ceased. For months, no word. That period is called <em>fatrat al-wahy</em>, and he experienced deep sorrow.'},
{m:'"Your Lord has not abandoned you, nor has He shown displeasure."'},
{n:'Then the call returned — and this time not to read, but to rise.'},
{m:'"O you who is wrapped in a garment, arise and warn. And your Lord — proclaim His greatness. And your garments — purify. And impurity — shun. And do not grant favor seeking more in return. And for your Lord — be patient."'},
{c:'"Do not give while expecting more in return"', x:'Among those great commands is tucked one clause that sounds trivial: <em>la tamnun tastakthir</em> — do not give and then expect a greater return. In the very earliest stage of revelation, before any detailed act of worship had been prescribed, Allah was already regulating the <strong>motivation</strong> behind generosity.<br><br>This religion begins from within, not from a checklist of rules.'}
],
/* ── CH 5 · The Oppressed First ── */
[
{n:'The first three years proceeded quietly, centered at the house of al-Arqam ibn Abi al-Arqam — a young man from the Bani Makhzum clan, the very clan that would become the harshest enemy. His house was at the foot of Mount Safa: close, but unsuspicious.'},
{n:'Then the command came to go public.'},
{m:'"So proclaim openly what you have been commanded, and turn away from the polytheists."'},
{n:'He climbed Mount Safa and called out to every clan. After they acknowledged that he had never lied, he delivered his warning. Abu Lahab — his own uncle — interrupted with insults and broke up the gathering.'},
{n:'From that point, the persecution began. But notice who was targeted first.'},
{n:'Bilal ibn Rabah, the slave of Umayyah ibn Khalaf, was stretched out on the desert under a great rock on his chest. What came from his mouth was only one word, repeated: <em>Ahad, Ahad.</em>'},
{n:'The Yasir family — Yasir, his wife Sumayyah, and their son \'Ammar — were tortured in the scorching heat. Sumayyah, an elderly woman of slave status, died there. She became the first martyr in Islam.'},
{m:'"Be patient, O family of Yasir. For indeed, your promised place is Paradise."'},
{c:'The Prophet passed by and could not help', x:'This account is rarely presented as it is: he passed by the Yasir family being tortured, and all he could do was speak comfort to them. He had no power, no army, no miracle ready to deploy.<br><br>This matters for anyone who believes truth always comes with the power to save. Sometimes what is available is only the loyalty to accompany.'},
{q:'How did they endure?', o:['Some went seeking asylum','Some stayed and were boycotted']},
{n:'He told some companions to cross to Abyssinia — a Christian kingdom in Africa. His reason, as he himself stated: there is a king there in whose presence no one is wronged.'},
{n:'The Quraysh sent a delegation demanding extradition. The Negus summoned both sides. Ja\'far ibn Abi Talib answered by describing their condition before and after Islam, then recited the opening of Surah Maryam.'},
{m:'"And mention in the Book, Maryam, when she withdrew from her family to a place toward the east."'},
{n:'The Negus drew a line on the ground with a stick and said that the difference between their religions was no wider than that line. The extradition request was refused.'},
{c:'The first asylum for Muslims was given by a Christian state', x:'This community was first saved not by fellow Muslims, but by a Christian king who refused to hand over refugees. When the Negus died, the Prophet ﷺ prayed over him from afar.<br><br>The Quran records this closeness explicitly — and that verse is rarely recited in full from the pulpit.'},
{m:'"And you will surely find the nearest in affection to the believers those who say, \'We are Christians.\' That is because among them are priests and monks and because they are not arrogant."'},
null,
{n:'Around the seventh year of prophethood, the Quraysh hung a charter on the wall of the Ka\'bah: no one was permitted to marry, trade, or associate with Bani Hashim and Bani Muttalib until they handed over Muhammad.'},
{n:'The entire clan was exiled to the narrow valley of Shi\'b Abi Talib for about three years. This included infants, the elderly, and those who had not yet entered Islam. Accounts record that the cries of hungry children could be heard from outside the valley, and some ate leaves.'},
{c:'Those boycotted were not only Muslims', x:'The boycott was based on <em>clan</em>, not religion. Non-Muslim members of Bani Hashim suffered because of blood solidarity, while some Muslims from other clans were unaffected. One of those who broke the boycott was also a polytheist — Hisham ibn \'Amr and several companions, who felt it had gone too far.<br><br>The line between "us" and "them" at that time was far messier than is usually depicted.'},
null,
{n:'Abu Talib protected him until the end of his life without ever declaring the testimony of faith. That protection cost him his entire honor and wealth. When the Prophet begged his uncle to say those words in his final moments, he refused.'},
{m:'"Indeed, you do not guide whom you love. But Allah guides whom He wills."'},
{c:'The limits of a prophet\'s power', x:'This verse was revealed in connection with Abu Talib, according to al-Bukhari no. 4772. Its meaning is stark: <strong>even the Prophet could not place guidance into the heart of the one he loved most.</strong><br><br>If he himself could not, then no one after him has any greater authority. Whoever thinks they have the right to force belief onto another person is claiming a power never given to the Messenger of Allah himself.'}
],
/* ── CH 6 · Year of Sorrow ── */
[
{n:'The boycott ended, but the bodies of the two most important people in his life were already too frail. Within the space of a few months, Abu Talib died, then Khadijah died.'},
{a:'One political shield gone. One spiritual support gone. Twenty-five years of marriage ended.'},
{n:'He named that year <em>\'Am al-Huzn</em> — the Year of Sorrow. And years later, when he had remarried, he still slaughtered sheep and sent the meat to Khadijah\'s friends.'},
{x:'"I have never been jealous of any of the Prophet\'s ﷺ wives as I was jealous of Khadijah, even though I never met her."'},
{c:'Loyalty that did not stop at the grave', x:'Often told as mere romance. But it has an ethical dimension: he maintained the <em>social network</em> of his deceased wife. Those sent the meat were not Khadijah\'s family but her friends. To honor the departed means to care for those she loved.'},
{n:'Without a protector, the pressure in Makkah became impossible. He walked about a hundred kilometers to Ta\'if, the second most important city, hoping to find a listening ear.'},
{n:'The three brothers who led the Bani Thaqif mocked him contemptuously. One said: did Allah find no one else but you to send? Then they unleashed slaves and children to throw stones at him along the road out of the city, until his feet bled.'},
{n:'He sheltered in a vineyard belonging to two brothers from Makkah. The prayer reported to have been spoken there is very famous — though its chain is weak, it is too significant to hide from you.'},
{m:'"O Allah, to You I complain of the weakness of my strength, my scarce resources, and my being humiliated before people... If You are not angry with me, I do not care."'},
{n:'What follows is of sound grade, and actually more decisive.'},
{x:'I asked the Prophet ﷺ whether there was any day harder than the Battle of Uhud. He mentioned the day at Ta\'if — then recounted that Jibril came with the Angel of the Mountains, who offered to bring two mountains down upon the people of that city.'},
{n:'The offer was concrete. The power to destroy the city that had just humiliated him was in his hands. His answer:'},
{m:'"Rather, I hope that Allah will bring forth from their loins people who worship Allah alone, associating nothing with Him."'},
{c:'What was refused was not only revenge — but also the conclusion', x:'He did not say "forgive them." He said: <em>look at the next generation.</em> The people who threw stones at him were not judged as a final verdict on an entire city; they were evaluated as one point in a much longer span of time.<br><br>Twenty years later, Ta\'if embraced Islam. And one of their descendants became a hadith scholar. His hope was vindicated — but the valuable part is that the hope was spoken while he was still bleeding.'},
{m:'"Indeed, I was not sent as a curser. I was sent only as a mercy."'},
{n:'On the journey back, there was a practical problem: without a protector, he could not re-enter his own city. He sent word to several Qurayshi leaders requesting a guarantee of safe conduct. Two refused. One accepted.'},
{n:'His name was Mut\'im ibn \'Adi — a polytheist who never entered Islam. He armed his sons and openly escorted Muhammad into Makkah.'},
{c:'A debt repaid years later', x:'After the Battle of Badr, when Qurayshi prisoners were in his hands, the Prophet ﷺ said that had Mut\'im still been alive and interceded for the prisoners, he would have released all of them (al-Bukhari no. 3139).<br><br>Mut\'im died as a polytheist. His kindness was still acknowledged publicly before the community. Recognition of a good deed was not made conditional on sharing the same belief — and this became one of the most consistent patterns in his life.'},
{n:'The lowest point had been passed. What came next was the night most difficult to explain in the entire sirah.'}
],
/* ── CH 7 · The Night Journey ── */
[
{n:'One night, he was taken from Masjid al-Haram to Bayt al-Maqdis, then ascended beyond the heavens. The Quran describes it in one verse, and its opening is <em>Subhanalladhi</em> — Glorified is He — not "Muhammad traveled."'},
{m:'"Glorified is He who carried His servant by night from Masjid al-Haram to Masjid al-Aqsa, whose surroundings We have blessed, to show him of Our signs."'},
{c:'The title used at the highest moment is "servant"', x:'At the most noble moment ever experienced by a human being, the Quran does not call him <em>His prophet</em>, <em>His beloved</em>, or <em>His messenger</em>. The word used is <strong>بِعَبْدِهِ</strong> — His <em>servant</em>.<br><br>The peak of human honor, in the Quran\'s vocabulary, is full awareness that one is a servant. Not an elevation of status, but clarity about one\'s position.'},
{n:'In Bayt al-Maqdis he led the earlier prophets in prayer. Then he ascended through layer after layer of heaven until Sidratul Muntaha — the boundary no created being can cross.'},
{m:'"His sight did not swerve, nor did it exceed its limit. He had truly seen some of the greatest signs of his Lord."'},
{n:'The obligation of prayer was set at fifty times a day. On the way down, Musa advised him to request a reduction. He returned again and again until it became five.'},
{c:'The Prophet asked for relief, multiple times', x:'This scene is often read as merely an amusing anecdote from history. But it contains a principle: <strong>the burden of worship may be negotiated on the basis of human capacity</strong>, and the one doing the negotiating was the Prophet himself, on the advice of another prophet.<br><br>He did not assume that "the heavier, the more pious." He took into account the weakest of his future community, not the strongest.'},
{q:'What exactly did he bring back from the heavens?', o:['Isn\'t it just the command to pray?','How did people respond to it?']},
{n:'Read the continuation of Surah al-Isra\' after that first verse. The surah that opens with a journey through the heavens turns out to contain a manual for behavior on earth.'},
{m:'"And your Lord has decreed that you not worship except Him, and to parents, good treatment... So do not say to them a word of contempt, nor repel them, but speak to them a noble word."'},
{m:'"And give the relative his right, and the poor, and the traveler; and do not spend wastefully. Indeed, the wasteful are brothers of the devils."'},
{m:'"And do not pursue that of which you have no knowledge. Indeed, the hearing, the sight, and the heart — all of those will be questioned."'},
{c:'The Night Journey was not a spiritual escape', x:'The string of commands following the Isra\' account reads like a civil code of ethics: honor your parents, give the right of relatives and the poor, do not waste, do not kill your child for fear of poverty, do not approach immorality, fulfill your measures — and <strong>do not follow what you do not know</strong>.<br><br>Verse 36, in practice, is a command to verify. Revealed in the same surah as the most difficult-to-believe miracle in the entire sirah. Faith is required, but intellectual carelessness is still forbidden.'},
null,
{n:'Some who had already believed actually turned back when they heard this story. The accounts preserve that fact as it is — there was no attempt to hide that this event was indeed hard to accept.'},
{n:'People ran to tell Abu Bakr, expecting him to waver. His response was roughly: if he is the one saying it, then it is true — I indeed affirm him in matters of news from the heavens far more distant than this. From then on he was given the title <em>al-Siddiq</em>.'},
{n:'When challenged to prove it, he described Bayt al-Maqdis in detail to those who had been there, and mentioned caravans on their way back along with estimated arrival times.'},
{c:'A claim that could be tested', x:'Note the form of his proof. He did not say "just believe me." He mentioned things <strong>that could be verified</strong> by his listeners: the structure of the building they knew, and the arrival of caravans that would be confirmed within days.<br><br>Faith is required for the unseen, but for things that can be examined, he actually submitted himself to examination.'},
null,
{n:'Meanwhile, in an oasis two hundred kilometers to the north, a group of people from Yathrib came to Makkah during the pilgrimage season. They had not come to trade.'}
],
/* ── CH 8 · The Migration ── */
[
{n:'Yathrib was exhausted by decades of civil war between the Aws and Khazraj. They needed someone who would not take sides with either. Twelve people pledged allegiance at \'Aqabah in the first year.'},
{n:'He sent Mus\'ab ibn \'Umayr — a young man who had been the most fashionable and most perfumed in Makkah — as Islam\'s first ambassador. Not the most senior companion. The one sent was the most skilled communicator.'},
{n:'A year later, seventy-three men and <strong>two women</strong> came to pledge allegiance: Nusaybah bint Ka\'b (Umm \'Umarah) and Asma\' bint \'Amr. This pledge was not merely a declaration of faith — it was a political and defense treaty.'},
{c:'Two women signed the first defense treaty', x:'The Second Pledge of \'Aqabah was a contract whose contents included the willingness to protect him as one protects one\'s own family. Two women were present and equally bound by it.<br><br>Nusaybah later fought at Uhud, was wounded more than a dozen times, and was among those who stood firm protecting the Prophet when the ranks collapsed. That name is rarely mentioned from the pulpit, even though he himself mentioned her repeatedly.'},
{n:'When the Quraysh learned of the planned exodus, they convened at Dar al-Nadwah. Their decision: one young man from each tribe would stab him simultaneously, so that Bani Hashim would not be able to demand blood vengeance from all of Quraysh at once.'},
{m:'"And [remember] when those who disbelieved plotted against you to restrain you, kill you, or drive you out. They were plotting, and Allah was plotting. And Allah is the best of plotters."'},
{n:'That night he asked \'Ali ibn Abi Talib to sleep in his bed. Not merely as a decoy.'},
{a:'Then for what else?'},
{n:'To return entrusted possessions. The people of Quraysh — including those who stood at his door that night to kill him — still had their valuables stored at Muhammad\'s house, because there was nowhere safer in all of Makkah.'},
{c:'This may be the most densely meaningful detail in the entire sirah', x:'On the night when a group of people came to kill him, <em>their</em> property was still entrusted at his home. And the last thing he attended to before fleeing the city was ensuring those belongings were returned to their owners.<br><br>Thirteen years of enmity, boycott, oppression, and attempted murder — not one of those things changed the status of another person\'s goods in his hands. A trust does not become void because of hostility.<br><br>The verse about returning trusts (QS al-Nisa\': 58) would come down years later. He was already living it before it became a verse.'},
{n:'Together with Abu Bakr, he hid for three nights in the Cave of Thawr. The pursuers reached the mouth of the cave. Abu Bakr trembled — not from fear of death, but because if they bent down just slightly, they would be seen.'},
{m:'"...the second of two, when they were in the cave, when he said to his companion: Do not grieve; indeed Allah is with us."'},
{n:'The operation was supported by a tight, coordinated team: Abdullah ibn Abi Bakr brought news from the city, Asma\' bint Abi Bakr delivered provisions, and \'Amir ibn Fuhayrah — a freed slave — drove sheep behind them to erase their footprints.'},
{c:'Tawakkul accompanied by planning', x:'Often this event is told as a pure miracle. But al-Bukhari\'s own narration details an operation with assigned roles: an intelligence courier, a logistics provider, a footprint eraser, and a guide who was even hired from a polytheist named \'Abdullah ibn Urayqit.<br><br>Hiring a non-Muslim guide for the most decisive mission in Islamic history. Competence was treated as competence.'},
{n:'Suraqah ibn Malik pursued them in pursuit of a hundred-camel reward. His horse stumbled again and again. He gave up and asked for a guarantee of safe conduct — and he gave it, even promising something that sounded impossible at the time: that one day Suraqah would wear the bracelets of Kisra, King of Persia.'},
{n:'After stopping at Quba\' and building the first mosque, he entered Yathrib. From that day forward, the city changed its name: <strong>Madinah</strong> — the city.'},
{c:'The Islamic calendar does not begin from birth or revelation', x:'Years later, \'Umar ibn al-Khattab consulted others to establish the year zero of the calendar. The choices: the year of the Prophet\'s birth, the year the first revelation came, or the year of his death. What was chosen was <strong>the Hijra</strong>.<br><br>This means the event designated as the landmark of history was not a mystical moment, nor a military victory — it was when a community began to <em>build a society</em>. The next chapter explains why.'}
],
/* ── CH 9 · The Constitution of Madinah ── */
[
{n:'The first three things he did in Madinah, in order: build a mosque, establish a brotherhood between the newcomers and the original inhabitants, and write a written agreement with all residents of the city — including non-Muslims.'},
{a:'No fortress. No palace. No army.'},
{n:'The mosque was built from mud brick, with a roof of palm fronds and columns of tree trunks. He carried stones alongside the companions. The land belonged to two orphan boys, Sahl and Suhayl — and he refused to accept it as a gift, insisting on buying it.'},
{c:'Buying land from two orphan boys', x:'The two children offered their land as a gift for the mosque. He refused and insisted on paying. Though he had just arrived as a refugee without wealth, and the project was for a house of worship.<br><br>The reason is clear to anyone who has ever been an orphan: the rights of an orphan must not become charity, even for a mosque, even when they offer it themselves.'},
{n:'Then <em>mu\'akhah</em>: each Muhajirun was paired with one from the Ansar. Not merely symbolic — at first, the pair even inherited from each other.'},
{n:'Some Ansar offered half their wealth. But \'Abd al-Rahman ibn \'Awf replied with words that redirected the entire economy of Madinah.'},
{x:'"May Allah bless your wealth and your family. Just show me where the market is."'},
{c:'Dignity chosen over assistance', x:'The greatest welfare scheme in early Islamic history was <em>politely declined</em> by its intended recipient, who preferred access to a market. A few months later he was self-sufficient.<br><br>The Prophet ﷺ did not rebuke him. He approved — and then opened a market of his own for Muslims, without charging rent or taxes, as an alternative to the existing one.<br><br>Social piety in the sirah does not end at giving. It extends to <strong>creating access so that people do not need to be given</strong>.'},
{q:'Now for the part most rarely discussed in detail. Ready?', o:['Yes — what does the Charter of Madinah actually contain?','How was daily life organized?']},
{n:'The document — called <em>al-Sahifah</em> — was recorded completely by Ibn Ishaq and cited by Ibn Hisham. It bound the Muhajirun, the Ansar, and the Jewish tribes of Madinah into one political entity.'},
{n:'Its opening clause states that they are all <em>ummatun wahidah min dunin nas</em> — one community, separate from others. The word "umma" here clearly means political community, not community of faith.'},
{n:'The clause regarding the Jews of Banu \'Awf reads: they are one community with the believers; <strong>for the Jews is their religion, and for the Muslims is their religion</strong> — including their allies and themselves.'},
{n:'Other clauses regulate: the collective obligation to share the cost of war if the city is attacked, the prohibition of harboring wrongdoers even if they are relatives, the guarantee that the oppressed must be defended, and that disputes endangering the community be returned to Allah and Muhammad.'},
{c:'Plurality that was written, not merely tolerated', x:'What is rarely emphasized: this is a <strong>written document</strong>, not an oral policy that could be withdrawn at any time. There are clauses, parties, mutual obligations, and dispute mechanisms.<br><br>Non-Muslims in this document are not "guests who are tolerated." They are parties with equal rights and burdens in matters of the city\'s defense and security.<br><br>The conflicts with certain Jewish tribes that occurred later were matters of <em>treaty violations in wartime</em> — and should be read as legal cases against specific parties, not as a cancellation of the principles written here.'},
null,
{n:'The call to prayer had no form yet. A bell like the Christians was proposed, a horn like the Jews, fire like the Zoroastrians. All were rejected. Then an ordinary companion, \'Abdullah ibn Zayd, dreamt of the words of the adhan.'},
{n:'He confirmed the dream and instructed Bilal to call it, because his voice was finer. Then \'Umar came saying he had dreamed the same thing.'},
{c:'Islam\'s greatest symbol came from one ordinary companion\'s dream', x:'The adhan did not come down as revelation. It arose from a citizen\'s suggestion, filtered through consultation, ratified by the Prophet, and its execution entrusted to the most competent person — a freed slave from Abyssinia.<br><br>An entire theory of leadership is contained in this one small decision.'},
{n:'In the mosque\'s veranda lived <em>Ahl al-Suffah</em> — newcomers without family and without wealth. They lived off surplus food from the community. This was the first social welfare institution in the history of this community, located right alongside the house of worship.'},
{n:'When he first arrived, a Jewish scholar named \'Abdullah ibn Salam came to test him. The first words he heard from the Prophet in public were these:'},
{m:'"O people, spread peace, feed the hungry, maintain family ties, and pray at night while others sleep — you will enter Paradise in peace."'},
{c:'The opening address of a new state', x:'Three of the four commands in his first words in Madinah are <strong>horizontal social actions</strong>: greeting, feeding, maintaining kinship. Only one is vertical, and even that is the most hidden act of worship.<br><br>This order is no coincidence. It became the blueprint for how that community was built.'},
null,
{n:'For two years, the city grew. But Makkah did not forget. The wealth of the Muhajirun there had been confiscated, and a great confrontation was only waiting for the right time.'}
],
/* ── CH 10 · War, Defeat, Treaty ── */
[
{n:'At Badr, in the second year after the Hijra, around three hundred faced a thousand. Before the battle, something occurred that determined the entire Islamic approach to decision-making.'},
{n:'He positioned the troops at a certain point. Al-Hubab ibn al-Mundhir asked: is this position a revelation from Allah, or your own opinion and military strategy? He answered that it was opinion and strategy. Al-Hubab then suggested advancing to the nearest water source and blocking the remaining wells. The suggestion was accepted and carried out.'},
{c:'The Prophet distinguished between revelation and his own reasoning', x:'Al-Hubab\'s question was only possible if that culture <em>already permitted it</em>. And the Prophet\'s ﷺ answer drew a very important line: <strong>not everything that comes from a leader\'s mouth is absolute truth.</strong><br><br>Most of his decisions as head of state were ijtihad — open to discussion, open to correction, and even capable of being mistaken. This is the foundation of the entire tradition of consultation in Islam, and it often disappears when the sirah is told as a series of miracles.'},
{n:'After the victory, there were seventy prisoners. He consulted his companions. Abu Bakr suggested ransom, \'Umar suggested execution. He chose ransom — and for prisoners who could not afford to pay but could read, the ransom was <strong>teaching ten children of Madinah to read and write</strong>.'},
{c:'Ransom paid with literacy', x:'An enemy who had just tried to annihilate you becomes a teacher for your children. A war prisoner policy where you pay your way out with knowledge — in the seventh century.<br><br>This program produced the first literate generation of Muslims in Madinah, including some who would later become scribes of the revelation.'},
{n:'Then a verse came down that rebuked that decision.'},
{m:'"It is not fit for a prophet to take prisoners before he has made great slaughter in the land. You desire the goods of the world, but Allah desires the Hereafter."'},
{c:'The scripture rebukes its own prophet, openly', x:'This is not the only one. There is the rebuke over the Badr prisoners. There is QS \'Abasa: 1-10 rebuking him for turning away from a blind man to attend to a nobleman. There is QS al-Tahrim: 1 over a domestic matter. There is QS al-Tawbah: 43 over permission given too hastily.<br><br>And all of it <strong>was recited publicly, memorized, and preserved</strong> by the community that loved him. None of it was censored.<br><br>For anyone assessing the authenticity of a text, this is weighty evidence: a forger does not include a chapter on their hero\'s weaknesses in the scripture.'},
{q:'A year later came Uhud. What decision would you like to see there?', o:['When the Prophet was outvoted in consultation','When he was about to curse his enemies']},
{n:'His opinion: defend from within the city. The majority opinion, especially the young men who had missed Badr: go out to meet the enemy. He followed the majority.'},
{n:'When some of them later regretted it and offered to defer to his opinion, he refused — because the armor was already on, and a decision once made is not rescinded simply because people grew uncertain.'},
{n:'Uhud ended in defeat. Seventy companions fell, including Hamzah. His teeth were broken and his face was wounded. That consultation, by its outcome, proved to be wrong.'},
{n:'Then the following verse came down — after that defeat, not before it.'},
{m:'"So by mercy from Allah you were lenient with them. And if you had been rude and hard-hearted, they would have dispersed from around you. So pardon them, ask forgiveness for them, and consult them in the matter."'},
{c:'The command to consult came down precisely after consultation had produced a disaster', x:'This may be one of the most counterintuitive verses in the Quran, and the sequence of its revelation is almost never emphasized.<br><br>After seventy people perished because of a collective decision that proved wrong, the response given was not "from now on, consult no more — just follow me." Instead: <em>forgive them, seek forgiveness for them, and continue to consult with them.</em><br><br>Consultation is upheld not because it always produces the best decision — but because it builds a better society. Its value lies in the process, not only in the outcome.'},
null,
{n:'While wounded at Uhud, he was about to call down curses upon the Quraysh leaders who had attacked him. Before he could, a verse descended.'},
{m:'"You have no part in the matter — whether He turns toward them in forgiveness or punishes them, for indeed they are wrongdoers."'},
{c:'Pronouncing verdicts on others is no one\'s authority', x:'These words were addressed to the Prophet ﷺ, on the day his uncle was killed and his own face was bleeding. If even in a situation like that he was told that the final fate of others was not his concern, then no one after him has any greater authority.<br><br>And some of those he nearly cursed that night — Khalid ibn al-Walid, \'Ikrimah ibn Abi Jahl, Abu Sufyan — later became Muslims.'},
null,
{n:'In the fifth year, Madinah was besieged by ten thousand combined forces. The strategy that saved the city did not come from Arab tradition.'},
{n:'Salman al-Farisi, a Persian, proposed digging a trench — a technique common in his homeland and completely foreign to the Arabian peninsula. He accepted it and dug alongside everyone else.'},
{c:'Foreign technology adopted without identity anxiety', x:'There was no debate about whether digging trenches was "the Persian way" or "not our tradition." The only question was whether it would work.<br><br>The same principle recurs repeatedly: a polytheist guide during the Hijra, a Roman-style signet ring for diplomatic letters, and later administrative systems adopted from outside. Identity was not staked on the tools.'},
{n:'In the sixth year, he set out for Makkah to perform \'umrah without any intention of fighting, and was intercepted at Hudaybiyyah. What happened next nearly caused some companions to mutiny.'},
{n:'The treaty terms appeared entirely one-sided: \'umrah postponed one year; ten-year ceasefire; anyone from Quraysh who fled to Madinah must be returned, but not vice versa.'},
{n:'Even the writing of the text was contested. When <em>Bismillahirrahmanirrahim</em> was written, the Quraysh refused and requested the phrase they normally used. He agreed. When "Muhammad, Messenger of Allah" was written, they refused. He ordered those words erased, and erased them himself because \'Ali could not bring himself to do it.'},
{c:'Relinquishing a title for the sake of a result', x:'He accepted the erasure of his prophetic title from a document — not from doubt, but because he knew that ten years of peace was worth more than one word on paper.<br><br>Some people today would call this "selling one\'s principles." The Quran called it <em>fathan mubina</em>.'},
{m:'"Indeed, We have given you a clear conquest."'},
{n:'\'Umar came to him angry, asking again and again why they had to accept this humiliation. Years later, \'Umar said he kept giving charity and fasting in remorse for what he said that day.'},
{n:'After the document was signed, he ordered the companions to slaughter their sacrificial animals and shave their heads on the spot. Not a single person moved. He repeated it three times. Still no one moved.'},
{n:'He went into his tent in distress. Umm Salamah, his wife, gave him counsel: do not speak to anyone, go out and slaughter your own animal, then call the barber. He did so. Seeing that, the entire force moved all at once.'},
{c:'A national deadlock was broken by a woman\'s advice', x:'This is recorded in Sahih al-Bukhari, not in a peripheral book. The Prophet ﷺ faced mass insubordination — perhaps the gravest leadership crisis of his life — and what resolved it was Umm Salamah\'s reading of crowd psychology.<br><br>He did not debate her, did not say "I\'ll consider it later." He immediately acted on it.<br><br>Two years later, the number of people who entered Islam during the Hudaybiyyah ceasefire exceeded all who had entered in the previous nineteen years combined.'},
{n:'Before we leave this chapter on war, there is one thing you must take with you.'},
{m:'"Set out in the name of Allah... do not kill the aged and frail, nor an infant, nor a child, nor a woman; and do not betray the war spoils."'},
{c:'Rules of war that preceded their time', x:'These prohibitions were issued centuries before the Geneva Conventions: non-combatants must not be touched, trees must not be cut down, houses of worship and their occupants must not be disturbed, corpses must not be mutilated, and war spoils must not be misappropriated.<br><br>That there are parties today who violate these rules while claiming to follow him is a separate problem — but the text is unambiguous, and it is fourteen centuries old.'}
],
/* ── CH 11 · When Power Is in Your Hands ── */
[
{n:'The Quraysh violated the ceasefire by helping their allies attack a Madinah ally. He moved with ten thousand men. Makkah had no strength to resist.'},
{n:'Twenty-one years before, that same city had tortured his followers, boycotted his family until children ate leaves, and sent assassins to his chamber.'},
{a:'Every person in that city knew what usually happens to a conquered city.'},
{n:'Sa\'d ibn \'Ubadah, the Ansar\'s standard-bearer, cried out as he entered the city: "Today is the day of great slaughter!" He heard it, removed the standard from him, and corrected his words.'},
{m:'"Today is the day of mercy."'},
{n:'The operational orders he issued were almost entirely restraining: whoever enters his home and closes the door is safe; whoever enters Masjid al-Haram is safe; whoever enters the house of Abu Sufyan is safe.'},
{a:'The house of Abu Sufyan. The commander who led the armies at Uhud and Khandaq. His house was made a safe zone.'},
{n:'He stood before the Ka\'bah, in front of the people who had expelled him, and asked what they thought he would do to them. They replied: a noble brother, son of a noble brother. He then quoted the words of Prophet Yusuf to the brothers who had thrown him into the well.'},
{m:'"No blame will there be upon you today. Allah will forgive you; and He is the most merciful of the merciful."'},
{n:'Then: "Go, you are free."'},
{c:'A general amnesty, not a conditional pardon', x:'No mass trials, no long lists of executions, no confiscation of property. Hind bint \'Utbah, who had mutilated the body of Hamzah, lived. Wahshi, who had killed him, lived. \'Ikrimah ibn Abi Jahl, Abu Sufyan, Safwan ibn Umayyah — all lived.<br><br>The true test of character is not when someone is powerless. It comes when someone <strong>can retaliate and chooses not to</strong>.'},
{q:'There was one more decision that day — subtler, but sharper.', o:['Show me']},
{n:'The key to the Ka\'bah had been held hereditarily by the Bani Shaybah family. The holder at that time, \'Uthman ibn Talhah, had previously refused to open the door for him before the Hijra and had treated him harshly.'},
{n:'After the city fell, the key was taken. His uncle Abbas and \'Ali requested that the guardianship of the Ka\'bah be transferred to the Prophet\'s family — a completely reasonable political request.'},
{n:'He summoned \'Uthman ibn Talhah and returned the key to him, declaring that right to be with his family forever. Accounts hold that the following verse descended in connection with this event.'},
{m:'"Indeed, Allah commands you to render trusts to whom they are due, and when you judge between people, to judge with justice."'},
{c:'Absolute power — and the position still not given to family', x:'This is the most easily violated and least discussed decision. He held the entire city, without opposition, and his own family members were the ones requesting it. The position was still returned to the rightful holder — someone who had treated him harshly years before, and who had not even entered Islam at that moment.<br><br>The Bani Shaybah family holds the key to the Ka\'bah to this day.'},
{n:'Three hundred and sixty idols around the Ka\'bah were toppled. As he toppled them he recited:'},
{m:'"And say: Truth has come and falsehood has departed. Indeed, falsehood is bound to depart."'},
{n:'Then Bilal — the formerly enslaved man who had once been stretched out in the desert of that city with a rock on his chest — was commanded to climb the Ka\'bah and call the adhan. Some Qurayshi nobles muttered about "that black slave."'},
{m:'"O people, indeed We created you from a male and a female and made you peoples and tribes so that you may know one another. Indeed, the most honored of you in the sight of Allah is the most righteous of you."'},
{c:'A symbol chosen deliberately', x:'Of ten thousand people, the one elevated to the top of the most sacred building in the most prestigious city was a formerly enslaved African man. In a city whose entire social order was structured around bloodlines.<br><br>This was not personal kindness. It was a political statement about how that new society would measure human beings.'}
],
/* ── CH 12 · The Final Sermon ── */
[
{n:'In the tenth year of the Hijra, he performed the Hajj with more than one hundred thousand people. At \'Arafah, upon his camel, he delivered an address whose words were relayed by criers so they could be heard to the edges of the crowd.'},
{m:'"Indeed, your blood and your wealth are sacred to one another, as sacred as this day of yours, in this month of yours, in this city of yours."'},
{n:'Then he abolished the two most destructive legacies of the age of ignorance — and began both with his own family.'},
{n:'Blood vengeance claims of the pre-Islamic era were abolished, and the first to be canceled was the blood claim for a death in his own family, the child of Rabi\'ah ibn al-Harith. Usury of the pre-Islamic era was abolished, and the first to be wiped out was <strong>the usury of Abbas ibn Abd al-Muttalib — his own uncle</strong>.'},
{c:'Reform began from within his own household', x:'This is not a decorative detail. In one address, he abolished two systems that benefited his own family, and named his uncle publicly before one hundred thousand people.<br><br>If you want one measure to judge the integrity of a reformer, here it is: <em>who is the first to be harmed by the rule he makes.</em>'},
{n:'He continued with a message about women, warning the people to be mindful of Allah in how they treated them, and saying that they have rights over you just as you have rights over them.'},
{m:'"O people, your Lord is one and your father is one. No Arab has superiority over a non-Arab, nor a non-Arab over an Arab, nor one of red complexion over one of dark complexion, nor one of dark complexion over one of red complexion — except by taqwa."'},
{n:'Repeatedly he asked the crowd whether he had delivered the message, and they replied yes. Then he raised his finger toward the sky and said: "O Allah, bear witness."'},
{m:'"This day I have perfected your religion for you, completed My favor upon you, and have approved Islam as your religion."'},
{n:'\'Umar wept upon hearing it. When asked why, he said that after perfection there is nothing but decline. Three months later he fell ill.'},
{q:'We have come to the final part.', o:['Continue']},
{n:'He was ill for about two weeks, cared for in \'A\'ishah\'s room. When he could no longer lead the prayer, he commanded Abu Bakr to take his place.'},
{n:'Among the words most repeatedly narrated from his final moments were two things.'},
{m:'"Prayer, prayer — and those whom your right hands possess."'},
{c:'His last words named the most powerless group', x:'Pause here. A head of state, in the final minutes of his life, with all the legacy he could leave — chose to say <strong>prayer</strong> and <strong>slaves</strong>.<br><br>The vertical relationship with God, and the treatment of human beings who have the least power to defend themselves. Those two things placed side by side, in one breath.<br><br>The entire sirah, compressed, leads to this sentence.'},
{n:'He died on a Monday, in that room, at the age of sixty-three. When the companions checked what he had left behind, they found the following.'},
{x:'The Messenger of Allah ﷺ died while his armor was still pledged to a Jew in exchange for thirty sa\' of barley.'},
{c:'Dying in debt — and to a Jewish man', x:'The ruler of all of Arabia left this world with no wealth, his armor pawned to buy grain for his family. Two facts held simultaneously in this single brief narration:<br><br>First, absolutely no accumulation of wealth from the power he held.<br>Second, in the final year of his life, in the capital of the Islamic state, a credit transaction with a Jewish man was conducted normally — and he did not seek a Muslim lender for "reasons of security."'},
{n:'\'Umar refused to believe it and threatened anyone who said he had died. Abu Bakr entered, uncovered his face, kissed it, then came out to face the crowd.'},
{x:'"Whoever worshipped Muhammad, Muhammad has indeed died. And whoever worships Allah, indeed Allah is the Living who never dies." Then he recited the verse.'},
{m:'"And Muhammad is no more than a messenger; before him messengers have passed. So if he dies or is killed, will you turn back on your heels?"'},
{n:'\'Umar said that his legs could not support his body when he heard that verse, as though it had been revealed for the first time.'},
{c:'A final message to the community: do not exalt me', x:'He had warned of it long before: <em>"Do not exalt me as the Christians exalted the son of Maryam. I am only His servant. So say: servant of Allah and His messenger."</em> (al-Bukhari no. 3445).<br><br>And when the sun eclipsed on the day his son Ibrahim died, and people began to link the two, he immediately refuted it: the sun and the moon are signs of Allah that do not eclipse for the death or birth of anyone (al-Bukhari no. 1043).<br><br>He did not even allow his own grief to become a myth.'},
{n:'The timeline of his life ends here. But there is still one room remaining — containing things that belong to no chronology, and for that reason are least often heard.'}
],
/* ── CH 13 · Rarely from the Pulpit ── */
[
{n:'This room has no set order. Choose what you want to hear. You can return here afterward.'},
{q:'Which would you like to open?', o:['In the home — wives and servants','Animals and the environment','Children','He joked','Racism and equality','The limits of his own authority','Simplicity and debt','Neighbors and people of other faiths','Enough — close this journey']},
{x:'I asked \'A\'ishah what the Prophet ﷺ usually did at home. She answered: he would do household chores — and when the time for prayer came, he would go out to pray.'},
{n:'Other accounts specify: he sewed his own sandals, patched his own garments, and milked his own goat.'},
{x:'I served the Prophet ﷺ for ten years. He never once said "ah" to me. He never reproached something I did with "why did you do this," and never reproached something I left undone with "why didn\'t you do that."'},
{c:'Ten years without a single outburst', x:'Anas began serving him at around age ten — a child, in the house of a head of state, for a full decade. If there is any place where a person\'s character cannot be hidden, it is before their own servant.<br><br>Note the structure of his testimony: not "he was kind," but three specific things that <em>never happened</em>. Negative testimony is far harder to fabricate than praise.'},
{m:'"The best of you is the best toward his family, and I am the best among you toward my family."'},
null,
{x:'The Prophet ﷺ said that a woman was punished because of a cat she imprisoned until it died — she neither fed it nor released it so it could eat insects of the earth.'},
{n:'And the opposite: a man who descended into a well and brought water in his shoe for a thirsty dog. The companions asked whether there was reward in [caring for] animals. His answer:'},
{m:'"In every living creature with a moist liver, there is a reward."'},
{n:'Once he entered an Ansari\'s garden and a camel came to him and groaned, tears running down its face. He stroked its back, then called its owner.'},
{m:'"Will you not fear Allah regarding this animal that Allah placed in your possession? For it has complained to me that you leave it hungry and work it too hard."'},
{m:'"No Muslim plants a plant, or sows a crop, then a bird, a person, or an animal eats from it, except that it is counted as charity for him."'},
{c:'Ownership is not a license to harm', x:'The words to the camel\'s owner were sharp: <em>"the animal Allah placed in your possession"</em> — ownership is acknowledged, then made the very basis of the demand for responsibility, not a justification.<br><br>And the most often overlooked detail: a camel is described as <em>complaining</em>. Language normally used for a victim seeking justice.'},
{n:'There is also a well-known account about planting a sapling even if the Last Hour had already begun. Its authenticity is debated — some scholars rate it hasan or sahih, others weaken it. You deserve to know both.'},
{m:'"If the Last Hour begins while one of you has a palm sapling in his hand, and he is able to plant it before the Hour comes, let him plant it."'},
null,
{x:'The Prophet ﷺ kissed al-Hasan ibn \'Ali while al-Aqra\' ibn Habis was sitting nearby. Al-Aqra\' said he had ten children and had never kissed any of them. The Prophet ﷺ looked at him and said: "Whoever does not show mercy will not be shown mercy."'},
{n:'He also shortened the congregational prayer — the most formal act of worship in Islam — because of one reason.'},
{m:'"I enter the prayer intending to lengthen it. Then I hear the cry of a baby and I shorten my prayer, because I know how distressing the mother\'s anguish is at hearing her child cry."'},
{c:'The reason was not the baby — it was the mother', x:'Reread the end of it. What he considered was not the baby\'s comfort, but the <strong>anxiety of its mother</strong> who was praying behind him and could do nothing.<br><br>That level of attentiveness does not arise from rules. It arises from a habit of noticing people.'},
{n:'And he once led the prayer while carrying his granddaughter Umamah — setting her down when prostrating, lifting her again when standing.'},
null,
{n:'This is the side almost entirely absent from his popular image.'},
{x:'The companions said, "O Messenger of Allah, you joke with us." He replied: "I do joke, but I say only what is true."'},
{n:'A man came asking for a mount. He replied that he would give him a <em>baby camel</em>. The man objected — what use is a baby camel? He replied: is not every camel a baby of a she-camel?'},
{n:'There is also a well-known account about an old woman being told there are no old women in Paradise — then he explained that the people of Paradise would be restored to youth. You should know: the chain of this narration is weak.'},
{m:'"No old woman will enter Paradise... Indeed, Allah will recreate them and make them virgins."'},
{c:'Humor that was not built on lies or ridicule', x:'The rule is clear from the first hadith: joking is permitted, <strong>lying is not</strong> — even to make people laugh. Note that the baby-camel joke was completely factually correct; that is the form of humor he used.<br><br>And not a single sound narration exists in which he made a joke by demeaning someone\'s appearance, poverty, or shortcoming.'},
null,
{n:'Abu Dharr, one of the earliest and most ascetic companions, once quarreled with Bilal and called him "son of a black woman."'},
{m:'"You reproach him by his mother? Indeed, you are a man in whom there is still jahiliyyah."'},
{n:'Abu Dharr laid his cheek on the ground and swore not to raise it until Bilal stepped on it. He was a senior companion; the one he insulted was a freed slave.'},
{c:'Racism is called "jahiliyyah" — not a minor slip', x:'The word used was not "impolite" or "unwise." The word used was <em>jahiliyyah</em> — the term used to describe the entire old system that Islam had come to dismantle.<br><br>And the one rebuked was not an ordinary person, but one of the first five to enter Islam.'},
{n:'In the matter of legal justice, the principle was stated by naming his own daughter, when some people requested leniency for a noblewoman who had stolen.'},
{m:'"Indeed, what destroyed those before you was that when a nobleman stole, they left him; but when a weak person stole, they applied the punishment. By Allah, if Fatimah bint Muhammad were to steal, I would cut her hand."'},
{c:'A diagnosis of why civilizations collapse', x:'The first part of this hadith is passed over far more often than the dramatic second part. Yet that is where the analysis lies: past communities did not perish from lack of piety — they perished because <strong>the law operated differently for the powerful and the weak</strong>.'},
null,
{n:'He saw the people of Madinah cross-pollinating their date palms, then gave his opinion that perhaps it was unnecessary. They followed him, and that year\'s harvest was poor.'},
{m:'"I am only a human being. When I command you something about your religion, take it. And when I command something based on my personal opinion, I am only human... You know better about your worldly affairs."'},
{c:'The Prophet acknowledged he could be wrong about technical matters', x:'This is a hadith with enormous consequences, and it is very rarely discussed in full. He <strong>retracted his own opinion</strong> and deferred technical matters to specialists.<br><br>The implication for today: religious authority does not automatically become authority over agriculture, medicine, economics, or engineering. That boundary was drawn by the Prophet himself, not by secularists.'},
{n:'He also refused to be exalted, even in the most subtle forms.'},
{m:'"Do not exalt me as the Christians exalted the son of Maryam. I am only His servant. So say: servant of Allah and His messenger."'},
{n:'When a man came trembling with awe before him, he calmed him by saying that he was merely the son of a Qurayshi woman who ate dried meat.'},
null,
{x:'I came in to see the Messenger of Allah ﷺ and he was lying on a mat. I sat down, and I saw the marks of the mat on his side. I looked at his storage cabinet, and its contents were only a handful of barley, a little tanning-leaf, and a piece of hanging leather. Tears ran down my face.'},
{n:'\'Umar said that Kisra and Caesar lived in luxury, while he who was the messenger of Allah lived like this. He rose and answered.'},
{m:'"Are you not pleased that the world is for them, and the Hereafter for us?"'},
{c:'Simplicity as a choice, not as poverty', x:'It is important to distinguish the two. He had access to one-fifth of the spoils of every expedition — a very large sum. What happened was that wealth kept flowing out almost as fast as it came in.<br><br>Accounts record that he once spent a sleepless night disturbed only because he remembered there were a few dinars in his house that had not yet been distributed (al-Bukhari no. 1221).<br><br>This was not asceticism that rejected the world. It was a refusal to <em>hoard</em>.'},
null,
{m:'"Jibril kept recommending the neighbor to me until I thought he would make him an heir."'},
{n:'Note that this hadith does not specify the neighbor\'s religion. And in practice, some of his neighbors in Madinah were indeed Jewish.'},
{x:'A Jewish boy used to serve the Prophet ﷺ. When the boy fell ill, he came to visit him and sat by his head.'},
{n:'Once a funeral procession passed, and he stood up to honor it. The companions told him it was the funeral of a Jewish person.'},
{m:'"Is he not also a soul?"'},
{c:'Three words containing an entire principle', x:'<em>Alaysat nafsan?</em> — Is he not also a soul? A rhetorical question answered by rising to one\'s feet.<br><br>What deserves honor is a person\'s humanity, not their group membership. This sentence was spoken by a head of state, in his capital, during a time of war with certain Jewish tribes who had violated the treaty — and still, the funeral of an ordinary Jewish person was honored.<br><br>Political conflict was not permitted to expand into the erasure of human dignity.'},
{n:'And one more: about how he treated the most despised people in society. He forbade companions from cursing a man who had been repeatedly punished for drinking wine, and said that the man loved Allah and His Messenger.'},
null,
{n:'You have traveled through sixty-three years, from a valley without crops to a small room in Madinah.'},
{n:'If there is one thread that ties everything together, perhaps it is this: <strong>every time more power came into his hands, it was used to protect those who had no power.</strong> In Makkah he was powerless and refused to take revenge. In Madinah he held power and wrote protections for the different. At the Conquest of Makkah he was victorious and freed everyone. On his deathbed he named the enslaved.'},
{n:'What you have read here is only the surface. Every chapter has thick books behind it — al-Rahiq al-Makhtum, the Sirah of Ibn Hisham, Fiqh al-Sirah by al-Buti and al-Ghazali, and of course the foundational hadith collections.'},
{c:'How to use this medium', x:'Everything you have read has references you can check — and some are deliberately marked <em>da\'if</em> so you do not pass them on as sound. That is not a weakness; that is how it works.<br><br>The <strong>References</strong> button compiles all sources per chapter. Bring them to a teacher or the books themselves. This medium is only a door — not the room.'},
{n:'May this journey bring closeness, not merely information. You can return to the Timeline at any time to revisit any chapter.'},
null
]
]};
/* ────────────────────────────────────────────── */
const keymap = CH.map(c => { const m = {}; c.nodes.forEach((n,i)=>{ if(n.k) m[n.k]=i; }); return m; });

/* ---------- penyimpanan progres ---------- */
const store = {
  async save(){
    try{ if(window.storage) await window.storage.set('sirah:progress', JSON.stringify({ci,ni,seen})); }catch(e){}
  },
  async load(){
    try{
      if(!window.storage) return null;
      const r = await window.storage.get('sirah:progress');
      return r ? JSON.parse(r.value) : null;
    }catch(e){ return null; }
  }
};

/* ---------- rel waktu ---------- */
function buildRail(){
  el.rail.innerHTML = '';
  CH.forEach((c,i)=>{
    const b = document.createElement('button');
    b.className = 'rail-mark';
    b.innerHTML = `<span class="glyph">${c.glyph}</span><span class="yr">${c.yr}</span><span class="ch-prog"></span>`;
    b.title = c.title;
    b.setAttribute('aria-label', `${t().chapPrefix} ${i+1}: ${currentLang === 'en' && CH_META_EN[i] ? CH_META_EN[i].title : c.title}`);
    b.onclick = ()=> goto(i,0);
    el.rail.appendChild(b);
  });
}
function syncRail(){
  [...el.rail.children].forEach((b,i)=>{
    b.classList.toggle('now', i===ci);
    b.classList.toggle('seen', !!seen[i] && i!==ci);
  });
  const now = el.rail.children[ci];
  if(now && now.scrollIntoView) now.scrollIntoView({block:'nearest', behavior: RM?'auto':'smooth'});
}
function syncProgress(){
  [...el.rail.children].forEach((b,i)=>{
    const total = CH[i] ? CH[i].nodes.length : 1;
    const pct = Math.min(Math.round(((progress[i]||0)+1)/total*100), 100);
    const bar = b.querySelector('.ch-prog');
    if(bar) bar.style.width = (seen[i] ? pct : 0) + '%';
  });
}

/* ---------- pembungkus kata untuk animasi ---------- */
function stagger(html){
  let k = 0;
  return String(html).replace(/(<[^>]+>)|([^<\s]+)/g, (m,tag,word)=>{
    if(tag) return tag;
    const d = Math.min(k++ * 13, 620);
    return `<span class="w" style="animation-delay:${d}ms">${word}</span>`;
  });
}
function paint(target, html){
  target.innerHTML = RM ? html : stagger(html);
}

/* ---------- render satu node ---------- */
const ROMAN = ['','I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII'];

function render(){
  const c = CH[ci], n = c.nodes[ni];
  if(!n) return advanceChapter();

  el.kick.textContent = t().chapPrefix + ' ' + (ROMAN[c.id] || c.id);
  el.ttl.textContent = currentLang === 'en' && CH_META_EN[ci] ? CH_META_EN[ci].title : c.title;
  el.yrs.textContent = currentLang === 'en' && CH_META_EN[ci] ? CH_META_EN[ci].years : c.years;

  el.plate.className = '';
  el.refs.innerHTML = '';
  el.choices.innerHTML = '';
  el.hint.innerHTML = t().hint;
  Scene.rosette(false);

  let speaker = t().spNar, cls = 'sp-nar', html = '';

  /* translation lookup helper */
  const _nt = (typeof CH_TRANSLATIONS!=='undefined' && currentLang==='en' && CH_TRANSLATIONS.en[ci]) ? CH_TRANSLATIONS.en[ci][ni] : null;
  const _e = k => (_nt && _nt[k] !== undefined ? _nt[k] : n[k]);

  if(n.n !== undefined){ html = _e('n'); }
  else if(n.a !== undefined){ speaker=t().spPilgrim; cls='sp-aku'; html = '<em>'+_e('a')+'</em>'; }
  else if(n.r !== undefined){
    speaker = t().spRiwayat + ' · ' + n.r; cls='sp-riw'; html = '”'+_e('x')+'”';
  }
  else if(n.sb !== undefined){
    speaker=t().spNabi; cls='sp-sab'; el.plate.className='plate-sabda';
    html = `<div class=”arabic”>${n.sb}</div><div class=”meaning”>${_e('m')}</div>`;
    Scene.pulse(0.55);
  }
  else if(n.ay !== undefined){
    speaker=t().spFirman; cls='sp-ayt'; el.plate.className='plate-ayat';
    html = `<div class=”arabic”>${n.ay}</div><div class=”meaning”>${_e('m')}</div>`;
    Scene.rosette(true); Scene.pulse(0.95);
  }
  else if(n.c !== undefined){
    speaker=t().spRare; cls='sp-cat'; el.plate.className='plate-catatan';
    html = `<div class=”note-h”>${_e('c')}</div>${_e('x')}`;
    Scene.pulse(0.4);
  }
  else if(n.q !== undefined){
    speaker=t().spChoice; cls='sp-aku'; html = _e('q');
  }
  else if(n.j !== undefined){ return step(); }

  el.spn.textContent = speaker;
  el.sp.className = 'speaker ' + cls;
  paint(el.body, html);

  /* rujukan */
  const chips = [];
  if(n.s){
    const isQ = /^QS/.test(n.s);
    chips.push(`<span class="ref${isQ?' q':''}">${n.s}</span>`);
    if(n.g) chips.push(`<span class="grade g-${n.g}">${n.g}</span>`);
    if(n.note) chips.push(`<span class="ref" style="border-color:rgba(226,160,92,.35);color:#E2A05C">${n.note}</span>`);
  }
  el.refs.innerHTML = chips.join('');

  /* pilihan */
  if(n.o){
    el.hint.innerHTML = t().hintChoose;
    n.o.forEach((op,i)=>{
      const b = document.createElement('button');
      b.className = 'choice';
      const lbl = (_nt && _nt.o && _nt.o[i]) ? _nt.o[i] : op.l;
      b.innerHTML = `<span class="q">${i+1}</span><span class="lbl">${lbl}</span>`;
      b.onclick = ev => { ev.stopPropagation(); pick(op); };
      el.choices.appendChild(b);
    });
  }

  if(el.scroll) el.scroll.scrollTop = 0;
  TTS.speak(n, _nt, step);
  el.prog.style.width = Math.round(((ni+1)/c.nodes.length)*100) + '%';
  progress[ci] = Math.max(progress[ci]||0, ni);
  seen[ci] = true; syncRail(); syncProgress(); store.save(); bookmark.save();
}

function pick(op){
  hist.push([ci,ni]);
  /* track choice for re-path UI */
  if(!choiceLog[ci]) choiceLog[ci]=[];
  if(!choiceLog[ci].some(e=>e.ni===ni)){
    const node = CH[ci].nodes[ni];
    choiceLog[ci].push({ni, chosen:op.to, chosenLabel:op.l, options:node?node.o:[]});
  }
  const t = keymap[ci][op.to];
  ni = (t===undefined) ? ni+1 : t;
  render();
}

function step(){
  const c = CH[ci], n = c.nodes[ni];
  if(n && n.o) return;
  if(n && n.j !== undefined){
    const t = keymap[ci][n.j];
    hist.push([ci,ni]);
    ni = (t===undefined) ? ni+1 : t;
    return render();
  }
  hist.push([ci,ni]);
  ni++;
  if(ni >= c.nodes.length) return advanceChapter();
  render();
}

function back(){
  TTS.stop();
  const h = hist.pop();
  if(!h) return;
  const chg = h[0] !== ci;
  ci = h[0]; ni = h[1];
  if(chg){ Scene.mood(CH[ci].id); Scene.setScene(ci); Scene.reform(); }
  render();
}

function advanceChapter(){
  if(ci >= CH.length-1){ ni = CH[ci].nodes.length-1; return render(); }
  goto(ci+1, 0);
}

function goto(i, j){
  hist.push([ci,ni]);
  ci = i; ni = j||0;
  Scene.mood(CH[ci].id);
  Scene.setScene(ci);
  Scene.reform();
  closeSheets();
  render();
}

/* ---------- panel ---------- */
function closeSheets(){ el.map.classList.remove('on'); el.ref.classList.remove('on'); }

function openMap(){
  el.mapList.innerHTML = '';
  CH.forEach((c,i)=>{
    const wrap = document.createElement('div');
    wrap.style.cssText = 'width:100%';

    const b = document.createElement('button');
    b.className = 'ch-row';
    const meta = currentLang === 'en' && CH_META_EN[i] ? CH_META_EN[i] : c;

    /* build choice-branch section if chapter has logged choices */
    let branchHTML = '';
    const log = choiceLog[i];
    if(log && log.length && seen[i]){
      branchHTML = '<div class="ch-branches">';
      log.forEach(entry=>{
        if(!entry.options || !entry.options.length) return;
        const node = c.nodes[entry.ni];
        const transNode = (currentLang==='en' && CH_TRANSLATIONS && CH_TRANSLATIONS.en[i]) ? CH_TRANSLATIONS.en[i][entry.ni] : null;
        const rawQ = transNode && transNode.q ? transNode.q : (node && node.q ? node.q : '');
        const qText = rawQ.replace(/<[^>]+>/g,'').slice(0,90);
        branchHTML += `<div class="ch-branch-q">${qText}</div><div class="ch-branch-opts">`;
        entry.options.forEach((op,oi)=>{
          const taken = op.to === entry.chosen;
          const targetNi = keymap[i][op.to];
          const lbl = (transNode && transNode.o && transNode.o[oi]) ? transNode.o[oi] : op.l;
          if(taken){
            branchHTML += `<span class="branch-opt taken"><span class="bfx">✓</span>${lbl}</span>`;
          } else {
            branchHTML += `<button class="branch-opt alt" data-ci="${i}" data-ni="${targetNi!==undefined?targetNi:entry.ni+1}"><span class="bfx">↳</span>${lbl}</button>`;
          }
        });
        branchHTML += '</div>';
      });
      branchHTML += '</div>';
    }

    b.innerHTML = `<span class="n">${ROMAN[c.id]||c.id}</span>
      <span><span class="t">${meta.title}</span>
      <div class="y">${meta.years}</div>
      <div class="d">${meta.blurb}</div>${branchHTML}</span>`;

    b.onclick = e => {
      const alt = e.target.closest('.branch-opt.alt');
      if(alt){
        e.stopPropagation();
        hist.push([ci,ni]);
        ci = parseInt(alt.dataset.ci);
        ni = parseInt(alt.dataset.ni);
        Scene.mood(CH[ci].id);
        Scene.setScene(ci);
        Scene.reform();
        closeSheets();
        render();
        return;
      }
      goto(i, 0);
    };
    wrap.appendChild(b);
    el.mapList.appendChild(wrap);
  });
  el.map.classList.add('on');
}

function openRefs(){
  const c = CH[ci];
  el.refSub.textContent = `${t().chapPrefix} ${ROMAN[c.id]||c.id} · ${currentLang === 'en' && CH_META_EN[ci] ? CH_META_EN[ci].title : c.title} · ${currentLang === 'en' && CH_META_EN[ci] ? CH_META_EN[ci].years : c.years}`;
  const out = [], done = new Set();
  c.nodes.forEach(n=>{
    if(!n.s || done.has(n.s + (n.m||n.x||n.n||''))) return;
    done.add(n.s + (n.m||n.x||n.n||''));
    let ctx = n.m || n.x || (n.n||'').replace(/<[^>]+>/g,'');
    if(ctx.length > 190) ctx = ctx.slice(0,190) + '…';
    const gr = n.g ? ` <span class="grade g-${n.g}" style="margin-left:6px">${n.g}</span>` : '';
    out.push(`<div class="rf"><div class="src">${n.s}${gr}</div><div class="ctx">${ctx}</div></div>`);
  });
  el.refList.innerHTML = out.length ? out.join('') :
    '<p class="small">' + t().refEmpty + '</p>';
  el.ref.classList.add('on');
}

/* ---------- kendali ---------- */
el.plate.onclick = e => { if(e.target.closest('.ctl-b')) return; step(); };
$('bBack').onclick = e => { e.stopPropagation(); back(); };
$('bMap').onclick  = e => { e.stopPropagation(); openMap(); };
$('bRef').onclick  = e => { e.stopPropagation(); openRefs(); };
document.querySelectorAll('[data-close]').forEach(b => b.onclick = closeSheets);
[el.map, el.ref].forEach(s => s.onclick = e => { if(e.target===s) closeSheets(); });

addEventListener('keydown', e=>{
  if(el.intro && !el.intro.classList.contains('off')) {
    if(e.key===' '||e.key==='Enter'){ e.preventDefault(); begin(0,0); }
    return;
  }
  if(e.key==='Escape') return closeSheets();
  if(el.map.classList.contains('on') || el.ref.classList.contains('on')) return;
  if(e.key===' '||e.key==='Enter'||e.key==='ArrowRight'){ e.preventDefault(); step(); }
  else if(e.key==='ArrowLeft'){ e.preventDefault(); back(); }
  else if(e.key==='m'||e.key==='M'){ openMap(); }
  else if(e.key==='r'||e.key==='R'){ openRefs(); }
  else if(/^[1-9]$/.test(e.key)){
    const b = el.choices.children[+e.key-1]; if(b) b.click();
  }
});

/* geser di layar sentuh untuk mundur */
let tx=0;
el.plate.addEventListener('touchstart', e=>{ tx = e.changedTouches[0].clientX; }, {passive:true});
el.plate.addEventListener('touchend', e=>{
  const d = e.changedTouches[0].clientX - tx;
  if(d > 70) back();
}, {passive:true});

/* ---------- mulai ---------- */
function begin(chapter, node){
  el.intro.classList.add('off');
  setTimeout(()=>{ el.intro.style.display='none'; }, 950);
  ci = chapter||0; ni = node||0;
  Scene.mood(CH[ci].id);
  Scene.setScene(ci);
  render();
}

buildRail();
Scene.start();

$('start').onclick = ()=> begin(0,0);

document.getElementById('bLang').onclick  = e => { e.stopPropagation(); toggleLang(); };
document.getElementById('bTheme').onclick = e => { e.stopPropagation(); toggleTheme(); };
document.getElementById('bTts').onclick   = e => { e.stopPropagation(); TTS.toggle(); };
TTS.updateBtn();

/* ---------- musik latar ---------- */
document.getElementById('bMusic').onclick = e => { e.stopPropagation(); Music.toggle(); };
(function(){
  const slider = document.getElementById('musicVol');
  if (slider){
    slider.addEventListener('input',      e => { e.stopPropagation(); Music.setVolume(e.target.value / 100); });
    slider.addEventListener('pointerdown', e => e.stopPropagation());
    slider.addEventListener('click',       e => e.stopPropagation());
  }
})();
Music.updateBtn();
Music.arm();   // mulai pada gestur pengguna pertama bila autoplay diblokir
applyI18n();  // apply on first load

/* restore bookmark (localStorage — works in all browsers) */
(function(){
  const bm = bookmark.load();
  if(bm){
    progress  = bm.progress  || {};
    choiceLog = bm.choiceLog || {};
    syncProgress();
  }
})();

store.load().then(p=>{
  if(!p || (p.ci===0 && p.ni<2)) return;
  seen = p.seen || {};
  const b = document.createElement('button');
  b.id = 'resume';
  b.style.cssText = 'margin-top:14px;font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--parch-dim);padding:9px 18px;border:1px solid rgba(233,223,201,.2);border-radius:2px';
  b.textContent = t().resumePrefix + ' ' + (ROMAN[CH[p.ci].id] || (p.ci+1));
  b.onmouseenter = ()=>{ b.style.color='var(--gold-lt)'; b.style.borderColor='var(--gold)'; };
  b.onmouseleave = ()=>{ b.style.color='var(--parch-dim)'; b.style.borderColor='rgba(233,223,201,.2)'; };
  b.onclick = ()=> begin(p.ci, p.ni);
  $('start').parentNode.insertBefore(b, $('start').nextSibling);
});
})();

</script>
</body>
</html>
